---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedContent from '../components/RelatedContent.astro';
import EditorialLinks from '../components/EditorialLinks.astro';
import SmartRecommendations from '../components/SmartRecommendations.astro';
import EditorialTrustRibbon from '../components/EditorialTrustRibbon.astro';
import ProductMedia from '../components/ProductMedia.astro';
import TechnicalFigure from '../components/TechnicalFigure.astro';
import AffiliateOfferBlock from '../components/AffiliateOfferBlock.astro';
import { produtos } from '../data/products';
import { mlAffiliateAttrs, shopeeAffiliateAttrs } from '../utils/affiliateTracking';

const model = 'Consul CFO4NAR';
const headline = 'Fogão Consul 4 bocas CFO4NAR vale a pena?';
const title = `${headline} | Casa Prática Eletro`;
const description =
	'Consul CFO4NAR: fogão 4 bocas com mesa inox e acendimento automático. Para quem vale a pena e quando Atlas ou Electrolux fazem mais sentido.';

const summary =
	'O Consul CFO4NAR é um fogão de piso de 4 bocas, com mesa inox, acendimento automático e forno de cerca de 58 L com Cleartec. É uma opção para quem cozinha todos os dias, costuma usar duas ou três panelas por vez e não precisa de recursos mais avançados no forno.';

const imagePath = '/images/melhores/melhor-fogao-4-bocas/consul-cf04nar.webp';
const offerUrl = produtos.consulCF04NAR.ml;
const offerShopeeUrl = produtos.consulCF04NAR.shopee;

const idealFor = [
	'quem quer um Consul 4 bocas com mesa inox e acendimento automático para o uso de todo dia',
	'casal ou família pequena que faz almoço e jantar sem deixar várias panelas grandes no fogo ao mesmo tempo',
	'quem prefere uma mesa inox por ser prática no uso diário, mesmo com as marcas de dedo e água',
	'quem precisa de um fogão que caiba bem em uma cozinha menor',
];

const notIdealFor = [
	'quem cozinha com várias panelas grandes ao mesmo tempo — aí um 5 bocas resolve melhor do que um 4 bocas',
	'quem assa com frequência e quer um forno com recursos como PerfectCook ou VaporBake — nesse caso, o Electrolux FE4IW pode ser uma escolha melhor',
	'quem precisa gastar o mínimo em um 4 bocas inox — o Atlas Mônaco Plus costuma ser a opção mais barata',
];

const familyProfile =
	'O Consul CFO4NAR combina com casas de uma a quatro pessoas quando o fogão é usado todos os dias. Em uma cozinha mais estreita, o tamanho de um 4 bocas também pode ajudar a preservar a circulação, já que a largura fica em torno de 52 cm.';

const routineProfile =
	'O Consul CFO4NAR combina com uma rotina de almoço e jantar, com o forno sendo usado mais de vez em quando do que todos os dias.';

const realLimitations = [
	'O limite de quatro bocas aparece quando várias panelas grandes ficam no fogo ao mesmo tempo.',
	'O forno não tem PerfectCook nem VaporBake. O PerfectCook segura melhor o calor; o VaporBake assa com vapor, o que ajuda em pães e massas.',
];

const differentiators = [
	'Acendimento automático na mesa e no forno, uma comodidade útil para quem liga o fogão várias vezes ao dia.',
	'Mesa inox resistente ao uso diário.',
	'Forno Cleartec de cerca de 58 L, suficiente para os preparos mais comuns.',
];

const ovenAnalysis = [
	'O forno tem cerca de 58 L e cavidade esmaltada Cleartec. É suficiente para bolos, lasanhas e assados de fim de semana.',
	'Se o forno entra apenas de vez em quando na rotina, não ter PerfectCook nem VaporBake não pesa. Quem assa várias vezes por semana e quer calor mais retido ou vapor no preparo deve comparar o Electrolux FE4IW.',
];

const gratesAnalysis =
	'As trempes deste modelo costumam ser de aço esmaltado, mais leves que as de ferro fundido. Para o uso cotidiano, oferecem apoio suficiente às panelas. Se você costuma usar panela de pressão ou caçarola larga, confira a disposição das grades no anúncio antes de comprar.';

const consumptionAnalysis =
	'O consumo depende principalmente do tempo de uso das bocas e do forno. Por isso, para uma rotina parecida entre os modelos, eu não usaria a diferença de consumo como principal critério de escolha. Na hora de escolher, olhe o preço de compra e os recursos que realmente fazem diferença para você.';

const cleaningAnalysis =
	'A mesa inox lida bem com o uso cotidiano e não exige o mesmo cuidado com impactos que uma mesa de vidro. Em compensação, marcas de dedo, água e gordura aparecem com facilidade. Uma limpeza rápida depois do preparo já ajuda a manter o tampo com boa aparência.';

const specsRows = [
	{ label: 'Tipo', value: 'Fogão de piso · 4 bocas · gás' },
	{ label: 'Mesa', value: 'Inox' },
	{ label: 'Acendimento', value: 'Automático (mesa e forno)' },
	{ label: 'Forno', value: '~58 L · Cleartec (cavidade esmaltada)' },
	{ label: 'Voltagem', value: 'Bivolt' },
	{ label: 'Dimensões (A × L × P)', value: '96 × 51,8 × 60,3 cm' },
	{ label: 'Peso', value: '23,5 kg' },
	{ label: 'Referência comercial', value: 'CFO4NAR' },
];

const comparisonRows = [
	{
		criterion: 'Preço',
		text: 'O Consul CFO4NAR fica no meio da faixa de preço dos fogões 4 bocas inox. O Atlas Mônaco Plus costuma custar menos, enquanto o Electrolux FE4IW fica em uma faixa mais alta.',
	},
	{
		criterion: 'Acendimento',
		text: 'O Consul CFO4NAR tem acendimento automático na mesa e no forno. Se comparar com o Atlas Mônaco Plus, confira no anúncio o tipo de acendimento da versão escolhida.',
	},
	{
		criterion: 'Forno',
		text: 'O Consul CFO4NAR tem forno de cerca de 58 L com Cleartec e atende bem aos preparos do dia a dia. Se recursos como PerfectCook e VaporBake são importantes para você, vale comparar com o Electrolux FE4IW.',
	},
	{
		criterion: 'Mesa',
		text: 'A mesa do Consul CFO4NAR é de inox, prática para o uso diário, mas mostra marcas de dedo e respingos. Se você prefere mesa de vidro, o Consul CFO4VAR é outro modelo da marca.',
	},
];

const objections = [
	{
		question: 'Consul CFO4NAR ou Atlas Mônaco Plus?',
		answer:
			'Se você quer um fogão 4 bocas inox com acendimento automático e um forno para o uso do dia a dia, o Consul CFO4NAR faz mais sentido. O Atlas Mônaco Plus pode ser uma escolha melhor se a prioridade for gastar menos e você não fizer questão desses recursos.'
	},
	{
		question: 'Consul CFO4NAR ou Electrolux FE4IW: qual escolher?',
		answer:
			'Se você usa bastante o forno, vale considerar o Electrolux FE4IW pelos recursos PerfectCook e VaporBake. Para quem usa o forno apenas de vez em quando, o Consul CFO4NAR pode ser suficiente e custa menos.',
	},
	{
		question: 'Quatro bocas dão conta da família?',
		answer:
			'Para uma família pequena que costuma cozinhar com duas ou três panelas ao mesmo tempo, quatro bocas dão conta. Se você costuma usar quatro ou cinco panelas grandes de uma vez, um fogão 5 bocas oferece mais espaço para cozinhar.',
	},
];

const faqItems = [
	{
		question: 'O Consul CFO4NAR vale a pena?',
		answer:
			'Sim, para quem quer um 4 bocas inox com acendimento automático e forno para o cotidiano, sem escolher o Electrolux de forno mais completo. Combina com duas ou três panelas por vez.',
	},
	{
		question: 'Qual a diferença entre o Consul CFO4NAR e o Consul CFO4VAR?',
		answer:
			'O Consul CFO4NAR tem mesa inox. O Consul CFO4VAR tem mesa de vidro. São fogões diferentes da mesma marca; o tampo é o que separa os dois.',
	},
	{
		question: 'O Consul CFO4NAR serve para apartamento?',
		answer:
			'Sim, pelo tamanho: cerca de 96 × 51,8 × 60,3 cm. Meça o vão e a folga da porta do forno antes de comprar.',
	},
	{
		question: 'Quando é melhor escolher outro fogão?',
		answer:
			'É melhor escolher outro fogão quando você precisa gastar o mínimo (Atlas Mônaco Plus), quando o forno com PerfectCook e VaporBake importa (Electrolux FE4IW), quando quer vidro (Consul CFO4VAR) ou quando a rotina pede 5 bocas.',
	},
];

const verdict =
	'O Consul CFO4NAR vale a pena para quem quer um 4 bocas com mesa inox, acendimento automático e um forno adequado ao uso cotidiano. O Atlas Mônaco Plus faz mais sentido quando o preço é a prioridade. Já o Electrolux FE4IW merece atenção se o forno é uma parte importante da rotina e recursos como PerfectCook e VaporBake fazem diferença. Se a preferência for por mesa de vidro, o Consul CFO4VAR é outro modelo; e, para quem costuma cozinhar com muitas panelas ao mesmo tempo, nesse caso, um 5 bocas pode ser uma escolha melhor.';

const site = Astro.site ?? new URL('https://casapraticaeletro.com.br');
const canonicalPath = '/review-fogao-4-bocas-consul/';
const canonical = new URL(canonicalPath.replace(/^\//, ''), site).href;
const productImage = new URL(imagePath.replace(/^\//, ''), site).href;

const graph: Record<string, unknown>[] = [
	{
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Início', item: site.href },
			{ '@type': 'ListItem', position: 2, name: 'Review Consul CFO4NAR', item: canonical },
		],
	},
	{
		'@type': 'Product',
		name: model,
		description,
		image: [productImage],
		brand: { '@type': 'Brand', name: 'Consul' },
		offers: {
			'@type': 'Offer',
			url: offerUrl,
			priceCurrency: 'BRL',
		},
	},
	{
		'@type': 'Article',
		headline,
		description,
		image: [productImage],
		author: {
			'@type': 'Organization',
			name: 'Casa Prática Eletro',
			url: site.href,
		},
		publisher: {
			'@type': 'Organization',
			name: 'Casa Prática Eletro',
			url: site.href,
		},
		mainEntityOfPage: canonical,
		articleSection: 'Reviews',
		inLanguage: 'pt-BR',
	},
	{
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	},
];

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': graph,
};
---

<BaseLayout
	title={title}
	description={description}
	canonical={canonical}
	openGraph={{
		title,
		description,
		url: canonical,
		image: productImage,
		imageAlt: 'Fogão Consul CFO4NAR 4 bocas inox com acendimento automático',
		type: 'article',
	}}
>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
	<article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14 lg:py-16">
		<p class="text-xs font-bold uppercase tracking-[0.35em] text-pop">Review · Consul · Fogão 4 bocas</p>
		<h1 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-on-ink-body sm:text-4xl">
			{headline}
		</h1>
		<p class="mt-2 text-sm text-on-ink-muted">
			Modelo referência: <span class="text-on-ink-body">{model}</span>
		</p>
		<p class="mt-6 text-lg leading-relaxed text-on-ink-body">
			{summary}
		</p>
		<p class="mt-4 text-sm leading-relaxed text-on-ink-muted">
			Se ainda está em dúvida entre marcas e modelos, veja o{' '}
			<a href="/melhores/melhor-fogao-4-bocas/" class="link-accent-soft">
				ranking dos melhores fogões 4 bocas
			</a>
			.
		</p>
		<div class="mt-8">
			<EditorialTrustRibbon />
		</div>
		<div class="mt-10">
			<ProductMedia
				src={imagePath}
				alt="Fogão Consul CFO4NAR 4 bocas inox com acendimento automático"
				aspect="square"
			/>
		</div>
		<EditorialLinks
			class="mt-10"
			currentPath={canonicalPath}
			eyebrow="Leituras relacionadas"
			heading="Se ainda restou uma dúvida"
			limit={3}
			kind={['Blog', 'Comparativo']}
		/>

		<section class="mt-12" aria-labelledby="perfil-heading">
			<h2 id="perfil-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Para quem o Consul CFO4NAR faz mais sentido
			</h2>
			<div class="mt-6 grid gap-4 sm:grid-cols-2">
				<div class="rounded-2xl border border-emerald-400/30 bg-emerald-950/20 p-5 ring-1 ring-emerald-400/15 sm:p-6">
					<h3 class="text-sm font-bold uppercase tracking-wider text-emerald-300">Faz mais sentido para</h3>
					<ul class="mt-4 list-inside list-disc space-y-2.5 text-sm leading-relaxed text-on-ink-body sm:text-base">
						{idealFor.map((item) => <li>{item}</li>)}
					</ul>
				</div>
				<div class="rounded-2xl border border-amber-300/25 bg-brand-900/45 p-5 ring-1 ring-white/10 sm:p-6">
					<h3 class="text-sm font-bold uppercase tracking-wider text-amber-200">Pode não compensar tanto para</h3>
					<ul class="mt-4 list-inside list-disc space-y-2.5 text-sm leading-relaxed text-on-ink-body sm:text-base">
						{notIdealFor.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</div>
			<div class="mt-6 grid gap-4 sm:grid-cols-2">
				<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
					<h3 class="font-display text-lg font-bold text-on-ink-body">Quem costuma aproveitar melhor o Consul CFO4NAR</h3>
					<p class="mt-3 text-base leading-relaxed text-on-ink-body">{familyProfile}</p>
				</div>
				<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
					<h3 class="font-display text-lg font-bold text-on-ink-body">No dia a dia</h3>
					<p class="mt-3 text-base leading-relaxed text-on-ink-body">{routineProfile}</p>
				</div>
			</div>
		</section>

		<div class="mt-12">
			<AffiliateOfferBlock
				id="ofertas"
				variant="featured"
				productName={model}
				productId="consulCF04NAR"
				heading={`Conferir preço atualizado do ${model}`}
				description="O preço e a disponibilidade podem mudar. Use os botões para conferir o valor atual, o estoque e o frete para sua região."
				mercadoLivreUrl={offerUrl}
				shopeeUrl={offerShopeeUrl}
			/>
		</div>

		<section class="mt-12" aria-labelledby="ficha-heading">
			<h2 id="ficha-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Ficha técnica resumida
			</h2>
			<p class="mt-4 text-base leading-relaxed text-on-ink-muted">
				Medidas e volume do forno repetem o que as lojas publicam para o Consul CFO4NAR. Trempes e potência dos
				queimadores mudam de anúncio — confirme na ficha da loja.
			</p>
			<div class="table-premium-shell mt-6">
				<table class="table-premium min-w-[320px]">
					<tbody>
						{
							specsRows.map((row, index) => (
								<tr class:list={[index % 2 === 0 ? 'bg-ink' : 'bg-brand-900/25']}>
									<th scope="row" class="font-semibold text-on-ink-body">
										{row.label}
									</th>
									<td>{row.value}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
			<p class="mt-4 text-sm leading-relaxed text-on-ink-muted">
				Nota sobre a referência: em algumas lojas e fichas técnicas, este mesmo modelo pode aparecer identificado como
				CF04NAR. Confira as características do produto no anúncio antes da compra.
			</p>
		</section>

		<section class="mt-12" aria-labelledby="diferenciacao-heading">
			<h2 id="diferenciacao-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				O que você encontra no Consul CFO4NAR
			</h2>
			<ul class="mt-5 list-inside list-disc space-y-2.5 text-base leading-relaxed text-on-ink-body">
				{differentiators.map((item) => <li>{item}</li>)}
			</ul>
			<p class="mt-5 text-base leading-relaxed text-on-ink-muted">
				Se você está comparando os preços de Consul, Atlas e Electrolux, o{' '}
				<a
					href="/fogao-4-bocas-custo-beneficio/"
					class="link-accent"
					aria-label="Fogão 4 bocas custo-benefício"
				>
					comparativo de custo-benefício 4 bocas
				</a>{' '}
				coloca os três lado a lado.
			</p>
		</section>

		<section class="mt-12" aria-labelledby="limitacoes-heading">
			<h2 id="limitacoes-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				O que você precisa considerar
			</h2>
			<ul class="mt-5 list-inside list-disc space-y-2.5 text-base leading-relaxed text-on-ink-body">
				{realLimitations.map((item) => <li>{item}</li>)}
			</ul>
		</section>

		<section class="mt-12" aria-labelledby="analise-tecnica-heading">
			<h2 id="analise-tecnica-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Forno, trempes, consumo e limpeza
			</h2>
			<div class="mt-6 space-y-8 text-base leading-relaxed text-on-ink-body">
				<div>
					<h3 class="font-display text-lg font-bold text-on-ink-body">Forno</h3>
					{ovenAnalysis.map((paragraph) => (
						<p class="mt-3">{paragraph}</p>
					))}
				</div>
				<div>
					<h3 class="font-display text-lg font-bold text-on-ink-body">Trempes e uso com panelas</h3>
					<p class="mt-3">{gratesAnalysis}</p>
					<TechnicalFigure id="L06A" class="mt-6" />
				</div>
				<div>
					<h3 class="font-display text-lg font-bold text-on-ink-body">Consumo e custo de uso</h3>
					<p class="mt-3">{consumptionAnalysis}</p>
				</div>
				<div>
					<h3 class="font-display text-lg font-bold text-on-ink-body">Limpeza da mesa inox</h3>
					<p class="mt-3">{cleaningAnalysis}</p>
				</div>
			</div>
		</section>

		<section class="mt-12" aria-labelledby="comparacao-heading">
			<h2 id="comparacao-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Como o Consul CFO4NAR se compara
			</h2>
			<div class="mt-6 space-y-6">
				{
					comparisonRows.map((row) => (
						<div>
							<h3 class="font-display text-lg font-bold text-on-ink-body">{row.criterion}</h3>
							<p class="mt-3 text-base leading-relaxed text-on-ink-body">{row.text}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="mt-12" aria-labelledby="objecoes-heading">
			<h2 id="objecoes-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Objeções comuns de compra
			</h2>
			<dl class="mt-6 space-y-6">
				<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
					<dt class="font-display text-lg font-bold text-on-ink-body">{objections[0].question}</dt>
					<dd class="mt-3 text-base leading-relaxed text-on-ink-muted">{objections[0].answer}</dd>
				</div>
			</dl>
			<p class="mt-6 text-sm leading-relaxed text-on-ink-muted">
				Se o que pesa é gastar menos, confira o Atlas Mônaco Plus — fogão 4 bocas.
			</p>
			<div class="mt-6">
				<AffiliateOfferBlock
					id="ofertas-alternativa-atlas-monaco"
					productName="Atlas Mônaco Plus — fogão 4 bocas"
					productId="atlasMonacoPlus"
					heading="Conferir preço do Atlas Mônaco Plus — fogão 4 bocas"
					description="Atlas Mônaco Plus — fogão 4 bocas. Confira preço e frete no Mercado Livre ou na Shopee."
					mercadoLivreUrl={produtos.atlasMonacoPlus.ml}
					shopeeUrl={produtos.atlasMonacoPlus.shopee}
				/>
			</div>
			<dl class="mt-8 space-y-6">
				<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
					<dt class="font-display text-lg font-bold text-on-ink-body">{objections[1].question}</dt>
					<dd class="mt-3 text-base leading-relaxed text-on-ink-muted">{objections[1].answer}</dd>
				</div>
			</dl>
			<p class="mt-6 text-sm leading-relaxed text-on-ink-muted">
				Se o que pesa é o forno com PerfectCook e VaporBake, confira o Electrolux FE4IW — fogão 4 bocas.
			</p>
			<div class="mt-6">
				<AffiliateOfferBlock
					id="ofertas-alternativa-electrolux-fe4iw"
					productName="Electrolux FE4IW — fogão 4 bocas"
					productId="electroluxFE4IW"
					heading="Conferir preço do Electrolux FE4IW — fogão 4 bocas"
					description="Electrolux FE4IW — fogão 4 bocas. Confira preço e frete no Mercado Livre ou na Shopee."
					mercadoLivreUrl={produtos.electroluxFE4IW.ml}
					shopeeUrl={produtos.electroluxFE4IW.shopee}
				/>
			</div>
			<dl class="mt-8 space-y-6">
				<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
					<dt class="font-display text-lg font-bold text-on-ink-body">{objections[2].question}</dt>
					<dd class="mt-3 text-base leading-relaxed text-on-ink-muted">{objections[2].answer}</dd>
				</div>
			</dl>
		</section>

		<div class="cta-affiliate-pair mt-12 max-w-2xl">
			<a
				href={offerUrl}
				class="cta-affiliate cta-affiliate--ml"
				target="_blank"
				rel="noopener noreferrer nofollow sponsored"
				aria-label={`Ver preço do fogão ${model} no Mercado Livre — abre em nova aba (link patrocinado)`}
				{...mlAffiliateAttrs('consulCF04NAR', 'inline')}
			>
				<span aria-hidden="true">🔥</span>
				Ver preço no Mercado Livre
			</a>
			<a
				href={offerShopeeUrl}
