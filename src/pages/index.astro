---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HomeCategoriesSection from '../components/HomeCategoriesSection.astro';
import LogoStrip from '../components/LogoStrip.astro';
import HomeMelhoresSection from '../components/HomeMelhoresSection.astro';
import BlogGrid from '../components/BlogGrid.astro';

const site = Astro.site ?? new URL('https://casapraticaeletro.com.br');
const canonical = new URL(Astro.url.pathname, site).href;
const pageTitle = 'Guias e reviews de eletrodomésticos | Casa Prática Eletro';
const metaDescription =
	'A Casa Prática Eletro reúne guias, comparativos e reviews para ajudar você a comparar eletrodomésticos e escolher com mais segurança.';
const ogImage = new URL('images/logo/logo-casa-pratica-eletro.webp', site).href;

const allPosts = await getCollection('blog');
const posts = allPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout
	title={pageTitle}
	description={metaDescription}
	canonical={canonical}
	openGraph={{
		title: pageTitle,
		description: metaDescription,
		url: canonical,
		type: 'website',
		image: ogImage,
		imageAlt: 'Casa Prática Eletro',
	}}
>
	<Hero />
	<HomeCategoriesSection />
	<HomeMelhoresSection />
	<LogoStrip />
	<BlogGrid
		variant="dark"
		posts={posts}
		eyebrow="Do blog"
		title="Conteúdo para ajudar na sua escolha"
		subtitle="Reviews, comparativos, medidas e outros conteúdos para você entender melhor os produtos e comprar com mais segurança."
		viewAllLabel="Ver todos os artigos"
		showViewAllLink={true}
	/>
</BaseLayout>
