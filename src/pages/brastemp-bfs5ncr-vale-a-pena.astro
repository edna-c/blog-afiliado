---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AffiliateOfferBlock from '../components/AffiliateOfferBlock.astro';
import RelatedContent from '../components/RelatedContent.astro';
import EditorialLinks from '../components/EditorialLinks.astro';
import SmartRecommendations from '../components/SmartRecommendations.astro';
import ProductMedia from '../components/ProductMedia.astro';
import { produtos } from '../data/products';
import { mlAffiliateAttrs, shopeeAffiliateAttrs } from '../utils/affiliateTracking';
import { PRODUCT_IMAGE_REVIEW } from '../data/productImages';

const site = Astro.site ?? new URL('https://casapraticaeletro.com.br');
const canonicalPath = '/brastemp-bfs5ncr-vale-a-pena/';
const canonical = new URL(canonicalPath.replace(/^\//, ''), site).href;
const ogImageUrl = new URL(PRODUCT_IMAGE_REVIEW.brastemp.replace(/^\//, ''), site).href;

const seoTitle = 'Fogão Brastemp 5 bocas BFS5NCR: vale a pena? Análise completa | Casa Prática Eletro';
const metaDescription =
	'Veja se o Brastemp BFS5NCR realmente vale a pena em 2026. Análise completa sobre forno, potência, limpeza, custo-benefício e uso diário.';

const publishedTime = '2026-05-01T10:00:00-03:00';
const modifiedTime = '2026-07-26T22:00:00-03:00';

const orgId = `${site.href}#organization`;
const websiteId = `${site.href}#website`;
const webpageId = `${canonical}#webpage`;
const articleId = `${canonical}#article`;
const breadcrumbId = `${canonical}#breadcrumb`;
const faqId = `${canonical}#faq`;

const faqItems = [
	{
		question: 'Brastemp BFS5NCR é bom?',
		answer:
			'Sim. É uma boa opção para quem cozinha com frequência e usa o forno de 96 litros.',
	},
	{
		question: 'O forno é realmente grande?',
		answer:
			'Sim. Os 96 litros acomodam assadeiras grandes e atendem bem preparos maiores.',
	},
	{
		question: 'O BFS5NCR consome muito gás?',
		answer:
			'O gasto de gás varia conforme o uso das bocas e do forno. Confira no anúncio o selo de eficiência energética vigente do Brastemp BFS5NCR.',
	},
	{
		question: 'É fácil de limpar?',
		answer:
			'Sim. Os botões removíveis e o vidro interno removível facilitam a limpeza do dia a dia.',
	},
	{
		question: 'Vale para cozinha planejada?',
		answer:
			'O inox combina bem com uma cozinha planejada, desde que haja espaço para o fogão de 5 bocas.',
	},
] as const;

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': orgId,
			name: 'Casa Prática Eletro',
			url: site.href,
			logo: {
				'@type': 'ImageObject',
				url: new URL('favicon.svg', site).href,
			},
		},
		{
			'@type': 'WebSite',
			'@id': websiteId,
			name: 'Casa Prática Eletro',
			url: site.href,
			publisher: { '@id': orgId },
		},
		{
			'@type': 'WebPage',
			'@id': webpageId,
			url: canonical,
			name: seoTitle,
			description: metaDescription,
			isPartOf: { '@id': websiteId },
			mainEntity: { '@id': articleId },
			breadcrumb: { '@id': breadcrumbId },
			primaryImageOfPage: {
				'@type': 'ImageObject',
				url: ogImageUrl,
			},
		},
		{
			'@type': 'BreadcrumbList',
			'@id': breadcrumbId,
			itemListElement: [
				{
					'@type': 'ListItem',
					position: 1,
					name: 'Início',
					item: site.href,
				},
				{
					'@type': 'ListItem',
					position: 2,
					name: 'Review Brastemp BFS5NCR',
					item: canonical,
				},
			],
		},
		{
			'@type': 'Article',
			'@id': articleId,
			headline: 'Fogão Brastemp 5 bocas BFS5NCR: vale a pena? Análise completa',
			description: metaDescription,
			image: [ogImageUrl],
			author: { '@id': orgId },
			publisher: { '@id': orgId },
			datePublished: publishedTime,
			dateModified: modifiedTime,
			mainEntityOfPage: { '@id': webpageId },
			articleSection: 'Reviews',
			inLanguage: 'pt-BR',
		},
		{
			'@type': 'FAQPage',
			'@id': faqId,
			mainEntity: faqItems.map((item) => ({
				'@type': 'Question',
				name: item.question,
				acceptedAnswer: {
					'@type': 'Answer',
					text: item.answer,
				},
			})),
		},
	],
};
---

<BaseLayout
	title={seoTitle}
	description={metaDescription}
	canonical={canonical}
	openGraph={{
		title: seoTitle,
		description: metaDescription,
		url: canonical,
		image: ogImageUrl,
		imageAlt: 'Fogão de piso Brastemp BFS5NCR cinco bocas em inox',
		type: 'article',
		publishedTime,
		modifiedTime,
	}}
>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
	<article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-12 lg:px-8 lg:py-16">
		<Breadcrumbs
			class="mb-8"
			items={[
				{ name: 'Início', href: '/' },
				{ name: 'Review Brastemp BFS5NCR' },
			]}
		/>

		<header class="border-b border-white/10 pb-10">
			<p class="text-xs font-bold uppercase tracking-[0.35em] text-pop">Atualizado 2026 · Review · Fogão 5 bocas</p>
			<h1 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-on-ink-body sm:text-4xl lg:text-[2.5rem] lg:leading-tight">
				Fogão Brastemp 5 bocas BFS5NCR: vale a pena? Análise completa
			</h1>
			<p class="mt-5 text-lg leading-relaxed text-on-ink-body">
				O <strong class="text-on-ink-body">Brastemp BFS5NCR</strong> é um fogão de piso de 5 bocas, com mesa de inox,
				acendimento automático e forno de 96 litros. É uma opção para quem cozinha com frequência, usa panelas
				maiores e aproveita o forno. O principal ponto de atenção é o espaço disponível na cozinha.
			</p>
		</header>

		<section class="mt-10" aria-labelledby="decisao-rapida-heading">
			<h2 id="decisao-rapida-heading" class="font-display text-xl font-bold tracking-tight text-on-ink-body sm:text-2xl">
				Decisão rápida
			</h2>
			<div class="mt-6 grid gap-4 sm:grid-cols-2">
				<div
					class="rounded-2xl border border-emerald-400/35 bg-emerald-950/25 p-5 ring-1 ring-emerald-400/20 sm:p-6"
					aria-labelledby="vale-para-heading"
				>
					<h3 id="vale-para-heading" class="text-sm font-bold uppercase tracking-wider text-emerald-300">
						Vale a pena para quem
					</h3>
					<ul class="mt-4 list-inside list-disc space-y-2.5 text-sm leading-relaxed text-on-ink-body sm:text-base">
						<li>cozinha com frequência e usa várias panelas ao mesmo tempo;</li>
						<li>precisa de forno grande (96 litros);</li>
						<li>tem espaço para um fogão 5 bocas.</li>
					</ul>
				</div>
				<div
					class="rounded-2xl border border-amber-400/25 bg-brand-900/50 p-5 ring-1 ring-white/10 sm:p-6"
					aria-labelledby="pode-nao-heading"
				>
					<h3 id="pode-nao-heading" class="text-sm font-bold uppercase tracking-wider text-amber-200/90">
						Melhor evitar se
					</h3>
					<ul class="mt-4 list-inside list-disc space-y-2.5 text-sm leading-relaxed text-on-ink-body sm:text-base">
						<li>a cozinha for pequena demais para um 5 bocas;</li>
						<li>você cozinha pouco e usa uma ou duas bocas;</li>
						<li>usa pouco o forno;</li>
						<li>você quer gastar o mínimo.</li>
					</ul>
				</div>
			</div>
		</section>

		<section class="mt-10 rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10 sm:p-6" aria-labelledby="eeat-heading">
			<h2 id="eeat-heading" class="sr-only">Transparência editorial</h2>
			<p class="text-sm font-semibold leading-relaxed text-on-ink-body">
				<span class="text-pop">Como analisamos:</span> descrevemos características confirmadas deste modelo, como o
				forno de 96 litros, a mesa de inox e o vidro interno removível. Conheça o propósito do site na página{' '}
				<a href="/sobre/" class="link-accent">sobre a Casa Prática Eletro</a>
				{' '}e leia a{' '}
				<a href="/politica-de-afiliados/" class="link-accent">política de afiliados</a>.
			</p>
		</section>

		<figure class="mt-10 overflow-hidden rounded-2xl ring-1 ring-white/[0.08]">
			<ProductMedia
				src={PRODUCT_IMAGE_REVIEW.brastemp}
				alt="Fogão de piso Brastemp BFS5NCR cinco bocas em inox"
				aspect="wide"
				flush
				fit="cover"
				fetchpriority="high"
			/>
		</figure>

		<div class="mt-12">
			<AffiliateOfferBlock
				id="ofertas"
				variant="featured"
				productName="Brastemp BFS5NCR"
				productId="brastempBFS5NCR"
				heading="Conferir preço atualizado do Brastemp BFS5NCR"
				description="O valor muda em promoções — em algumas épocas do ano a diferença pode ser grande. Use os botões abaixo para ver disponibilidade e frete na sua região."
				mercadoLivreUrl={produtos.brastempBFS5NCR.ml}
				shopeeUrl={produtos.brastempBFS5NCR.shopee}
			/>
		</div>

		<div class="mt-14 space-y-10 text-base leading-relaxed text-on-ink-body">
			<section aria-labelledby="ficha-heading">
				<h2 id="ficha-heading" class="font-display text-xl font-bold tracking-tight text-on-ink-body sm:text-2xl">
					Ficha técnica: o que o Brastemp BFS5NCR entrega?
				</h2>
				<div class="table-premium-shell mt-6">
					<table class="table-premium min-w-[360px]">
						<caption class="sr-only">Principais características do fogão Brastemp BFS5NCR</caption>
						<thead>
							<tr>
								<th scope="col">Característica</th>
								<th scope="col">Detalhes</th>
							</tr>
						</thead>
						<tbody>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Tipo</th>
								<td>Fogão de piso</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">Quantidade de bocas</th>
								<td>5</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Acabamento</th>
								<td>Mesa de inox</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">Capacidade do forno</th>
								<td>96 litros</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Acendimento</th>
								<td>Automático</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">Tipo de gás</th>
								<td>GLP (conversível para GN)</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Diferencial</th>
								<td>Botões removíveis e aro protetor</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<section aria-labelledby="design-heading">
				<h2 id="design-heading" class="font-display text-xl font-bold tracking-tight text-on-ink-body sm:text-2xl">
					Design e acabamento
				</h2>
				<p class="mt-4">
					O Brastemp BFS5NCR tem mesa de inox.
				</p>
			</section>

			<section aria-labelledby="forno-heading">
				<h2 id="forno-heading" class="font-display text-xl font-bold tracking-tight text-on-ink-body sm:text-2xl">
					O forno de 96 litros vale a pena?
				</h2>
				<p class="mt-4">
					O forno de 96 litros é uma vantagem para quem usa assadeiras grandes, faz preparos maiores ou usa o forno com
					frequência.
				</p>
				<h3 class="mt-8 font-display text-lg font-bold text-on-ink-body">Pontos positivos do forno</h3>
				<ul class="mt-4 list-inside list-disc space-y-2">
					<li>bom espaço interno;</li>
					<li>duas prateleiras;</li>
					<li>iluminação interna;</li>
				</ul>
			</section>

			<section aria-labelledby="limpeza-heading">
				<h2 id="limpeza-heading" class="font-display text-xl font-bold tracking-tight text-on-ink-body sm:text-2xl">
					Limpeza e manutenção
				</h2>
				<p class="mt-4">Na limpeza do dia a dia, os principais pontos são:</p>
				<ol class="mt-4 list-inside list-decimal space-y-2">
					<li>botões removíveis;</li>
					<li>vidro interno do forno removível;</li>
				</ol>

				<EditorialLinks
					class="mt-8"
					eyebrow="No blog"
					heading="Cozinha moderna, decoração e manutenção"
					currentPath="/brastemp-bfs5ncr-vale-a-pena/"
					kind="Blog"
					limit={3}
				/>
			</section>

			<section aria-labelledby="concorrentes-heading">
				<h2 id="concorrentes-heading" class="font-display text-xl font-bold tracking-tight text-on-ink-body sm:text-2xl">
					Pontos de atenção
				</h2>
				<ul class="mt-4 list-inside list-disc space-y-2">
					<li>o preço fica acima de fogões mais simples;</li>
					<li>o tamanho pode apertar em cozinhas pequenas;</li>
					<li>quem cozinha pouco pode não aproveitar um forno de quase 100 litros.</li>
				</ul>
			</section>

			<section aria-labelledby="pros-contras-heading">
				<h2 id="pros-contras-heading" class="font-display text-xl font-bold tracking-tight text-on-ink-body sm:text-2xl">
					Prós e contras
				</h2>
				<div class="mt-6 grid gap-4 sm:grid-cols-2">
					<div class="rounded-2xl border border-white/10 bg-brand-900/40 p-5 ring-1 ring-white/10 sm:p-6">
						<h3 class="flex items-center gap-2 font-display text-lg font-bold text-on-ink-body">
							<span class="text-emerald-400" aria-hidden="true">✓</span>
							<span>Vantagens</span>
						</h3>
						<ul class="mt-4 list-inside list-disc space-y-2 text-on-ink-body">
							<li>mesa de inox;</li>
							<li>forno de 96 litros e duas prateleiras;</li>
							<li>botões e vidro interno do forno removíveis;</li>
						</ul>
					</div>
					<div class="rounded-2xl border border-white/10 bg-brand-900/40 p-5 ring-1 ring-white/10 sm:p-6">
						<h3 class="flex items-center gap-2 font-display text-lg font-bold text-on-ink-body">
							<span class="text-amber-300" aria-hidden="true">!</span>
							<span>Desvantagens</span>
						</h3>
						<ul class="mt-4 list-inside list-disc space-y-2 text-on-ink-body">
							<li>custa mais que um fogão mais simples;</li>
							<li>quem assa pouco não aproveita o forno de 96 litros.</li>
						</ul>
					</div>
				</div>
			</section>

			<section aria-labelledby="publico-heading">
				<h2 id="publico-heading" class="font-display text-xl font-bold tracking-tight text-on-ink-body sm:text-2xl">
					Para quem o Brastemp BFS5NCR vale a pena?
				</h2>
				<p class="mt-4">
					O Brastemp BFS5NCR combina mais com quem cozinha com frequência, usa várias bocas e aproveita um forno grande.
				</p>
			</section>

			<section aria-labelledby="nao-escolha-heading">
				<h2 id="nao-escolha-heading" class="font-display text-xl font-bold tracking-tight text-on-ink-body sm:text-2xl">
					Quando não vale a pena
				</h2>
				<p class="mt-4">
					Se você cozinha pouco, pode não aproveitar as cinco bocas nem o forno de 96 litros.
				</p>
			</section>

			<section class="rounded-2xl border border-white/10 bg-brand-900/35 p-6 ring-1 ring-white/10" aria-labelledby="veredito-heading">
				<h2 id="veredito-heading" class="font-display text-xl font-bold tracking-tight text-on-ink-body sm:text-2xl">
					Veredito final
				</h2>
				<p class="mt-4">
					O Brastemp BFS5NCR vale a pena para quem usa as cinco bocas e o forno de 96 litros com frequência. O principal
					ponto de atenção é o tamanho do fogão.
				</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
					<a
						href={produtos.brastempBFS5NCR.ml}
						class="inline-flex min-h-[52px] flex-1 items-center justify-center gap-2 rounded-lg bg-cta px-6 text-center text-xs font-extrabold uppercase tracking-wider text-white ring-1 ring-white/15 transition hover:bg-cta-hover sm:min-w-[200px]"
						target="_blank"
						rel="noopener noreferrer nofollow sponsored"
						aria-label="Ver preço atualizado do Brastemp BFS5NCR no Mercado Livre — abre em nova aba (link patrocinado)"
						{...mlAffiliateAttrs('brastempBFS5NCR', 'page_end')}
					>
						Ver preço no Mercado Livre
					</a>
					<a
						href={produtos.brastempBFS5NCR.shopee}
						class="btn-secondary-premium flex-1 sm:min-w-[200px]"
						target="_blank"
						rel="noopener noreferrer nofollow sponsored"
						aria-label="Ver oferta do Brastemp BFS5NCR na Shopee — abre em nova aba (link patrocinado)"
						{...shopeeAffiliateAttrs('brastempBFS5NCR', 'page_end')}
					>
						Ver oferta na Shopee
					</a>
				</div>
			</section>
		</div>

		<section class="mt-16 border-t border-white/10 pt-14" aria-labelledby="faq-heading">
			<h2 id="faq-heading" class="font-display text-2xl font-bold tracking-tight text-on-ink-body">Perguntas frequentes</h2>
			<dl class="mt-8 space-y-10">
				{
					faqItems.map((item) => (
						<div>
							<dt class="font-display text-lg font-bold text-on-ink-body">{item.question}</dt>
							<dd class="mt-3 text-base leading-relaxed text-on-ink-muted">{item.answer}</dd>
						</div>
					))
				}
			</dl>
		</section>

		<RelatedContent
			class="mt-14"
			currentPath="/brastemp-bfs5ncr-vale-a-pena/"
			excludePaths={['/brastemp-bfs5ncr-vale-a-pena/']}
			eyebrow="Veja também"
			title="Páginas relacionadas"
			subtitle=""
			columns={3}
			limit={6}
		/>

		<SmartRecommendations
			class="mt-12"
			currentPath="/brastemp-bfs5ncr-vale-a-pena/"
			excludePaths={['/brastemp-bfs5ncr-vale-a-pena/']}
			heading="Outras páginas que podem ajudar"
		/>

		<footer class="mt-14 border-t border-white/10 pt-10">
			<p class="text-sm text-on-ink-muted">
				<a
					href="/#top-produtos"
					class="link-accent"
					aria-label="Abrir ranking de fogão 5 bocas com ofertas"
				>
					← Ver ranking 5 bocas com ofertas
				</a>
				{' · '}
				<a href="/blog/" class="link-accent" aria-label="Abrir listagem do blog">
					Ver blog
				</a>
			</p>
		</footer>
	</article>
</BaseLayout>
