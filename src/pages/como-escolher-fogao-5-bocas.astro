---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedContent from '../components/RelatedContent.astro';
import SmartRecommendations from '../components/SmartRecommendations.astro';
import EditorialTrustRibbon from '../components/EditorialTrustRibbon.astro';
import { PRODUCT_IMAGE_REVIEW } from '../data/productImages';

const site = Astro.site ?? new URL('https://casapraticaeletro.com.br');
const canonical = new URL('/como-escolher-fogao-5-bocas/', site).href;
const headline = 'Como escolher fogão 5 bocas em 2026';
const pageTitle = 'Como escolher fogão 5 bocas em 2026: critérios antes de comparar modelos | Casa Prática Eletro';
const description =
	'Como escolher fogão 5 bocas: espaço, bocas, trempes, forno e gás. Critérios práticos para avaliar o fogão antes de comparar os modelos.';
const ogImage = new URL(PRODUCT_IMAGE_REVIEW.brastemp.replace(/^\//, ''), site).href;
const faqId = `${canonical}#faq`;
const modifiedTime = '2026-09-07T12:00:00-03:00';

const faqItems = [
	{
		question: 'Este guia serve se ainda estou entre 4 e 5 bocas?',
		answer:
			'Não. Aqui você já se decidiu pelo 5 bocas e precisa conferir o modelo. Se o formato ainda estiver em aberto, compare 4 e 5 bocas antes — senão você mede um espaço e avalia um fogão do tamanho errado.',
	},
	{
		question: 'O que conferir primeiro na ficha de um fogão 5 bocas?',
		answer:
			'Espaço, gás, foto de cima das bocas, trempes e forno. Se o anúncio omitir algum desses campos, marque a lacuna — não invente o dado.',
	},
	{
		question: 'Vale pagar mais só porque o fogão tem 5 bocas?',
		answer:
			'Não. Cinco bocas já é o formato escolhido. Eu priorizaria trempes e forno antes de pagar só pelo visual.',
	},
	{
		question: 'Quando comparar os modelos?',
		answer:
			'Quando o checklist da ficha estiver marcado: o fogão cabe no espaço disponível, o gás serve para a casa, as panelas que você usa cabem nas bocas e o forno atende à rotina. Aí sim compare as opções disponíveis.',
	},
] as const;

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebPage',
			'@id': canonical,
			url: canonical,
			name: pageTitle,
			description,
			inLanguage: 'pt-BR',
		},
		{
			'@type': 'Article',
			headline,
			description,
			image: [ogImage],
			author: {
				'@type': 'Organization',
				name: 'Casa Prática Eletro',
				url: site.href,
			},
			publisher: {
				'@type': 'Organization',
				name: 'Casa Prática Eletro',
				url: site.href,
			},
			dateModified: modifiedTime,
			mainEntityOfPage: canonical,
			articleSection: 'Guia prático',
			inLanguage: 'pt-BR',
		},
		{
			'@type': 'FAQPage',
			'@id': faqId,
			mainEntity: faqItems.map((item) => ({
				'@type': 'Question',
				name: item.question,
				acceptedAnswer: {
					'@type': 'Answer',
					text: item.answer,
				},
			})),
		},
	],
};
---

<BaseLayout
	title={pageTitle}
	description={description}
	canonical={canonical}
	pageType="guide"
	openGraph={{
		title: pageTitle,
		description,
		url: canonical,
		type: 'article',
		image: ogImage,
		imageAlt: 'Fogão 5 bocas — referência visual do guia prático de escolha',
		modifiedTime,
	}}
>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
	<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
		<p class="text-xs font-bold uppercase tracking-[0.35em] text-pop">Guia prático</p>
		<h1 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-on-ink-body sm:text-4xl">
			{headline}
		</h1>
		<p class="mt-4 text-lg leading-relaxed text-on-ink-body">
			Este guia é para quando você já tiver decidido pelo fogão 5 bocas e precisar de critérios para escolher o modelo
			certo para sua cozinha e sua rotina — não de um ranking de modelos.
		</p>
		<div class="mt-8">
			<EditorialTrustRibbon />
		</div>

		<section class="mt-10" aria-labelledby="resposta-direta-heading">
			<h2 id="resposta-direta-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				O que avaliar antes de escolher
			</h2>
			<p class="mt-4 text-base leading-relaxed text-on-ink-body">
				Os critérios abaixo ajudam a não decidir só pela foto do anúncio. Se você ainda estiver entre 4 e 5 bocas, use
				o{' '}
				<a href="/comparativo-fogao-4-vs-5-bocas/" class="link-accent">comparativo 4 vs 5 bocas</a>
				{' '}antes destes passos.
			</p>
			<div class="table-premium-shell mt-6">
				<table class="table-premium min-w-[480px]">
					<thead>
						<tr>
							<th scope="col">Ordem</th>
							<th scope="col">Critério</th>
							<th scope="col">Por que importa</th>
						</tr>
					</thead>
					<tbody>
						<tr class="bg-ink">
							<th scope="row" class="font-semibold text-on-ink-body">1</th>
							<td>Espaço disponível, profundidade e porta do forno</td>
							<td>O modelo pode parecer certo no anúncio e não caber no espaço que você tem.</td>
						</tr>
						<tr class="bg-brand-900/25">
							<th scope="row" class="font-semibold text-on-ink-body">2</th>
							<td>As cinco bocas e as panelas juntas</td>
							<td>Cinco bocas só fazem sentido se as panelas que você usa cabem lado a lado.</td>
						</tr>
						<tr class="bg-ink">
							<th scope="row" class="font-semibold text-on-ink-body">3</th>
							<td>Trempes e estabilidade</td>
							<td>Panela grande e panela de pressão precisam de apoio firme — a foto de cima mostra isso melhor do que o título.</td>
						</tr>
						<tr class="bg-brand-900/25">
							<th scope="row" class="font-semibold text-on-ink-body">4</th>
							<td>Forno: o que você assa</td>
							<td>O volume e o interior podem fazer mais diferença na rotina do que um timer que você talvez nem use.</td>
						</tr>
						<tr class="bg-ink">
							<th scope="row" class="font-semibold text-on-ink-body">5</th>
							<td>Gás, voltagem e código do modelo</td>
							<td>Gás ou voltagem que não servem para a sua casa podem impedir o uso do fogão.</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>

		<div class="mt-12 space-y-10 text-base leading-relaxed text-on-ink-body">
			<section aria-labelledby="dimensoes-heading">
				<h2 id="dimensoes-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Espaço e medidas
				</h2>
				<p class="mt-4">
					Um fogão 5 bocas costuma ter cerca de 75 a 80 cm de largura, 60 a 70 cm de profundidade e aproximadamente 90
					cm de altura. Essas medidas servem apenas como referência para você entender o espaço que esse tipo de fogão
					costuma ocupar. Na hora de escolher o modelo, confira sempre as medidas informadas pelo fabricante.
				</p>
				<div class="table-premium-shell mt-6">
					<table class="table-premium min-w-[420px]">
						<thead>
							<tr>
								<th scope="col">Medida</th>
								<th scope="col">Referência</th>
							</tr>
						</thead>
						<tbody>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Largura</th>
								<td>75–80 cm</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">Profundidade</th>
								<td>60–70 cm</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Altura</th>
								<td>cerca de 90 cm</td>
							</tr>
						</tbody>
					</table>
				</div>
				<p class="mt-4">
					Com essa referência em mente, meça o espaço disponível na sua cozinha. Depois compare largura, profundidade e
					altura do espaço com as medidas do modelo que você está considerando. Não use as medidas de um fogão como
					referência para outro.
				</p>
				<div class="table-premium-shell mt-6">
					<table class="table-premium min-w-[420px]">
						<thead>
							<tr>
								<th scope="col">Medir em casa</th>
								<th scope="col">O que conferir na ficha e no espaço</th>
							</tr>
						</thead>
						<tbody>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Largura</th>
								<td>Vão livre, folga lateral e puxadores de armário vizinho.</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">Profundidade</th>
								<td>Rodapé, tomada, recuo da parede e profundidade útil do nicho.</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Altura</th>
								<td>Quando o nicho, a coifa ou o móvel ao lado limitam o espaço.</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">Espaço de uso</th>
								<td>Porta do forno aberta 90° e espaço para circular e usar o fogão com conforto.</td>
							</tr>
						</tbody>
					</table>
				</div>
				<p class="mt-4 text-on-ink-muted">
					Se a dúvida for se 5 bocas aperta a cozinha mesmo depois de conferir as medidas do produto, veja{' '}
					<a href="/blog/fogao-5-bocas-reduz-espaco-cozinha/" class="link-accent">se fogão 5 bocas reduz o espaço</a>.
				</p>
			</section>

			<section aria-labelledby="bocas-heading">
				<h2 id="bocas-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					As cinco bocas e o uso de várias panelas
				</h2>
				<p class="mt-4">
					Cinco bocas não significam cinco panelas grandes ao mesmo tempo. O que muda a rotina é a distância entre as
					bocas e o tamanho da base que cada uma aguenta. Na foto de cima do produto, imagine as panelas que você mais
					usa juntas — não o slogan do anúncio.
				</p>
				<ul class="mt-4 list-inside list-disc space-y-2">
					<li>Duas panelas grandes — cabem lado a lado sem uma tomar o espaço da outra?</li>
					<li>Panela de pressão ou caçarola larga — apoia na boca sem invadir a boca ao lado?</li>
					<li>Panela pequena — existe boca auxiliar para fogo baixo, ou você vai improvisar numa boca grande?</li>
				</ul>
				<p class="mt-4">
					A posição das bocas muda de modelo para modelo. Confira a foto de cima e, se a ficha nomear as bocas, anote a
					posição de cada uma — não dê como certo um mapa de “uma boca rápida no centro e o resto ao redor”. A potência
					em kW mostra quanto calor a boca consegue entregar. Isso não prova o tamanho da chama nem se duas panelas
					grandes cabem lado a lado.
				</p>
				<p class="mt-4 text-on-ink-muted">
					Tripla chama ou boca extra potente só se justifica se você realmente usa caçarola larga, wok ou panela de
					fundo maior. Se a rotina for uma ou duas panelas médias, esse recurso não precisa decidir a compra.
				</p>
			</section>

			<section aria-labelledby="trempes-heading">
				<h2 id="trempes-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Trempes e estabilidade
				</h2>
				<p class="mt-4">
					Com cinco bocas, a mesa é mais larga e as panelas grandes aparecem com mais frequência. A estabilidade
					depende da trempe, não do visual do tampo. A trempe de ferro fundido costuma ser mais pesada e ter mais
					contato com a base da panela; as de aço esmaltado ou aramado são mais leves.
				</p>
				<p class="mt-4">
					Na foto de cima, veja se a base da panela apoia em pontos firmes da grade, se a trempe parece folgada no
					encaixe e se há espaço suficiente para as panelas que você costuma usar. Se a panela desliza na trempe, isso
					pode indicar pouco apoio, encaixe inadequado ou espaço excessivo entre os pontos de apoio. Não trate isso
					apenas como detalhe de acabamento: a estabilidade da panela também importa no uso.
				</p>
				<p class="mt-4 text-on-ink-muted">
					Na ficha, anote o material — ferro fundido ou aço esmaltado — e se as grades são individuais ou duplas.
					Grades duplas só se justificam se você costuma usar panelas grandes e pesadas lado a lado.
				</p>
			</section>

			<section aria-labelledby="forno-heading">
				<h2 id="forno-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Como avaliar o forno
				</h2>
				<p class="mt-4">
					Quem usa o forno com frequência precisa olhar para ele com a mesma atenção que dá às bocas. Na ficha, anote o
					volume do forno em litros e se o interior é esmaltado. Quem assa com frequência precisa de espaço e de um
					interior que facilite a limpeza; quem quase não usa o forno pode aceitar uma capacidade menor.
				</p>
				<p class="mt-4">
					Confira essas informações no anúncio do modelo. Não use o volume de um fogão para presumir que os outros 5
					bocas terão a mesma capacidade.
				</p>
				<p class="mt-4 text-on-ink-muted">
					Para comparar os modelos, confira o volume do forno em litros, o tipo de revestimento do interior e se a
					porta abre o suficiente para o espaço disponível. Recursos e programas com nomes chamativos podem ser
					interessantes, mas só devem pesar na escolha se fizerem diferença no que você costuma preparar.
				</p>
			</section>

			<section aria-labelledby="gas-heading">
				<h2 id="gas-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Gás, voltagem e instalação
				</h2>
				<p class="mt-4">
					Confirme se o modelo serve para o gás da sua casa — botijão (GLP) ou gás encanado — e, se for condomínio,
					verifique se há alguma regra própria. A conversão, quando existir, deve seguir as orientações do fabricante
					e ser feita por profissional credenciado; não trate “conversível” como padrão de todos os 5 bocas.
				</p>
				<p class="mt-4">
					A voltagem também muda de modelo para modelo. Confira a voltagem indicada no anúncio que você está vendo. Não
					presuma que todos os modelos da categoria tenham a mesma.
				</p>
				<p class="mt-4">
					Em cozinha planejada ou nicho, use as medidas e as exigências de instalação da ficha daquele modelo. Folgas e
					acabamentos variam. Em dúvida na obra, siga a ficha e procure um profissional credenciado.
				</p>
				<p class="mt-4 text-on-ink-muted">
					Se a dúvida for o formato de instalação, e não o espaço que o 5 bocas irá ocupar, veja{' '}
					<a href="/blog/guia-fogao-embutir-ou-de-piso/" class="link-accent">embutir ou piso</a>.
				</p>
			</section>

			<section aria-labelledby="recursos-heading">
				<h2 id="recursos-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Recursos que realmente fazem diferença
				</h2>
				<p class="mt-4">Anote só o que você usa na sua rotina. O resto do anúncio é marketing.</p>
				<ul class="mt-4 list-inside list-disc space-y-2">
					<li>Acendimento automático — evita acender a chama na mão no uso diário.</li>
					<li>Corta-gás — interrompe o fornecimento se a chama apagar.</li>
					<li>Timer ou display — útil se você realmente controla o tempo de preparo por ali.</li>
				</ul>
				<p class="mt-4">
					Não presuma que o fogão tenha o recurso só porque outro modelo da mesma linha tem. Confira a ficha do modelo
					que você está comprando.
				</p>
				<p class="mt-4 text-on-ink-muted">
					Se ainda estiver em dúvida entre vidro e inox, decida o acabamento antes de comparar os modelos — o{' '}
					<a href="/blog/fogao-mesa-de-vidro-ou-inox/" class="link-accent">comparativo vidro ou inox</a>
					{' '}trata dessa escolha.
				</p>
			</section>

			<section aria-labelledby="custo-heading">
				<h2 id="custo-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Quando vale pagar mais
				</h2>
				<p class="mt-4">
					Cinco bocas já é o formato escolhido. O preço maior só faz sentido quando traz alguma característica que
					realmente melhora o uso. Eu priorizaria trempes mais estáveis, um forno adequado ao que você costuma assar ou
					um recurso que entre de verdade na sua rotina.
				</p>
				<p class="mt-4">Se a diferença estiver só no visual, não vale pagar mais por isso.</p>
				<p class="mt-4 text-on-ink-muted">
					Se a dúvida restante for apenas o preço entre modelos, use o{' '}
					<a href="/fogao-5-bocas-custo-beneficio/" class="link-accent">guia de fogão 5 bocas custo-benefício</a>.
				</p>
			</section>

			<section aria-labelledby="aplicar-heading">
				<h2 id="aplicar-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Como aplicar os critérios na ficha
				</h2>
				<p class="mt-4">
					Abra um anúncio de fogão 5 bocas e confira cada item. Se um campo não aparecer, marque “precisa conferir” —
					não complete com palpite.
				</p>
				<div class="table-premium-shell mt-6">
					<table class="table-premium min-w-[520px]">
						<thead>
							<tr>
								<th scope="col">Verificação</th>
								<th scope="col">Está de acordo</th>
								<th scope="col">Precisa conferir</th>
							</tr>
						</thead>
						<tbody>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">1. Medidas e espaço</th>
								<td>As medidas do modelo cabem no espaço disponível, e a porta do forno abre sem dificuldade.</td>
								<td>A ficha não informa as medidas ou elas não cabem no espaço disponível.</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">2. Gás e voltagem</th>
								<td>O tipo de gás serve para a casa e a voltagem do modelo está no anúncio.</td>
								<td>O anúncio omite gás ou voltagem, ou o modelo não combina com a instalação.</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">3. Bocas e panelas</th>
								<td>Na foto de cima, as panelas que você usa cabem juntas.</td>
								<td>Não há foto de cima, ou uma boca extra aparece como destaque sem função na sua rotina.</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">4. Trempes</th>
								<td>A panela maior que você usa apoia em pontos firmes da grade.</td>
								<td>A ficha fala só no tampo, sem detalhe das trempes, e a foto não mostra o apoio.</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">5. Forno</th>
								<td>O volume informado atende ao que você costuma assar.</td>
								<td>O volume não está informado, ou o modelo oferece recursos de forno que você não pretende usar.</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">6. Recursos da rotina</th>
								<td>Você usaria o recurso na sua rotina, e ele está na ficha — não só no título.</td>
								<td>O recurso aparece só no título, sem confirmação na ficha, ou você não usaria.</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<section aria-labelledby="perfis-heading">
				<h2 id="perfis-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					O que olhar primeiro na ficha
				</h2>
				<div class="table-premium-shell mt-6">
					<table class="table-premium min-w-[480px]">
						<thead>
							<tr>
								<th scope="col">Situação</th>
								<th scope="col">O que olhar primeiro na ficha</th>
							</tr>
						</thead>
						<tbody>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Cozinha compacta ou pouco espaço</th>
								<td>Medidas do fogão contra o espaço disponível e a porta do forno aberta.</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">Várias panelas ao mesmo tempo</th>
								<td>Foto de cima e trempes.</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Assa com frequência</th>
								<td>Volume do forno em litros e se o interior é esmaltado.</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">Rotina doméstica comum</th>
								<td>Se as panelas ficam firmes e se o gás serve para a casa.</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Orçamento apertado</th>
								<td>Primeiro o espaço e as trempes; visual e timer depois.</td>
							</tr>
						</tbody>
