---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedContent from '../components/RelatedContent.astro';
import SmartRecommendations from '../components/SmartRecommendations.astro';
import EditorialTrustRibbon from '../components/EditorialTrustRibbon.astro';
import TechnicalFigure from '../components/TechnicalFigure.astro';

const site = Astro.site ?? new URL('https://casapraticaeletro.com.br');
const canonical = new URL('/como-escolher-fogao-mesa-de-vidro/', site).href;
const headline = 'Como escolher fogão mesa de vidro em 2026';
const pageTitle = 'Como escolher fogão mesa de vidro em 2026: critérios antes de comprar | Casa Prática Eletro';
const description =
	'Como escolher fogão mesa de vidro: tampo temperado, trempes, queimadores, forno e medidas. Critérios práticos antes de comparar os modelos no guia comercial.';
const ogImage = new URL('images/library/L05A.webp', site).href;
const faqId = `${canonical}#faq`;
const publishedTime = '2026-09-05T21:00:00-03:00';

const faqItems = [
	{
		question: 'Fogão com mesa de vidro é a mesma coisa que cooktop de vidro?',
		answer:
			'Não. Fogão de piso a gás com mesa de vidro tem queimadores, trempes e forno no mesmo aparelho. Cooktop de indução ou vitrocerâmico é outro produto: tampo liso, em geral sem forno acoplado. Se a ficha misturar os dois, os critérios deste guia não servem para os dois produtos da mesma maneira.',
	},
	{
		question: 'O que pesa mais na escolha: o vidro ou as trempes?',
		answer:
			'Na prática, o tampo de vidro temperado se parece de um modelo para outro. O que muda o uso diário é a mesa completa: material e formato das trempes, estabilidade da panela e espaço entre bocas. Um tampo liso não compensa se a trempe não der bom apoio para as panelas.',
	},
	{
		question: 'Como saber se vale pagar a mais sem olhar só o preço?',
		answer:
			'Pagar mais só faz sentido quando o modelo oferece algo que realmente faz diferença na sua rotina, como trempes mais estáveis, um forno mais adequado ao que você costuma assar ou um recurso que você realmente vai usar. Se a diferença estiver apenas no visual do tampo, talvez não valha a pena pagar mais.',
	},
	{
		question: 'Quando avançar para o guia comercial?',
		answer:
			'Quando o checklist da ficha estiver marcado e você já tiver definido o acabamento, o tipo de fogão e o tamanho que procura. Aí sim compare os modelos disponíveis no guia comercial — aqui você define o que realmente importa para a sua rotina; depois, pode usar o guia comercial para comparar os modelos.',
	},
] as const;

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebPage',
			'@id': canonical,
			url: canonical,
			name: pageTitle,
			description,
			inLanguage: 'pt-BR',
		},
		{
			'@type': 'Article',
			headline,
			description,
			image: [ogImage],
			author: {
				'@type': 'Organization',
				name: 'Casa Prática Eletro',
				url: site.href,
			},
			publisher: {
				'@type': 'Organization',
				name: 'Casa Prática Eletro',
				url: site.href,
			},
			datePublished: publishedTime,
			dateModified: publishedTime,
			mainEntityOfPage: canonical,
			articleSection: 'Guia prático',
			inLanguage: 'pt-BR',
		},
		{
			'@type': 'FAQPage',
			'@id': faqId,
			mainEntity: faqItems.map((item) => ({
				'@type': 'Question',
				name: item.question,
				acceptedAnswer: {
					'@type': 'Answer',
					text: item.answer,
				},
			})),
		},
	],
};
---

<BaseLayout
	title={pageTitle}
	description={description}
	canonical={canonical}
	pageType="guide"
	openGraph={{
		title: pageTitle,
		description,
		url: canonical,
		type: 'article',
		image: ogImage,
		imageAlt: 'Comparação técnica entre mesa de vidro temperado e mesa de inox — critério de escolha do tampo',
		publishedTime,
		modifiedTime: publishedTime,
	}}
>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
	<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
		<p class="text-xs font-bold uppercase tracking-[0.35em] text-pop">Guia prático</p>
		<h1 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-on-ink-body sm:text-4xl">
			{headline}
		</h1>
		<p class="mt-4 text-lg leading-relaxed text-on-ink-body">
			Use este guia quando já tiver decidido pela mesa de vidro ou se você precisar de critérios para avaliar o
			eletrodoméstico e não de um ranking de modelos.
		</p>
		<div class="mt-8">
			<EditorialTrustRibbon />
		</div>

		<section class="mt-10" aria-labelledby="resposta-direta-heading">
			<h2 id="resposta-direta-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				O que avaliar antes de escolher
			</h2>
			<p class="mt-4 text-base leading-relaxed text-on-ink-body">
				Os critérios abaixo ajudam a não decidir apenas pelo material da mesa. Se o acabamento ainda estiver em dúvida,
				compare vidro e inox antes destes passos. Se a sua preocupação for o risco de quebra, leia{' '}
				<a href="/blog/fogao-mesa-de-vidro-seguro/" class="link-accent">se a mesa de vidro é segura</a>.
			</p>
			<div class="table-premium-shell mt-6">
				<table class="table-premium min-w-[480px]">
					<thead>
						<tr>
							<th scope="col">Ordem</th>
							<th scope="col">Critério</th>
							<th scope="col">Por que importa</th>
						</tr>
					</thead>
					<tbody>
						<tr class="bg-ink">
							<th scope="row" class="font-semibold text-on-ink-body">1</th>
							<td>Produto certo: fogão de piso a gás, não cooktop</td>
							<td>Avaliar ficha, trempes e forno só fazem sentido quando estamos falando do aparelho completo.</td>
						</tr>
						<tr class="bg-brand-900/25">
							<th scope="row" class="font-semibold text-on-ink-body">2</th>
							<td>Vão, profundidade e porta do forno</td>
							<td>O modelo pode parecer certo no anúncio, mas não servir para o espaço disponível.</td>
						</tr>
						<tr class="bg-ink">
							<th scope="row" class="font-semibold text-on-ink-body">3</th>
							<td>Trempes, bocas e estabilidade</td>
							<td>No vidro liso, a panela apoia na grade — não no tampo.</td>
						</tr>
						<tr class="bg-brand-900/25">
							<th scope="row" class="font-semibold text-on-ink-body">4</th>
							<td>Forno pela rotina real</td>
							<td>O tamanho e o acabamento do forno importam mais do que um timer que você talvez nem use.</td>
						</tr>
						<tr class="bg-ink">
							<th scope="row" class="font-semibold text-on-ink-body">5</th>
							<td>Limpeza, gás e modelo exato</td>
							<td>
								Esses detalhes fazem diferença no uso diário e ajudam a evitar comprar por engano a versão de inox.
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>

		<div class="mt-12 space-y-10 text-base leading-relaxed text-on-ink-body">
			<section aria-labelledby="tipo-mesa-heading">
				<h2 id="tipo-mesa-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Confirme se é o fogão certo
				</h2>
				<p class="mt-4">
					Este guia trata de fogão de piso a gás com tampo de vidro temperado: queimadores visíveis, trempes e forno no
					mesmo corpo. O cooktop de indução ou vitrocerâmico também aparece como “mesa de vidro”, mas é outro
					eletrodoméstico — sem as bocas a gás e, em geral, sem forno acoplado.
				</p>
				<p class="mt-4">
					Entre os fogões a gás, o material do tampo costuma aparecer de forma simples na ficha: geralmente “vidro
					temperado”, em geral preto e contínuo. O que muda de um modelo para outro são detalhes como o encaixe da mesa,
					as trempes e a forma como a gordura pode se acumular nas bordas. Espessura quase nunca vem publicada; não use
					medidas em milímetros de anúncios genéricos como referência para comparar os modelos. Esses são apenas detalhes
					que não têm importância real.
				</p>
			</section>

			<section aria-labelledby="acabamento-heading">
				<h2 id="acabamento-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Mesa de vidro × mesa de inox
				</h2>
				<p class="mt-4">
					Antes de comparar os modelos, confirme o material do tampo: vidro liso e contínuo ou inox. Se ainda estiver em
					dúvida, primeiro decida qual acabamento faz mais sentido para você; depois compare os modelos.
				</p>
				<TechnicalFigure id="L05A" class="mt-6" title="" caption="" />
				<p class="mt-4 text-on-ink-muted">
					Na ficha, procure “vidro temperado” e instalação de piso. Se a foto mostrar cooktop liso sem trempes, esse é
					outro tipo de produto.
				</p>
			</section>

			<section aria-labelledby="trempes-heading">
				<h2 id="trempes-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					O que observar nas trempes
				</h2>
				<p class="mt-4">
					No inox, rebaixos do tampo ajudam a localizar a panela. No vidro, a superfície é plana: a estabilidade da panela
					depende principalmente da trempe. Ferro fundido costuma ser mais robusto e ter mais contato com a base da
					panela; aço esmaltado ou aramada é mais leve.
				</p>
				<h3 id="trempes-ferro-heading" class="font-display mt-8 text-lg font-bold text-on-ink-body sm:text-xl">
					Ferro fundido × aramada esmaltada
				</h3>
				<p class="mt-4">
					Ferro fundido costuma ser mais pesado e oferecer mais estabilidade; a aramada esmaltada é mais leve e tubular —
					por isso, vale comparar o desenho da trempe, e não apenas a descrição do anúncio.
				</p>
				<TechnicalFigure id="L06A" class="mt-6" title="" caption="" />
				<p class="mt-4">
					Na foto de cima do produto, imagine a panela que você mais usa. Veja se a base apoia em pontos firmes da grade
					ou se fica em um anel estreito; se a trempe parece folgada no encaixe; e se duas panelas grandes caberiam sem
					uma atrapalhar o espaço da outra. Se a panela fica se movimentando durante o uso, isso pode indicar uma trempe
					leve, encaixe ruim ou pouco apoio para aquela panela. O fato de o tampo ser liso não tem relação com esse
					problema.
				</p>
				<p class="mt-4">
					Panelas maiores e panela de pressão precisam de um bom apoio. Se a ficha informar, observe se as grades são
					individuais e bem dimensionadas ou se são duplas. Já se você costuma usar uma ou duas panelas menores, pode
					encontrar uma trempe esmaltada suficiente para a sua rotina.
				</p>
				<p class="mt-4 text-on-ink-muted">
					Na ficha, anote o material (ferro fundido ou aço esmaltado) e se as grades são individuais ou duplas. Grades
					duplas só se justificam como extra se você costuma usar panelas grandes lado a lado — não apenas porque o
					anúncio oferece esse recurso.
				</p>
			</section>

			<section aria-labelledby="queimadores-heading">
				<h2 id="queimadores-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Queimadores: potência e distribuição
				</h2>
				<p class="mt-4">
					Observe a disposição das bocas, não o slogan. Em muitos fogões de 4 bocas a disposição é um queimador rápido,
					dois médios e um auxiliar — confirme na foto de cima, porque isso muda de modelo. O que importa na rotina é
					combinar as bocas com o tamanho das panelas que você usa ao mesmo tempo:
				</p>
				<ul class="mt-4 list-inside list-disc space-y-2">
					<li>Panela grande — cabe no queimador rápido sem invadir a boca ao lado?</li>
					<li>Panela média — as bocas centrais deixam duas panelas sem encostar?</li>
					<li>Panela pequena — o auxiliar mantém fogo baixo para café, molho ou outros preparos?</li>
				</ul>
				<p class="mt-4">
					A potência do queimador, indicada em kW, mostra quanto calor ele consegue fornecer. Quanto maior a potência,
					maior a capacidade de aquecimento, mas isso não significa necessariamente uma chama maior. O formato da chama
					também influencia a forma como o calor chega à panela. Por isso, além da potência, observe como o fabricante
					identifica os queimadores e onde cada um está localizado. A tripla chama, por exemplo, distribui o fogo em mais
					de um anel e pode ser interessante para quem usa caçarolas largas, wok ou panelas com fundo maior. É um recurso
					que vale considerar apenas se você realmente for usar.
				</p>
			</section>

			<section aria-labelledby="forno-heading">
				<h2 id="forno-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Como avaliar o forno
				</h2>
				<p class="mt-4">
					O material do tampo não é o mesmo do forno. Na ficha, anote o volume em litros e se a cavidade é esmaltada. Quem
					assa com alguma frequência precisa de espaço e de esmalte que aguente a limpeza; quem quase não usa o forno
					pode aceitar uma cavidade menor. Confirme essas informações no anúncio do modelo — não use o volume de um modelo
					para presumir que os outros terão a mesma capacidade.
				</p>
				<p class="mt-4">
					Prateleira deslizante e vidro interno vedado, quando a ficha listar, ajudam na manutenção e na limpeza.
					Programas e nomes de forno gourmet não são o critério desta página: se o forno é o principal motivo da compra,
					vale dar mais atenção a ele do que ao acabamento da mesa.
				</p>
				<p class="mt-4 text-on-ink-muted">
					Para comparar, confira o volume em litros, se a cavidade é esmaltada ou possui tecnologia de limpeza e se há
					espaço suficiente para abrir a porta em 90°.
				</p>
			</section>

			<section aria-labelledby="dimensoes-heading">
				<h2 id="dimensoes-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Quais dimensões e instalação conferir
				</h2>
				<p class="mt-4">
					As medidas variam de um modelo para outro, por isso não use as dimensões de um fogão como referência para
					outro. Primeiro, meça o espaço disponível em casa. Depois, compare a largura, a profundidade e a altura do
					espaço com as medidas informadas na ficha do modelo que você está considerando.
				</p>
				<div class="table-premium-shell mt-6">
					<table class="table-premium min-w-[420px]">
						<thead>
							<tr>
								<th scope="col">Medir em casa</th>
								<th scope="col">O que conferir na ficha e no vão</th>
							</tr>
						</thead>
						<tbody>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Largura</th>
								<td>Vão livre, folga lateral e puxadores de armário vizinho.</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">Profundidade</th>
								<td>Rodapé, tomada, recuo da parede e profundidade útil do nicho.</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Altura</th>
								<td>Quando o nicho, a coifa ou o móvel ao lado limitam o espaço.</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">Espaço de uso</th>
								<td>
									Porta do forno aberta 90° e espaço suficiente para circular e usar o fogão com conforto.
								</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Tipo de gás</th>
								<td>
									Confira se o modelo é compatível com o gás da sua casa (GLP ou gás de rede). Se precisar de conversão,
									verifique as orientações do fabricante e a necessidade de um profissional qualificado.
								</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">Tensão</th>
								<td>
									Confira a tensão indicada para a versão do modelo que você está comprando. Não presuma que todos os
									modelos tenham a mesma voltagem.
								</td>
							</tr>
						</tbody>
					</table>
				</div>
				<p class="mt-4 text-on-ink-muted">
					Se ainda não decidiu entre 4 ou 5 bocas, use o{' '}
					<a href="/comparativo-fogao-4-vs-5-bocas/" class="link-accent">comparativo 4 vs 5 bocas</a>
					{' '}antes de olhar a mesa. Formato de instalação já é outra etapa, confira:{' '}
					<a href="/blog/guia-fogao-embutir-ou-de-piso/" class="link-accent">embutir ou piso</a>.
				</p>
			</section>

			<section aria-labelledby="aplicar-heading">
				<h2 id="aplicar-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Como aplicar os critérios na ficha
				</h2>
				<p class="mt-4">
					Abra um anúncio da categoria escolhida e confira cada item da lista. Se um campo não aparecer, marque como
					“precisa conferir” — não tente completar com um palpite.
				</p>
				<div class="table-premium-shell mt-6">
					<table class="table-premium min-w-[520px]">
						<thead>
							<tr>
								<th scope="col">Verificação</th>
								<th scope="col">Está de acordo</th>
								<th scope="col">Precisa conferir</th>
							</tr>
						</thead>
						<tbody>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">1. Dimensões e espaço</th>
								<td>
									As medidas do modelo cabem no espaço disponível, e a porta do forno pode abrir sem dificuldade.
								</td>
								<td>A ficha não informa as medidas ou elas não são compatíveis com o espaço disponível.</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">2. Gás e tensão</th>
								<td>
									O tipo de gás é compatível com a instalação da casa e a voltagem da versão está informada no anúncio.
								</td>
								<td>
									O anúncio não informa o tipo de gás ou a voltagem, ou a versão não é compatível com a instalação.
								</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">3. Trempes e panelas</th>
								<td>Material e formato da grade são adequados às panelas que você usa.</td>
								<td>
									A ficha informa apenas “mesa de vidro”, sem detalhes sobre as trempes, e a foto não mostra como as
									panelas ficam apoiadas.
								</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">4. Queimadores</th>
								<td>A disposição das bocas atende ao tamanho das panelas e à forma como você cozinha.</td>
								<td>
									Não há foto de cima nem indicação dos queimadores; a tripla chama aparece como recurso, mas não tem
									utilidade para a sua rotina.
								</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">5. Forno</th>
								<td>O volume do forno e o tipo de cavidade são adequados ao que você costuma assar.</td>
								<td>
									O volume não está informado ou o modelo oferece recursos de forno que você não pretende usar.
								</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">6. Recursos da rotina</th>
								<td>Os recursos do modelo são úteis para o que você faz no dia a dia.</td>
								<td>
									O recurso aparece apenas no título do anúncio, sem confirmação na ficha, ou você não usaria esse
									recurso no dia a dia.
								</td>
							</tr>
						</tbody>
					</table>
				</div>
				<p class="mt-4 text-on-ink-muted">
					Exemplo de como aplicar os critérios em uma ficha: a{' '}
					<a href="/review-fogao-mesa-de-vidro-consul/" class="link-accent">review do Consul CFO4VAR</a>
					{' '}reúne tampo, trempes, forno (~58 L) e dimensões (94,8 × 51,8 × 60,3 cm, A × L × P) e mostra como essas
					informações aparecem na ficha de um modelo real. Confirme sempre o anúncio do modelo — o exemplo serve para
					mostrar como analisar uma ficha, não como indicação de compra nesta página.
				</p>
			</section>

			<section aria-labelledby="limpeza-heading">
				<h2 id="limpeza-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Limpeza e manutenção
				</h2>
				<p class="mt-4">
					Para comparar modelos, observe como a mesa e as trempes podem ser limpas, e não apenas a promessa de “fácil
					limpeza”. Na ficha e na foto, verifique se as trempes saem, se os manípulos são removíveis e se o desenho do
					tampo deixa recorte ou borda onde farelo e gordura acumulam. Superfície lisa ajuda na limpeza do dia a dia; já
					bordas e recortes onde a gordura e os farelos se acumulam podem dificultar a limpeza.
				</p>
				<p class="mt-4 text-on-ink-muted">
					Produtos e o que evitar no vidro seguem a orientação do fabricante do modelo. Quando houver dúvida, consulte o
					manual do modelo em vez de seguir uma regra genérica encontrada na internet.
				</p>
			</section>

			<section aria-labelledby="recursos-heading">
				<h2 id="recursos-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Recursos extras que realmente fazem diferença
				</h2>
				<p class="mt-4">Considere apenas os recursos que realmente fazem diferença na sua rotina. Quando o anúncio informar:</p>
				<ul class="mt-4 list-inside list-disc space-y-2">
					<li>Acendimento automático — facilita o uso diário, sem precisar acender a chama manualmente.</li>
					<li>Corta-gás — interrompe o fornecimento de gás quando a chama se apaga.</li>
					<li>
						Timer ou display — pode ser útil para controlar o tempo de preparo, se você realmente usar esse recurso.
					</li>
				</ul>
				<p class="mt-4 text-on-ink-muted">
					Não presuma que o fogão tenha determinado recurso só porque outro modelo da mesma linha tem. Confira sempre a
					ficha da versão que você está comprando.
				</p>
			</section>

			<section aria-labelledby="seguranca-heading">
				<h2 id="seguranca-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Segurança como critério de compra
				</h2>
				<p class="mt-4">
					Na ficha, confira se o modelo possui recursos como corta-gás e observe se as trempes oferecem bom apoio para as
					panelas. Também verifique o código do modelo para ter certeza de que está analisando o fogão correto. Se o
					tampo chegar trincado ou o aparelho estiver fora de nível após a instalação, não use o fogão até que o problema
					seja resolvido. O aprofundamento sobre uso, impacto e mitos do vidro temperado está em{' '}
					<a href="/blog/fogao-mesa-de-vidro-seguro/" class="link-accent">fogão mesa de vidro é seguro?</a>.
				</p>
			</section>

			<section aria-labelledby="custo-heading">
				<h2 id="custo-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Quando vale pagar mais
				</h2>
				<p class="mt-4">
					Custo-benefício, neste guia, não significa escolher um modelo apenas pelo preço. O importante é verificar se o
					valor a mais traz alguma característica que realmente faça diferença na sua rotina — como trempes que ofereçam
					melhor apoio, um forno mais adequado ao que você costuma assar ou um recurso que você realmente vai usar. Se a
					diferença estiver apenas no visual do tampo, talvez não faça sentido pagar mais por ela.
				</p>
			</section>

			<section aria-labelledby="perfis-heading">
				<h2 id="perfis-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					O que olhar primeiro na ficha
				</h2>
				<div class="table-premium-shell mt-6">
					<table class="table-premium min-w-[480px]">
						<thead>
							<tr>
								<th scope="col">Situação</th>
								<th scope="col">O que olhar primeiro na ficha</th>
							</tr>
						</thead>
						<tbody>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Cozinha compacta ou pouco espaço</th>
								<td>
									Medidas do fogão e do espaço disponível. Confira se largura, profundidade e altura são compatíveis com
									o local.
								</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">Rotina doméstica comum</th>
								<td>
									Trempes e forno. Veja se as panelas ficam bem apoiadas e se o forno atende ao que você costuma
									preparar.
								</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Usa várias panelas ao mesmo tempo</th>
								<td>
									Distribuição das bocas e tamanho do fogão. Veja se 4 ou 5 bocas atendem à sua rotina e se as panelas
									grandes cabem bem juntas.
								</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">
									Uso mais intenso e prioridade em resistência e durabilidade
								</th>
								<td>
									Trempes, estrutura e material do tampo. Se resistência e durabilidade forem prioridade, o inox pode
									fazer mais sentido para a sua rotina.
								</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Orçamento apertado</th>
								<td>
									O que realmente faz diferença no uso. Não abra mão de medidas compatíveis, trempes adequadas às suas
									panelas e do modelo exato que você escolheu.
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<section aria-labelledby="erros-heading">
				<h2 id="erros-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Checagem final: erros a evitar
				</h2>
				<ul class="mt-4 list-inside list-disc space-y-2">
					<li>Fechar a compra sem medir o vão e a abertura da porta do forno.</li>
					<li>
						Confundir o código de vidro com o de inox da mesma marca (na Consul, por exemplo, CFO4VAR e CF04NAR não são o
						mesmo produto).
					</li>
					<li>Aceitar anúncio sem código de modelo claro — o nome comercial da linha às vezes muda de loja para loja.</li>
					<li>Comparar as informações de um fogão de piso com as de um cooktop de vidro.</li>
					<li>Comparar os modelos enquanto ainda houver dúvida entre vidro e inox.</li>
				</ul>
			</section>
		</div>

		<p class="mt-10 text-base leading-relaxed text-on-ink-body">
			Agora que você sabe quais critérios observar, aplique o checklist a um modelo e, quando já tiver definido o que
			procura, compare os modelos disponíveis no guia comercial — para{' '}
			<a href="/melhores/melhor-fogao-mesa-de-vidro/" class="link-accent">comparar os modelos e ver as opções disponíveis</a>.
		</p>

