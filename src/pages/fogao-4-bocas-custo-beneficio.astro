---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedContent from '../components/RelatedContent.astro';
import SmartRecommendations from '../components/SmartRecommendations.astro';
import EditorialTrustRibbon from '../components/EditorialTrustRibbon.astro';
import AffiliateOfferBlock from '../components/AffiliateOfferBlock.astro';
import { produtos } from '../data/products';
import { mlAffiliateAttrs, shopeeAffiliateAttrs } from '../utils/affiliateTracking';

const site = Astro.site ?? new URL('https://casapraticaeletro.com.br');
const canonical = new URL('/fogao-4-bocas-custo-beneficio/', site).href;
const pageTitle =
	'Fogão 4 bocas custo-benefício 2026: Consul, Electrolux ou Atlas? | Casa Prática Eletro';
const description =
	'Qual fogão 4 bocas entrega mais pelo preço? Atlas Mônaco Plus, Consul CF04NAR e Electrolux FE4IW — perfil de cada um e oferta na loja.';
const ogImage = new URL('images/melhores/melhor-fogao-4-bocas/melhor-fogao-4-bocas-2026.webp', site).href;
const faqId = `${canonical}#faq`;

const faqItems = [
	{
		question: 'Qual fogão 4 bocas vale mais a pena pelo preço?',
		answer:
			'Depende da rotina, não só do menor ticket. Atlas Mônaco Plus é a entrada por preço e peças quando o teto é baixo. Consul CF04NAR costuma entregar melhor valor no meio da faixa — acendimento, mesa inox e forno no dia a dia, sem ir ao premium. Electrolux FE4IW só fecha o custo-benefício se PerfectCook/VaporBake (ou o visual da linha Efficient) forem requisito real; senão o ticket sobra.',
	},
	{
		question: 'Para quem cada opção faz sentido?',
		answer:
			'Atlas Mônaco Plus: casal ou primeiro imóvel com teto baixo, perfil de entrada que não tenta parecer premium. Consul CF04NAR: casal a família pequena com uso diário, quando dá para subir um degrau sem ir ao premium. Electrolux FE4IW: quem assa com frequência e trata PerfectCook/VaporBake como requisito. Se a rotina exige muitas panelas ao mesmo tempo, feche 4 ou 5 bocas antes do modelo.',
	},
	{
		question: 'Quando vale pagar mais por um modelo?',
		answer:
			'Pagar o Consul em vez do Atlas faz sentido quando a rotina pede mais equilíbrio — acendimento, mesa inox e forno do dia a dia — sem ir ao premium. Pagar o Electrolux só vale se PerfectCook/VaporBake ou o visual da linha Efficient forem requisito real. Nesta página, não vale economizar em estabilidade das trempes, distância entre bocas, acendimento que você realmente usa, forno adequado ao que assa e instalação correta.',
	},
	{
		question: 'Qual opção tende a fazer mais sentido no uso cotidiano?',
		answer:
			'Para uso diário sem forçar o mínimo, o Consul CF04NAR é o perfil de equilíbrio desta comparação: acendimento, mesa inox e forno adequados ao dia a dia, em casal ou família pequena. Atlas entra quando o teto manda ficar na entrada. Electrolux sobe o ticket para quem assa com frequência de verdade.',
	},
] as const;

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebPage',
			'@id': canonical,
			url: canonical,
			name: pageTitle,
			description,
			inLanguage: 'pt-BR',
		},
		{
			'@type': 'FAQPage',
			'@id': faqId,
			mainEntity: faqItems.map((item) => ({
				'@type': 'Question',
				name: item.question,
				acceptedAnswer: {
					'@type': 'Answer',
					text: item.answer,
				},
			})),
		},
	],
};
---

<BaseLayout
	title={pageTitle}
	description={description}
	canonical={canonical}
	openGraph={{
		title: pageTitle,
		description,
		url: canonical,
		type: 'article',
		image: ogImage,
		imageAlt: 'Fogões 4 bocas — referência visual custo-benefício',
	}}
>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
	<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
		<p class="text-xs font-bold uppercase tracking-[0.35em] text-pop">Compra inteligente</p>
		<h1 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-on-ink-body sm:text-4xl">
			Fogão 4 bocas custo-benefício em 2026: Consul, Electrolux ou Atlas?
		</h1>
		<p class="mt-4 text-lg leading-relaxed text-on-ink-body">
			<strong class="text-on-ink-body">Melhor fogão 4 bocas custo-benefício</strong> não é só o mais barato da vitrine — é o
			que entrega acendimento, mesa e forno utilizáveis pelo preço da sua rotina.
		</p>
		<div class="mt-8">
			<EditorialTrustRibbon />
		</div>
		<section class="mt-10" aria-labelledby="decisao-rapida-heading">
			<h2 id="decisao-rapida-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Decisão rápida por perfil
			</h2>
			<div class="mt-6 grid gap-4 sm:grid-cols-3">
				<div class="rounded-2xl border border-pop/25 bg-brand-900/35 p-5 ring-1 ring-pop/20">
					<h3 class="font-display text-lg font-bold text-on-ink-body">Custo-benefício (destaque)</h3>
					<p class="mt-3 text-sm leading-relaxed text-on-ink-muted">
						Entrar em 4 bocas com teto baixo → <strong class="text-on-ink-body">Atlas Mônaco Plus</strong>, medalha de
						custo-benefício do ranking.
					</p>
				</div>
				<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
					<h3 class="font-display text-lg font-bold text-on-ink-body">Equilíbrio no dia a dia</h3>
					<p class="mt-3 text-sm leading-relaxed text-on-ink-muted">
						Uso diário sem forçar o mínimo → <strong class="text-on-ink-body">Consul CF04NAR</strong> (melhor geral do
						ranking).
					</p>
				</div>
				<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
					<h3 class="font-display text-lg font-bold text-on-ink-body">Premium com propósito</h3>
					<p class="mt-3 text-sm leading-relaxed text-on-ink-muted">
						Forno e linha Efficient são requisito → <strong class="text-on-ink-body">Electrolux FE4IW</strong>. Se não
						pesam, sobra ticket.
					</p>
				</div>
			</div>
		</section>

		<div class="mt-12">
			<AffiliateOfferBlock
				id="ofertas-custo-beneficio-4"
				variant="featured"
				productName="Atlas Mônaco Plus"
				productId="atlasMonacoPlus"
				heading="Oferta do destaque de custo-benefício (4 bocas)"
				description="Medalha de custo-benefício do ranking 4 bocas. Confira preço e frete agora — depois continue lendo se quiser comparar Consul e Electrolux."
				mercadoLivreUrl={produtos.atlasMonacoPlus.ml}
				shopeeUrl={produtos.atlasMonacoPlus.shopee}
			/>
		</div>

		<div class="mt-12 space-y-10 text-base leading-relaxed text-on-ink-body">
			<section aria-labelledby="economizar-heading">
				<h2 id="economizar-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Onde economizar sem arrependimento
				</h2>
				<p class="mt-4">
					Dá para economizar em recursos de forno que você não usa, em acabamento “de vitrine” quando a prioridade é
					função, e em upgrades de linha quando a rotina cabe no modelo de entrada sólida.
				</p>
			</section>

			<section aria-labelledby="nao-economizar-heading">
				<h2 id="nao-economizar-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Onde não vale economizar na compra
				</h2>
				<ul class="mt-4 list-inside list-disc space-y-2">
					<li>estabilidade das trempes e distância entre bocas;</li>
					<li>acendimento que a rotina realmente usa;</li>
					<li>forno adequado ao que você assa de fato;</li>
					<li>instalação correta: nível, mangueira e ventilação.</li>
				</ul>
			</section>

			<section aria-labelledby="perfil-uso-heading">
				<h2 id="perfil-uso-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Perfil de uso e rotina
				</h2>
				<div class="table-premium-shell mt-6">
					<table class="table-premium min-w-[420px]">
						<thead>
							<tr>
								<th scope="col">Perfil</th>
								<th scope="col">O que costuma fazer mais sentido</th>
							</tr>
						</thead>
						<tbody>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Casal / primeiro imóvel</th>
								<td>Atlas quando o teto manda; Consul quando dá para subir um degrau sem ir ao premium.</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">Família pequena / uso diário</th>
								<td>Consul CF04NAR — equilíbrio de acendimento, mesa inox e forno no dia a dia.</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Assa com frequência</th>
								<td>Electrolux FE4IW só se PerfectCook/VaporBake forem requisito real.</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">Muitas panelas ao mesmo tempo</th>
								<td>Antes do modelo, feche o tamanho no comparativo 4 vs 5 bocas.</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<section aria-labelledby="comparacao-lateral-heading">
				<h2 id="comparacao-lateral-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Comparação lateral por perfil
				</h2>
				<div class="table-premium-shell mt-6">
					<table class="table-premium min-w-[520px]">
						<thead>
							<tr>
								<th scope="col">Critério</th>
								<th scope="col">Atlas Mônaco Plus</th>
								<th scope="col">Consul CF04NAR</th>
								<th scope="col">Electrolux FE4IW</th>
							</tr>
						</thead>
						<tbody>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Perfil principal</th>
								<td>Entrada por preço e peças</td>
								<td>Equilíbrio no uso típico</td>
								<td>Premium de forno e linha</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">Família ideal</th>
								<td>Casal / primeiro imóvel</td>
								<td>Casal a família pequena</td>
								<td>Quem assa com frequência</td>
							</tr>
							<tr class="bg-ink">
								<th scope="row" class="font-semibold text-on-ink-body">Forno</th>
								<td>Básico que fecha a compra</td>
								<td>Adequado ao dia a dia</td>
								<td>PerfectCook / VaporBake pesam</td>
							</tr>
							<tr class="bg-brand-900/25">
								<th scope="row" class="font-semibold text-on-ink-body">Objeção principal</th>
								<td>Não tenta parecer premium</td>
								<td>Inox pede limpeza de marcas</td>
								<td>Ticket só vale se o forno for requisito</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<section aria-labelledby="diferenciacao-heading">
				<h2 id="diferenciacao-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Barato, justo ou premium com propósito?
				</h2>
				<p class="mt-4">
					O melhor custo-benefício não é sempre o Atlas. É o modelo que entrega o nível certo de mesa, acendimento e forno
					para a sua rotina. Abaixo disso, falta fogão; muito acima, sobra ticket. O ranking nomeia as medalhas; esta página
					ajuda a casar preço com uso.
				</p>
			</section>

			<section aria-labelledby="objecoes-heading">
				<h2 id="objecoes-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
					Objeções comuns antes de fechar
				</h2>
				<dl class="mt-6 space-y-6">
					<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
						<dt class="font-display text-lg font-bold text-on-ink-body">“Atlas é o único custo-benefício?”</dt>
						<dd class="mt-3 text-on-ink-muted">
							É a medalha de entrada do ranking. Se a rotina pede mais equilíbrio sem ir ao premium, o{' '}
							<a href="/review-fogao-4-bocas-consul/" class="link-accent">Consul CF04NAR</a>
							{' '}costuma entregar melhor valor no meio da faixa.
						</dd>
					</div>
					<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
						<dt class="font-display text-lg font-bold text-on-ink-body">“Vale pagar o Electrolux pelo forno?”</dt>
						<dd class="mt-3 text-on-ink-muted">
							Só se PerfectCook/VaporBake (ou o visual da linha) forem requisito real — aprofunde na{' '}
							<a href="/review-fogao-4-bocas-electrolux/" class="link-accent">review do Electrolux FE4IW</a>
							. Caso contrário, o premium vira excesso.
						</dd>
					</div>
					<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
						<dt class="font-display text-lg font-bold text-on-ink-body">“Ainda em dúvida de tamanho?”</dt>
						<dd class="mt-3 text-on-ink-muted">
							Feche 4 vs 5 no{' '}
							<a href="/comparativo-fogao-4-vs-5-bocas/" class="link-accent">comparativo de bocas</a>
							{' '}antes de escolher modelo por preço.
						</dd>
					</div>
				</dl>
			</section>

			<p>
				Feche o modelo no{' '}
				<a href="/melhores/melhor-fogao-4-bocas/#guia-comercial-produtos" class="link-accent">
					ranking de melhor fogão 4 bocas
				</a>
				{' '}com ofertas. Para medidas e checklist, use{' '}
				<a href="/como-escolher-fogao-4-bocas/" class="link-accent">como escolher fogão 4 bocas</a>.
			</p>

			<section class="mt-16 border-t border-white/10 pt-14" aria-labelledby="faq-heading" id="faq">
				<h2 id="faq-heading" class="font-display text-2xl font-bold tracking-tight text-on-ink-body">
					Perguntas frequentes
				</h2>
				<dl class="mt-8 space-y-10">
					{
						faqItems.map((item) => (
							<div>
								<dt class="font-display text-lg font-bold text-on-ink-body">{item.question}</dt>
								<dd class="mt-3 text-base leading-relaxed text-on-ink-muted">{item.answer}</dd>
							</div>
						))
					}
				</dl>
			</section>
		</div>
		<div class="mt-12 flex flex-wrap gap-4">
			<a
				href={produtos.atlasMonacoPlus.ml}
				class="inline-flex min-h-[48px] items-center justify-center gap-2 bg-cta px-8 text-xs font-extrabold uppercase tracking-wider text-white transition hover:bg-cta-hover"
				target="_blank"
				rel="nofollow sponsored noopener noreferrer"
				aria-label="Ver preço do Atlas Mônaco Plus no Mercado Livre — abre a loja em nova aba (link patrocinado)"
				{...mlAffiliateAttrs('atlasMonacoPlus', 'page_end')}
			>
				<span aria-hidden="true">🔥</span>
				Ver preço no Mercado Livre (Atlas)
			</a>
			<a
				href={produtos.atlasMonacoPlus.shopee}
				class="btn-secondary-premium px-8"
				target="_blank"
				rel="nofollow sponsored noopener noreferrer"
				aria-label="Ver oferta do Atlas Mônaco Plus na Shopee — abre a loja em nova aba (link patrocinado)"
				{...shopeeAffiliateAttrs('atlasMonacoPlus', 'page_end')}
			>
				Ver oferta na Shopee
			</a>
			<a
				href="/melhores/melhor-fogao-4-bocas/#guia-comercial-produtos"
				class="btn-secondary-premium px-8"
				aria-label="Abrir ranking completo de fogão 4 bocas com ofertas"
			>
				Ver ranking completo
			</a>
		</div>
		<RelatedContent
			class="mt-14"
			currentPath="/fogao-4-bocas-custo-beneficio/"
			eyebrow="Veja também"
			title="Leituras relacionadas"
			subtitle="Ranking, checklist e comparativos para alinhar preço com o tamanho certo da cozinha."
		/>

		<SmartRecommendations
			class="mt-12"
			currentPath="/fogao-4-bocas-custo-beneficio/"
			heading="Próximos passos editoriais"
		/>
	</article>
</BaseLayout>
