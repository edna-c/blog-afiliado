---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import SmartRecommendations from '../../components/SmartRecommendations.astro';
import EditorialTrustRibbon from '../../components/EditorialTrustRibbon.astro';
import HomeTopProducts from '../../components/HomeTopProducts.astro';
import HomeComparisonTable from '../../components/HomeComparisonTable.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { Picture } from 'astro:assets';
import melhoresFogoes5BocasHero from '../../assets/images/heroes/melhores-fogoes-5-bocas-hero.webp';
import melhorFogao4BocasHero from '../../assets/images/heroes/melhor-fogao-4-bocas-2026.webp';
import melhorFogaoMesaDeVidroHero from '../../assets/images/heroes/melhor-fogao-mesa-de-vidro-2026.webp';
import { PRODUCT_IMAGE_REVIEW } from '../../data/productImages';
import { GUIDE_PAGE_HERO, picturePropsFrom } from '../../data/editorialImageSpecs';
import {
	getCommercialGuideBlock,
	isCommercialGuideId,
	type CommercialGuideId,
} from '../../data/commercialGuideBlocks';
import { readingTimeLabel } from '../../utils/readingTime';

const guideHeroPicture = picturePropsFrom(GUIDE_PAGE_HERO);

/** Heroes otimizados via astro:assets (AVIF/WebP) — mapa por id da collection. */
const optimizedHeroes: Record<
	string,
	{
		src:
			| typeof melhoresFogoes5BocasHero
			| typeof melhorFogao4BocasHero
			| typeof melhorFogaoMesaDeVidroHero;
		alt: string;
	}
> = {
	'melhor-fogao-5-bocas': {
		src: melhoresFogoes5BocasHero,
		alt: 'Linha de fogões 5 bocas em cozinha planejada, destacando modelos para comparação de custo-benefício em 2026',
	},
	'melhor-fogao-4-bocas': {
		src: melhorFogao4BocasHero,
		alt: 'Melhores fogões 4 bocas em 2026 — comparativo visual para decisão de compra',
	},
	'melhor-fogao-mesa-de-vidro': {
		src: melhorFogaoMesaDeVidroHero,
		alt: 'Fogão Consul com mesa de vidro preta em cozinha planejada — capa do ranking 2026',
	},
};

export async function getStaticPaths() {
	const guides = await getCollection('melhores');
	return guides
		.filter((guide) => !guide.id.startsWith('_'))
		.map((guide) => ({
			params: { slug: guide.id },
			props: { guide },
		}));
}

const { guide } = Astro.props;

const showCommercialBlock = isCommercialGuideId(guide.id);
const commercialGuideId: CommercialGuideId | null = showCommercialBlock ? guide.id : null;
const commercialBlock = commercialGuideId ? getCommercialGuideBlock(commercialGuideId) : null;

type MdContent = Awaited<ReturnType<typeof render>>['Content'];
let IntroContent: MdContent | null = null;
let ModuleJustificativas: MdContent | null = null;
let ModuleComoAvaliamos: MdContent | null = null;
let ModulePerfil: MdContent | null = null;
let ModuleAntes: MdContent | null = null;
let ModuleAprofundar: MdContent | null = null;
let Content: MdContent;
let corpoBody = '';

if (showCommercialBlock && commercialBlock) {
	const modules = await Promise.all(
		commercialBlock.moduleIds.map(async (id) => {
			const entry = await getEntry('melhores', id);
			if (!entry) throw new Error(`Fragmento editorial ausente: ${id}`);
			return entry;
		}),
	);
	corpoBody = modules.map((m) => m.body).join('\n');
	({ Content: IntroContent } = await render(guide));
	[{ Content: ModuleJustificativas }, { Content: ModuleComoAvaliamos }, { Content: ModulePerfil }, { Content: ModuleAntes }, { Content: ModuleAprofundar }] =
		await Promise.all(modules.map((m) => render(m)));
} else {
	({ Content } = await render(guide));
}

const fmt = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
const readingLabel = readingTimeLabel(corpoBody ? `${guide.body}\n${corpoBody}` : guide.body);

const site = Astro.site ?? new URL('https://casapraticaeletro.com.br');
const canonical = new URL(Astro.url.pathname, site).href;
const faq = guide.data.faq;
const headline = guide.data.headline ?? guide.data.title;
const lead = guide.data.lead;
const dek = guide.data.dek;
const eyebrow = guide.data.eyebrow ?? `Guia de Compra · ${guide.data.category}`;
const tldr = guide.data.tldr;
const ctas = guide.data.ctas ?? [];
const optimizedHero = optimizedHeroes[guide.id];
const coverAlt = guide.data.coverAlt ?? optimizedHero?.alt ?? guide.data.title;

const cover = guide.data.coverImage;
const ogImage = cover
	? new URL(cover.replace(/^\//, ''), site).href
	: new URL(PRODUCT_IMAGE_REVIEW.brastemp.replace(/^\//, ''), site).href;

const hubLabel = 'Guias de Compra';
const orgId = `${site.href}#organization`;
const articleId = `${canonical}#article`;
const webpageId = `${canonical}#webpage`;
const breadcrumbId = `${canonical}#breadcrumb`;
const faqId = `${canonical}#faq`;

const graph: Record<string, unknown>[] = [
	{
		'@type': 'Organization',
		'@id': orgId,
		name: 'Casa Prática Eletro',
		url: site.href,
	},
	{
		'@type': 'BreadcrumbList',
		'@id': breadcrumbId,
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Início', item: site.href },
			{ '@type': 'ListItem', position: 2, name: hubLabel, item: new URL('/melhores/', site).href },
			{ '@type': 'ListItem', position: 3, name: headline, item: canonical },
		],
	},
	{
		'@type': 'WebPage',
		'@id': webpageId,
		url: canonical,
		name: `${guide.data.title} | Casa Prática Eletro`,
		description: guide.data.description,
		mainEntity: { '@id': articleId },
		primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
	},
	{
		'@type': 'Article',
		'@id': articleId,
		headline,
		description: guide.data.description,
		image: [ogImage],
		author: { '@id': orgId },
		publisher: { '@id': orgId },
		datePublished: guide.data.pubDate.toISOString(),
		dateModified: (guide.data.updatedDate ?? guide.data.pubDate).toISOString(),
		mainEntityOfPage: { '@id': webpageId },
		articleSection: guide.data.category,
		inLanguage: 'pt-BR',
	},
];
if (faq?.length) {
	graph.push({
		'@type': 'FAQPage',
		'@id': faqId,
		mainEntity: faq.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: { '@type': 'Answer', text: item.answer },
		})),
	});
}
const structuredData = { '@context': 'https://schema.org', '@graph': graph };
---

<BaseLayout
	title={`${guide.data.title} | Casa Prática Eletro`}
	description={guide.data.description}
	canonical={canonical}
	openGraph={{
		title: `${guide.data.title} | Casa Prática Eletro`,
		description: guide.data.description,
		url: canonical,
		image: ogImage,
		imageAlt: coverAlt,
		type: 'article',
		publishedTime: guide.data.pubDate.toISOString(),
		modifiedTime: (guide.data.updatedDate ?? guide.data.pubDate).toISOString(),
	}}
>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
	<article
		class:list={[
			'mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14 lg:py-16',
			showCommercialBlock && 'guide-editorial',
			guide.id === 'melhor-fogao-mesa-de-vidro' && 'guide-editorial--mesa-vidro',
		]}
	>
		<Breadcrumbs
			class="mb-8"
			items={[
				{ name: 'Início', href: '/' },
				{ name: hubLabel, href: '/melhores/' },
				{ name: headline },
			]}
		/>
		{
			showCommercialBlock && commercialBlock && (optimizedHero || cover) ? (
				<header class="relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen border-b border-white/10 px-4 pb-10 sm:px-6 lg:px-10 xl:px-14">
					<div class="mx-auto flex max-w-7xl flex-col gap-8 lg:flex-row lg:items-stretch lg:gap-12">
						<div class="min-w-0 flex-1 lg:flex lg:flex-col lg:justify-center lg:py-2">
							<p class="text-xs font-bold uppercase tracking-[0.35em] text-pop">{eyebrow}</p>
							<h1 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-on-ink-body sm:text-4xl lg:text-[2.5rem] lg:leading-tight xl:text-[2.75rem]">
								{headline}
							</h1>
							<div class="mt-4 max-w-xl rounded-xl border border-white/15 bg-brand-900/70 p-3.5 ring-1 ring-white/10 sm:p-4">
								<ul class="space-y-2 text-sm font-semibold leading-snug text-on-ink-body sm:text-[0.95rem]">
									{commercialBlock.heroRanking.map((line) => (
										<li class={line.toneClass}>{line.text}</li>
									))}
								</ul>
							</div>
							{
								lead ? (
									<p class="mt-4 max-w-3xl text-lg font-semibold leading-relaxed text-on-ink-body sm:text-xl">
										{lead}
									</p>
								) : (
									<p class="mt-4 max-w-3xl text-lg leading-relaxed text-on-ink-body">{guide.data.description}</p>
								)
							}
							{dek ? (
								<p class="mt-3 max-w-3xl text-sm leading-relaxed text-on-ink-muted sm:text-base">{dek}</p>
							) : null}
							<p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-on-ink-muted">
								<span>{fmt.format(guide.data.pubDate)}</span>
								<span aria-hidden="true" class="text-on-ink-muted/50">
									·
								</span>
								<span>{readingLabel}</span>
								{guide.data.topPick ? (
									<>
										<span aria-hidden="true" class="text-on-ink-muted/50">
											·
										</span>
										<span>
											Destaque: <strong class="font-semibold text-on-ink-body">{guide.data.topPick}</strong>
										</span>
									</>
								) : null}
							</p>
						</div>
						<figure
							class:list={[
								'order-first w-full shrink-0 overflow-hidden rounded-2xl ring-1 ring-white/10 lg:order-none',
								guide.id === 'melhor-fogao-mesa-de-vidro'
									? 'lg:w-[min(46.2%,29.4rem)] xl:w-[min(44.1%,33.6rem)]'
									: 'lg:w-[min(44%,28rem)] xl:w-[min(42%,32rem)]',
							]}
						>
							<div class="relative aspect-[16/10] w-full bg-brand-900/40 sm:aspect-[4/3] lg:aspect-auto lg:h-full lg:min-h-[20rem]">
								{
									optimizedHero ? (
										<Picture
											src={optimizedHero.src}
											alt={coverAlt}
											formats={guideHeroPicture.formats}
											widths={guideHeroPicture.widths}
											sizes="(max-width: 1024px) 100vw, 512px"
											width={optimizedHero.src.width}
											height={optimizedHero.src.height}
											quality={guideHeroPicture.quality}
											loading="eager"
											decoding="async"
											priority
											class="h-full w-full object-cover object-center"
											pictureAttributes={{
												class:
													'absolute inset-0 block h-full w-full [&>img]:h-full [&>img]:w-full [&>img]:object-cover [&>img]:object-center',
											}}
										/>
									) : (
										<img
											src={cover}
											alt={coverAlt}
											width={1280}
											height={800}
											decoding="async"
											fetchpriority="high"
											class="absolute inset-0 h-full w-full object-cover object-center"
										/>
									)
								}
							</div>
						</figure>
					</div>
				</header>
			) : (
				<>
					<header class="border-b border-white/10 pb-10">
						<p class="text-xs font-bold uppercase tracking-[0.35em] text-pop">{eyebrow}</p>
						<h1 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-on-ink-body sm:text-4xl lg:text-[2.4rem] lg:leading-tight">
							{headline}
						</h1>
						{
							lead ? (
								<p class="mt-4 text-lg font-semibold leading-relaxed text-on-ink-body sm:text-xl">{lead}</p>
							) : (
								<p class="mt-4 text-lg leading-relaxed text-on-ink-body">{guide.data.description}</p>
							)
						}
						{dek ? <p class="mt-3 text-sm leading-relaxed text-on-ink-muted sm:text-base">{dek}</p> : null}
						<p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-on-ink-muted">
							<span>{fmt.format(guide.data.pubDate)}</span>
							<span aria-hidden="true" class="text-on-ink-muted/50">
								·
							</span>
							<span>{readingLabel}</span>
							{guide.data.topPick ? (
								<>
									<span aria-hidden="true" class="text-on-ink-muted/50">
										·
									</span>
									<span>
										Destaque: <strong class="font-semibold text-on-ink-body">{guide.data.topPick}</strong>
									</span>
								</>
							) : null}
						</p>
					</header>

					{
						optimizedHero ? (
							<figure class="mt-8 overflow-hidden rounded-2xl ring-1 ring-white/10">
								<div class="relative aspect-[16/10] w-full bg-brand-900/40 sm:aspect-[16/9]">
									<Picture
										src={optimizedHero.src}
										alt={coverAlt}
										formats={guideHeroPicture.formats}
										widths={guideHeroPicture.widths}
										sizes={guideHeroPicture.sizes}
										width={optimizedHero.src.width}
										height={optimizedHero.src.height}
										quality={guideHeroPicture.quality}
										loading="eager"
										decoding="async"
										priority
										class="h-full w-full object-cover object-center"
										pictureAttributes={{
											class:
												'absolute inset-0 block h-full w-full [&>img]:h-full [&>img]:w-full [&>img]:object-cover [&>img]:object-center',
										}}
									/>
								</div>
							</figure>
						) : cover ? (
							<figure class="mt-8 overflow-hidden rounded-2xl shadow-[0_14px_40px_rgba(0,0,0,0.45)] ring-1 ring-white/10">
								<div class="relative aspect-[16/10] w-full overflow-hidden bg-brand-900/40 sm:aspect-[16/9]">
									<img
										src={cover}
										alt={coverAlt}
										width={1280}
										height={800}
										decoding="async"
										fetchpriority="high"
										class="h-full w-full object-cover object-center"
									/>
								</div>
							</figure>
						) : (
							<div
								class="mt-8 overflow-hidden rounded-2xl shadow-[0_14px_40px_rgba(0,0,0,0.45)] ring-1 ring-white/10"
								aria-hidden="true"
							>
								<div class="aspect-[16/10] w-full bg-gradient-to-br from-brand-900/70 via-brand-900/40 to-ink sm:aspect-[16/9]" />
							</div>
						)
					}
				</>
			)
		}

		<div class="mt-8">
			<EditorialTrustRibbon />
		</div>

		{
			tldr ? (
				<section
					class="mt-10 rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10 sm:p-7"
					aria-labelledby="tldr-heading"
				>
					<h2 id="tldr-heading" class="font-display text-lg font-bold text-on-ink-body sm:text-xl">
						{tldr.title}
					</h2>
					<ul class="mt-4 list-inside list-disc space-y-2 text-sm leading-relaxed text-on-ink-body sm:text-base">
						{tldr.items.map((item) => (
							<li>{item}</li>
						))}
					</ul>
					{tldr.footerText && tldr.footerHref ? (
						<p class="mt-5 text-sm text-on-ink-muted">
							{tldr.footerText}{' '}
							<a href={tldr.footerHref} class="link-accent">
								{tldr.footerLabel ?? tldr.footerHref}
							</a>
							.
						</p>
					) : null}
				</section>
			) : null
		}

		<div
			class:list={[
				'blog-prose prose prose-invert prose-lg max-w-none prose-headings:font-display prose-a:text-pop prose-a:underline prose-a:decoration-pop/50 prose-a:decoration-2 prose-a:underline-offset-[0.2em] hover:prose-a:text-accent-hover hover:prose-a:decoration-pop',
				'prose-p:leading-[1.72] prose-li:marker:text-pop/80 prose-strong:text-on-ink-body',
				tldr ? 'mt-12' : 'mt-11 sm:mt-[3.25rem]',
			]}
		>
		{
				showCommercialBlock &&
				commercialGuideId &&
				IntroContent &&
				ModuleJustificativas &&
				ModuleComoAvaliamos &&
				ModulePerfil &&
				ModuleAntes &&
				ModuleAprofundar ? (
					<>
						<IntroContent />
						<HomeTopProducts guideId={commercialGuideId} />
						<HomeComparisonTable guideId={commercialGuideId} />
						{/* Justificativas + trecho editorial: mesma margem esquerda (shell 72rem). */}
						<div class="ctx-module ctx-module--justificativas">
							<div class="ctx-module__inner">
								<ModuleJustificativas />
							</div>
						</div>
						<div class="ctx-module ctx-module--prose-start">
							<div class="ctx-module__inner">
								<ModuleComoAvaliamos />
								<ModulePerfil />
								<ModuleAntes />
								<ModuleAprofundar />
							</div>
						</div>
					</>
				) : (
					<Content />
				)
			}
		</div>

		{
			ctas.length ? (
				<div class="mt-12 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
					{ctas.map((cta) =>
						cta.variant === 'secondary' ? (
							<a
								href={cta.href}
								class="btn-secondary-premium flex-1 sm:min-w-[200px]"
								aria-label={cta.ariaLabel ?? cta.label}
							>
								{cta.label}
							</a>
						) : (
							<a
								href={cta.href}
								class="inline-flex min-h-[52px] flex-1 items-center justify-center bg-cta px-6 text-xs font-bold uppercase tracking-wider text-white ring-1 ring-white/15 transition hover:bg-cta-hover sm:min-w-[200px]"
								aria-label={cta.ariaLabel ?? cta.label}
							>
								{cta.label}
							</a>
						),
					)}
				</div>
			) : null
		}

		{
			faq?.length ? (
				showCommercialBlock ? (
					<div class="ctx-module ctx-module--prose-start">
						<div class="ctx-module__inner">
							<section class="border-t border-white/10 pt-0" aria-labelledby="faq-heading">
								<h2 id="faq-heading" class="font-display text-2xl font-bold tracking-tight text-on-ink-body">
									Perguntas frequentes
								</h2>
								<dl class="blog-faq mt-0">
									{faq.map((item) => (
										<div class="blog-faq-item">
											<dt>{item.question}</dt>
											<dd class="max-w-none text-base leading-[1.7] text-on-ink-muted">{item.answer}</dd>
										</div>
									))}
								</dl>
							</section>
						</div>
					</div>
				) : (
					<section class="mt-16 border-t border-white/10 pt-[3.25rem]" aria-labelledby="faq-heading">
						<h2 id="faq-heading" class="font-display text-2xl font-bold tracking-tight text-on-ink-body">
							Perguntas frequentes
						</h2>
						<dl class="blog-faq mt-9">
							{faq.map((item) => (
								<div class="blog-faq-item">
									<dt>{item.question}</dt>
									<dd class="text-base leading-[1.7] text-on-ink-muted">{item.answer}</dd>
								</div>
							))}
						</dl>
					</section>
				)
			) : null
		}

		{
			showCommercialBlock ? (
				<div class="ctx-module ctx-module--relacionados">
					<div class="ctx-module__inner">
						<SmartRecommendations
							class="mt-0"
							currentPath={Astro.url.pathname}
							excludePaths={[`/melhores/${guide.id}`, `/melhores/${guide.id}/`]}
							heading="Próximos passos editoriais"
						/>
						<RelatedContent
							class="mt-[4.5rem]"
							currentPath={Astro.url.pathname}
							excludePaths={[`/melhores/${guide.id}`, `/melhores/${guide.id}/`]}
							eyebrow="Veja também"
							title="Leituras relacionadas"
							subtitle="Continue no mesmo cluster — guias, comparativos e reviews conectados a este tema."
						/>
					</div>
				</div>
			) : (
				<>
					<SmartRecommendations
						class="mt-16"
						currentPath={Astro.url.pathname}
						excludePaths={[`/melhores/${guide.id}`, `/melhores/${guide.id}/`]}
						heading="Próximos passos editoriais"
					/>
					<RelatedContent
						class="mt-14"
						currentPath={Astro.url.pathname}
						excludePaths={[`/melhores/${guide.id}`, `/melhores/${guide.id}/`]}
						eyebrow="Veja também"
						title="Leituras relacionadas"
						subtitle="Continue no mesmo cluster — guias, comparativos e reviews conectados a este tema."
					/>
				</>
			)
		}

		<p class="mt-12 border-t border-white/10 pt-8 text-sm text-on-ink-muted">
			<a href="/melhores/" class="text-pop transition hover:text-accent-hover" aria-label="Voltar ao centro de guias de compra">
				← Voltar aos guias de compra
			</a>
		</p>
	</article>
</BaseLayout>
