---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedContent from '../components/RelatedContent.astro';
import EditorialLinks from '../components/EditorialLinks.astro';
import SmartRecommendations from '../components/SmartRecommendations.astro';
import EditorialTrustRibbon from '../components/EditorialTrustRibbon.astro';
import ProductMedia from '../components/ProductMedia.astro';
import TechnicalFigure from '../components/TechnicalFigure.astro';
import AffiliateOfferBlock from '../components/AffiliateOfferBlock.astro';
import { produtos } from '../data/products';
import { mlAffiliateAttrs, shopeeAffiliateAttrs } from '../utils/affiliateTracking';

const model = 'Electrolux FE4IW';
const headline = 'Fogão Electrolux 4 bocas FE4IW vale a pena?';
const title = `${headline} | Casa Prática Eletro`;
const description =
	'Electrolux FE4IW: fogão 4 bocas da linha Efficient, com PerfectCook e VaporBake. Para quem vale a pena e quando Consul ou Atlas fazem mais sentido.';

const summary =
	'O Electrolux FE4IW é um fogão de piso de 4 bocas da linha Efficient, com mesa inox, acendimento automático e forno de 59 L com PerfectCook, VaporBake e Regenerar a Vapor. É uma opção para quem assa com frequência e quer esses recursos no forno — não só um 4 bocas inox para o cotidiano.';

const imagePath = '/images/melhores/melhor-fogao-4-bocas/electrolux-fe4iw.webp';
const offerUrl = produtos.electroluxFE4IW.ml;
const offerShopeeUrl = produtos.electroluxFE4IW.shopee;

const idealFor = [
	'quem assa com frequência e quer um forno com PerfectCook, VaporBake ou Regenerar a Vapor',
	'quem prefere o visual clean da linha Efficient com mesa inox',
	'casal ou família pequena que faz almoço e jantar sem deixar várias panelas grandes no fogo ao mesmo tempo',
	'quem está disposto a gastar mais porque vai usar os recursos do forno',
];

const notIdealFor = [
	'quem cozinha com várias panelas grandes ao mesmo tempo — aí um 5 bocas resolve melhor do que um 4 bocas',
	'quem procura um 4 bocas inox mais simples e não precisa de recursos avançados no forno',
	'quem precisa gastar o mínimo em um 4 bocas',
	'quem usa o forno só de vez em quando — nesse caso, pode ser melhor escolher um modelo mais simples',
];

const dailyUseProfile =
	'O Electrolux FE4IW atende bem uma casa de uma a quatro pessoas que cozinha todos os dias e também usa o forno várias vezes na semana. Em uma cozinha mais estreita, a largura fica em torno de 52 cm.';

const realLimitations = [
	'As quatro bocas podem ficar apertadas quando várias panelas grandes estão no fogo ao mesmo tempo.',
	'O Electrolux FE4IW custa mais que modelos 4 bocas mais simples. O preço maior faz sentido quando você realmente vai usar esses recursos do forno.',
	'As trempes são de arame cilíndrico, mais leves que as de ferro fundido.',
	'A mesa inox exige mais cuidado para não deixar marcas de dedo, água e gordura aparentes.',
];

const differentiators = [
	'Forno com PerfectCook, VaporBake e Regenerar a Vapor, recursos voltados a quem usa o forno com frequência.',
	'Mesa inox compartimentada, que ajuda a conter líquidos entre as bocas.',
	'Acendimento automático e um queimador de tripla chama.',
];

const ovenAnalysis = [
	'O forno tem 59 L. O PerfectCook ajuda a distribuir o calor de forma mais uniforme para favorecer o resultado dos assados. O VaporBake usa vapor no preparo, especialmente útil para pães e massas. O Regenerar a Vapor usa vapor para reaquecer alimentos, ajudando a evitar que ressequem.',
	'Se você assa várias vezes por semana, os recursos do forno do Electrolux FE4IW passam a ter mais valor na escolha. Se você usa o forno só de vez em quando, um modelo mais simples costuma ser suficiente e custa menos.',
];

const gratesAnalysis =
	'As trempes deste modelo são individuais, de arame cilíndrico — mais leves que as de ferro fundido. Para o uso cotidiano, dão boa sustentação às panelas. Há um queimador de tripla chama. Se você costuma usar panela de pressão ou caçarola larga, confira a disposição das grades no anúncio antes de comprar.';

const consumptionAnalysis =
	'O consumo depende principalmente do tempo de uso das bocas e do forno. Por isso, se o uso for parecido entre os modelos, eu não usaria a diferença de consumo como principal critério de escolha. Na hora de escolher, olhe o preço de compra e os recursos que realmente fazem diferença para você.';

const cleaningAnalysis =
	'A mesa inox compartimentada ajuda a conter líquidos entre as bocas. Em compensação, marcas de dedo, água e gordura aparecem com facilidade. Uma limpeza rápida depois do preparo já ajuda. No forno, o revestimento FastClean e o vidro interno removível facilitam a limpeza mais profunda.';

const specsRows = [
	{ label: 'Tipo', value: 'Fogão de piso · 4 bocas · gás' },
	{ label: 'Linha / cor', value: 'Efficient · branco' },
	{ label: 'Mesa', value: 'Inox compartimentada' },
	{ label: 'Acendimento', value: 'Automático' },
	{ label: 'Forno', value: '59 L · PerfectCook · VaporBake · Regenerar a Vapor · FastClean' },
	{ label: 'Trempes', value: 'Individuais · arame cilíndrico' },
	{ label: 'Queimadores', value: '4 bocas · 1× tripla chama' },
	{ label: 'Voltagem', value: 'Bivolt' },
	{ label: 'Eficiência energética', value: 'Classe A' },
	{ label: 'Dimensões (A × L × P)', value: '97 × 52 × 65 cm' },
	{ label: 'Peso', value: '26,7 kg' },
	{ label: 'Referência comercial', value: 'Electrolux FE4IW' },
];

const comparisonRows = [
	{
		criterion: 'Preço',
		text: 'O Electrolux FE4IW fica na faixa mais alta dos fogões 4 bocas inox. O Consul CFO4NAR fica no meio; o Atlas Mônaco Plus costuma custar menos.',
	},
	{
		criterion: 'Forno',
		text: 'O Electrolux FE4IW tem PerfectCook, VaporBake e Regenerar a Vapor. O Consul CFO4NAR tem forno Cleartec de cerca de 58 L, suficiente para o cotidiano, sem esses recursos.',
	},
	{
		criterion: 'Acendimento',
		text: 'O Electrolux FE4IW tem acendimento automático.',
	},
	{
		criterion: 'Mesa',
		text: 'A mesa do Electrolux FE4IW é de inox compartimentada. Se você prefere mesa de vidro, esse não é o modelo.',
	},
];

const objections = [
	{
		question: 'Electrolux FE4IW ou Consul CFO4NAR: qual escolher?',
		answer:
			'O Electrolux FE4IW é a escolha se PerfectCook, VaporBake ou Regenerar a Vapor vão ser usados na sua cozinha. Se a dúvida é só ter um forno para o cotidiano, o Consul CFO4NAR cobre essa necessidade sem esses recursos.',
	},
	{
		question: 'Electrolux FE4IW ou Atlas Mônaco Plus?',
		answer:
			'O Electrolux FE4IW é mais indicado quando você realmente pretende usar os recursos do forno e prefere o acabamento da linha Efficient. O Atlas Mônaco Plus pode ser uma escolha melhor se a prioridade for gastar menos e você não fizer questão desses recursos.',
	},
	{
		question: 'O forno do fogão 4 bocas dá conta de assar bastante?',
		answer:
			'Sim. Se você assa com frequência, o forno de 59 L do Electrolux FE4IW atende bem uma família pequena. Os recursos PerfectCook, VaporBake e Regenerar a Vapor são justamente os diferenciais para quem usa o forno com mais frequência.',
	},
];

const faqItems = [
	{
		question: 'O Electrolux FE4IW vale a pena?',
		answer:
			'Sim, principalmente se você realmente vai usar os recursos adicionais do forno. Para quem assa apenas ocasionalmente, um 4 bocas mais simples pode atender sem pagar por recursos que serão pouco utilizados.',
	},
	{
		question: 'Qual a diferença entre o Electrolux FE4IW e o Consul CFO4NAR?',
		answer:
			'Os dois são fogões 4 bocas com mesa inox. O Electrolux FE4IW tem forno com PerfectCook, VaporBake e Regenerar a Vapor e custa mais. O Consul CFO4NAR tem forno para o cotidiano, sem esses recursos, e fica no meio da faixa de preço.',
	},
	{
		question: 'O Electrolux FE4IW serve para apartamento?',
		answer:
			'Sim, pelo tamanho: cerca de 97 × 52 × 65 cm. Meça o vão e a folga da porta do forno antes de comprar.',
	},
	{
		question: 'Quando é melhor escolher outro fogão?',
		answer:
			'É melhor escolher outro fogão se você não pretende usar os recursos avançados do forno ou se precisa de mais espaço para cozinhar com várias panelas ao mesmo tempo.',
	},
];

const verdict =
	'O Electrolux FE4IW vale a pena para quem quer um 4 bocas da linha Efficient e pretende usar o forno com frequência. PerfectCook, VaporBake e Regenerar a Vapor são os principais diferenciais para esse perfil. Se você usa o forno apenas de vez em quando ou procura um modelo mais simples, pode não ser necessário pagar por esses recursos.';

const site = Astro.site ?? new URL('https://casapraticaeletro.com.br');
const canonicalPath = '/review-fogao-4-bocas-electrolux/';
const canonical = new URL(canonicalPath.replace(/^\//, ''), site).href;
const productImage = new URL(imagePath.replace(/^\//, ''), site).href;

const graph: Record<string, unknown>[] = [
	{
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Início', item: site.href },
			{ '@type': 'ListItem', position: 2, name: 'Review Electrolux FE4IW', item: canonical },
		],
	},
	{
		'@type': 'Product',
		name: model,
		description,
		image: [productImage],
		brand: { '@type': 'Brand', name: 'Electrolux' },
		offers: {
			'@type': 'Offer',
			url: offerUrl,
			priceCurrency: 'BRL',
		},
	},
	{
		'@type': 'Article',
		headline,
		description,
		image: [productImage],
		author: {
			'@type': 'Organization',
			name: 'Casa Prática Eletro',
			url: site.href,
		},
		publisher: {
			'@type': 'Organization',
			name: 'Casa Prática Eletro',
			url: site.href,
		},
		mainEntityOfPage: canonical,
		articleSection: 'Reviews',
		inLanguage: 'pt-BR',
	},
	{
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	},
];

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': graph,
};
---

<BaseLayout
	title={title}
	description={description}
	canonical={canonical}
	openGraph={{
		title,
		description,
		url: canonical,
		image: productImage,
		imageAlt: 'Fogão Electrolux FE4IW 4 bocas da linha Efficient, branco com mesa inox',
		type: 'article',
	}}
>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
	<article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14 lg:py-16">
		<p class="text-xs font-bold uppercase tracking-[0.35em] text-pop">Review · Electrolux · Fogão 4 bocas</p>
		<h1 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-on-ink-body sm:text-4xl">
			{headline}
		</h1>
		<p class="mt-2 text-sm text-on-ink-muted">
			Modelo referência: <span class="text-on-ink-body">{model}</span>
			{' '}· linha Efficient
		</p>
		<p class="mt-6 text-lg leading-relaxed text-on-ink-body">
			{summary}
		</p>
		<p class="mt-4 text-sm leading-relaxed text-on-ink-muted">
			Se ainda está em dúvida entre marcas e modelos, veja o{' '}
			<a href="/melhores/melhor-fogao-4-bocas/" class="link-accent-soft">
				ranking dos melhores fogões 4 bocas
			</a>
			.
		</p>
		<div class="mt-8">
			<EditorialTrustRibbon />
		</div>
		<div class="mt-10">
			<ProductMedia
				src={imagePath}
				alt="Fogão Electrolux FE4IW 4 bocas da linha Efficient, branco com mesa inox"
				aspect="square"
			/>
		</div>
		<EditorialLinks
			class="mt-10"
			currentPath={canonicalPath}
			eyebrow="Leituras relacionadas"
			heading="Se ainda restou uma dúvida"
			limit={3}
			kind={['Blog', 'Comparativo']}
		/>

		<section class="mt-12" aria-labelledby="perfil-heading">
			<h2 id="perfil-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Para quem o Electrolux FE4IW é uma boa escolha
			</h2>
			<div class="mt-6 grid gap-4 sm:grid-cols-2">
				<div class="rounded-2xl border border-emerald-400/30 bg-emerald-950/20 p-5 ring-1 ring-emerald-400/15 sm:p-6">
					<h3 class="text-sm font-bold uppercase tracking-wider text-emerald-300">Boa escolha para</h3>
					<ul class="mt-4 list-inside list-disc space-y-2.5 text-sm leading-relaxed text-on-ink-body sm:text-base">
						{idealFor.map((item) => <li>{item}</li>)}
					</ul>
				</div>
				<div class="rounded-2xl border border-amber-300/25 bg-brand-900/45 p-5 ring-1 ring-white/10 sm:p-6">
					<h3 class="text-sm font-bold uppercase tracking-wider text-amber-200">Pode não ser a melhor opção para</h3>
					<ul class="mt-4 list-inside list-disc space-y-2.5 text-sm leading-relaxed text-on-ink-body sm:text-base">
						{notIdealFor.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</div>
			<div class="mt-6">
				<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
					<h3 class="font-display text-lg font-bold text-on-ink-body">No uso diário</h3>
					<p class="mt-3 text-base leading-relaxed text-on-ink-body">{dailyUseProfile}</p>
				</div>
			</div>
		</section>

		<div class="mt-12">
			<AffiliateOfferBlock
				id="ofertas"
				variant="featured"
				productName={model}
				productId="electroluxFE4IW"
				heading={model}
				mercadoLivreUrl={offerUrl}
				shopeeUrl={offerShopeeUrl}
			/>
		</div>

		<section class="mt-12" aria-labelledby="ficha-heading">
			<h2 id="ficha-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Ficha técnica resumida
			</h2>
			<p class="mt-4 text-base leading-relaxed text-on-ink-muted">
				As medidas e o volume do forno seguem as informações publicadas pela Electrolux para este modelo. Trempes e potência dos
				queimadores mudam de anúncio — confirme na ficha da loja.
			</p>
			<div class="table-premium-shell mt-6">
				<table class="table-premium min-w-[320px]">
					<tbody>
						{
							specsRows.map((row, index) => (
								<tr class:list={[index % 2 === 0 ? 'bg-ink' : 'bg-brand-900/25']}>
									<th scope="row" class="font-semibold text-on-ink-body">
										{row.label}
									</th>
									<td>{row.value}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</section>

		<section class="mt-12" aria-labelledby="diferenciacao-heading">
			<h2 id="diferenciacao-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				O que você encontra no Electrolux FE4IW
			</h2>
			<ul class="mt-5 list-inside list-disc space-y-2.5 text-base leading-relaxed text-on-ink-body">
				{differentiators.map((item) => <li>{item}</li>)}
			</ul>
			<p class="mt-5 text-base leading-relaxed text-on-ink-muted">
				Se você também quer comparar preço e recursos antes de escolher, veja o{' '}
				<a
					href="/fogao-4-bocas-custo-beneficio/"
					class="link-accent"
					aria-label="Fogão 4 bocas custo-benefício"
				>
					comparativo de custo-benefício de fogões 4 bocas
				</a>
				.
			</p>
		</section>

		<section class="mt-12" aria-labelledby="limitacoes-heading">
			<h2 id="limitacoes-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				O que você precisa considerar
			</h2>
			<ul class="mt-5 list-inside list-disc space-y-2.5 text-base leading-relaxed text-on-ink-body">
				{realLimitations.map((item) => <li>{item}</li>)}
			</ul>
		</section>

		<section class="mt-12" aria-labelledby="analise-tecnica-heading">
			<h2 id="analise-tecnica-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Forno, trempes, consumo e limpeza
			</h2>
			<div class="mt-6 space-y-8 text-base leading-relaxed text-on-ink-body">
				<div>
					<h3 class="font-display text-lg font-bold text-on-ink-body">Forno</h3>
					{ovenAnalysis.map((paragraph) => (
						<p class="mt-3">{paragraph}</p>
					))}
				</div>
				<div>
					<h3 class="font-display text-lg font-bold text-on-ink-body">Trempes e uso com panelas</h3>
					<p class="mt-3">{gratesAnalysis}</p>
					<TechnicalFigure
						id="L06A"
						class="mt-6"
						caption="As trempes de ferro fundido são mais pesadas e costumam passar mais sensação de estabilidade; as aramadas são mais leves e tubulares. Compare o desenho das grades, não só o material informado no anúncio."
					/>
				</div>
				<div>
					<h3 class="font-display text-lg font-bold text-on-ink-body">Consumo e custo de uso</h3>
					<p class="mt-3">{consumptionAnalysis}</p>
				</div>
				<div>
					<h3 class="font-display text-lg font-bold text-on-ink-body">Limpeza da mesa inox</h3>
					<p class="mt-3">{cleaningAnalysis}</p>
				</div>
			</div>
		</section>

		<section class="mt-12" aria-labelledby="comparacao-heading">
			<h2 id="comparacao-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Electrolux FE4IW: pontos fortes e limitações
			</h2>
			<div class="mt-6 space-y-6">
				{
					comparisonRows.map((row) => (
						<div>
							<h3 class="font-display text-lg font-bold text-on-ink-body">{row.criterion}</h3>
							<p class="mt-3 text-base leading-relaxed text-on-ink-body">{row.text}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="mt-12" aria-labelledby="objecoes-heading">
			<h2 id="objecoes-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Dúvidas antes de comprar
			</h2>
			<dl class="mt-6 space-y-6">
				<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
					<dt class="font-display text-lg font-bold text-on-ink-body">{objections[0].question}</dt>
					<dd class="mt-3 text-base leading-relaxed text-on-ink-muted">{objections[0].answer}</dd>
				</div>
			</dl>
			<p class="mt-6 text-sm leading-relaxed text-on-ink-muted">
				Se o forno do cotidiano já resolve, confira o Consul CFO4NAR — fogão 4 bocas.
			</p>
			<div class="mt-6">
				<AffiliateOfferBlock
					id="ofertas-alternativa-consul-cfo4nar"
					productName="Consul CFO4NAR — fogão 4 bocas"
					productId="consulCF04NAR"
					heading="Conferir preço do Consul CFO4NAR — fogão 4 bocas"
					description="Consul CFO4NAR — fogão 4 bocas. Confira preço e frete no Mercado Livre ou na Shopee."
					mercadoLivreUrl={produtos.consulCF04NAR.ml}
					shopeeUrl={produtos.consulCF04NAR.shopee}
				/>
			</div>
			<dl class="mt-8 space-y-6">
				<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
					<dt class="font-display text-lg font-bold text-on-ink-body">{objections[1].question}</dt>
					<dd class="mt-3 text-base leading-relaxed text-on-ink-muted">{objections[1].answer}</dd>
				</div>
			</dl>
			<p class="mt-6 text-sm leading-relaxed text-on-ink-muted">
				Se o que pesa é gastar menos, confira o Atlas Mônaco Plus — fogão 4 bocas.
			</p>
			<div class="mt-6">
				<AffiliateOfferBlock
					id="ofertas-alternativa-atlas-monaco"
					productName="Atlas Mônaco Plus — fogão 4 bocas"
					productId="atlasMonacoPlus"
					heading="Conferir preço do Atlas Mônaco Plus — fogão 4 bocas"
					description="Atlas Mônaco Plus — fogão 4 bocas. Confira preço e frete no Mercado Livre ou na Shopee."
					mercadoLivreUrl={produtos.atlasMonacoPlus.ml}
					shopeeUrl={produtos.atlasMonacoPlus.shopee}
				/>
			</div>
			<dl class="mt-8 space-y-6">
				<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
					<dt class="font-display text-lg font-bold text-on-ink-body">{objections[2].question}</dt>
					<dd class="mt-3 text-base leading-relaxed text-on-ink-muted">{objections[2].answer}</dd>
				</div>
			</dl>
		</section>

		<div class="cta-affiliate-pair mt-12 max-w-2xl">
			<a
				href={offerUrl}
				class="cta-affiliate cta-affiliate--ml"
				target="_blank"
				rel="noopener noreferrer nofollow sponsored"
				aria-label={`Ver preço do fogão ${model} no Mercado Livre — abre em nova aba (link patrocinado)`}
				{...mlAffiliateAttrs('electroluxFE4IW', 'inline')}
			>
				<span aria-hidden="true">🔥</span>
				Ver preço no Mercado Livre
			</a>
			<a
				href={offerShopeeUrl}
				class="cta-affiliate cta-affiliate--shopee"
				target="_blank"
				rel="noopener noreferrer nofollow sponsored"
				aria-label={`Ver oferta do fogão ${model} na Shopee — abre em nova aba (link patrocinado)`}
				{...shopeeAffiliateAttrs('electroluxFE4IW', 'inline')}
			>
				<span aria-hidden="true">👉</span>
				Ver oferta na Shopee
			</a>
		</div>
		<p class="mt-6 text-sm leading-relaxed text-on-ink-muted">
			Transparência: indicação de loja parceira.
		</p>
		<section class="mt-12 rounded-2xl border border-white/10 bg-brand-900/35 p-6 ring-1 ring-white/10" aria-labelledby="veredito-heading">
			<h2 id="veredito-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Veredito
			</h2>
			<p class="mt-4 text-base leading-relaxed text-on-ink-body">{verdict}</p>
			<div class="cta-affiliate-pair mt-8 max-w-2xl">
				<a
					href={offerUrl}
					class="cta-affiliate cta-affiliate--ml"
					target="_blank"
					rel="noopener noreferrer nofollow sponsored"
					aria-label={`Ver preço atualizado do ${model} no Mercado Livre — abre em nova aba (link patrocinado)`}
					{...mlAffiliateAttrs('electroluxFE4IW', 'page_end')}
				>
					Ver preço no Mercado Livre
				</a>
				<a
					href={offerShopeeUrl}
					class="cta-affiliate cta-affiliate--shopee"
					target="_blank"
					rel="noopener noreferrer nofollow sponsored"
					aria-label={`Ver oferta do ${model} na Shopee — abre em nova aba (link patrocinado)`}
					{...shopeeAffiliateAttrs('electroluxFE4IW', 'page_end')}
				>
					Ver oferta na Shopee
				</a>
			</div>
		</section>
		<section class="mt-14 border-t border-white/10 pt-12" aria-labelledby="faq-heading">
			<h2 id="faq-heading" class="font-display text-2xl font-bold tracking-tight text-on-ink-body">
				Perguntas frequentes
			</h2>
			<dl class="mt-8 space-y-8">
				{faqItems.map((item) => (
					<div>
						<dt class="font-semibold text-on-ink-body">{item.question}</dt>
						<dd class="mt-2 text-base leading-relaxed text-on-ink-muted">{item.answer}</dd>
					</div>
				))}
			</dl>
		</section>
		<RelatedContent
			class="mt-14"
			currentPath={canonicalPath}
			eyebrow="Veja também"
			title="Leituras relacionadas"
			subtitle="Outros textos sobre fogão 4 bocas, se ainda restou alguma dúvida."
		/>

		<SmartRecommendations
			class="mt-12"
			currentPath={canonicalPath}
			heading="Continuar a leitura"
		/>
	</article>
</BaseLayout>
