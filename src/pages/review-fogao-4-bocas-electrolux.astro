---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedContent from '../components/RelatedContent.astro';
import EditorialLinks from '../components/EditorialLinks.astro';
import SmartRecommendations from '../components/SmartRecommendations.astro';
import EditorialTrustRibbon from '../components/EditorialTrustRibbon.astro';
import ProductMedia from '../components/ProductMedia.astro';
import TechnicalFigure from '../components/TechnicalFigure.astro';
import AffiliateOfferBlock from '../components/AffiliateOfferBlock.astro';
import { produtos } from '../data/products';

const model = 'Electrolux FE4IW';
const headline = 'Fogão Electrolux 4 bocas FE4IW: vale a pena? Análise completa';
const title = `${headline} | Casa Prática Eletro`;
const description =
	'Electrolux FE4IW (4 bocas): para quem a linha Efficient e o forno (PerfectCook/VaporBake) fecham a compra, onde o premium pesa e quando Consul ou Atlas fazem mais sentido. Análise completa.';

const summary =
	'Melhor premium do ranking 4 bocas: faz sentido quando visual da linha Efficient e recursos de forno (PerfectCook, VaporBake, Regenerar a Vapor) são requisito — não quando a meta é só “cozinhar um pouco melhor”. Confira no anúncio a versão exata — acabamento e acessórios podem variar.';

const imagePath = '/images/melhores/melhor-fogao-4-bocas/electrolux-fe4iw.webp';
const offerUrl = produtos.electroluxFE4IW.ml;
const offerShopeeUrl = produtos.electroluxFE4IW.shopee;

const idealFor = [
	'quem já fechou 4 bocas e quer o degrau premium do ranking',
	'quem assa com frequência e valoriza PerfectCook / VaporBake de verdade',
	'cozinhas planejadas em que o visual branco + mesa inox da linha Efficient pesa',
	'quem aceita pagar mais por forno e acabamento — não só por marca',
];

const notIdealFor = [
	'quem precisa de várias panelas grandes ao mesmo tempo — aí o eixo é 5 bocas',
	'quem busca o melhor equilíbrio sem premium — perfil Consul CF04NAR',
	'orçamento no mínimo absoluto — Atlas Mônaco Plus costuma ser a entrada',
	'quem não usa forno além do básico — o ticket Efficient sobra na conta',
];

const familyProfile =
	'O FE4IW costuma encaixar melhor em casal, família pequena a média e casas onde o 4 bocas já resolve o dia a dia — e o forno da linha Efficient entra como critério real de compra, não como “extra de vitrine”.';

const routineProfile =
	'Faz mais sentido quando há assados com alguma frequência, reaquecimento cuidadoso e rotina de duas a três panelas por vez — com disposição a pagar o premium de recursos de forno.';

const realLimitations = [
	'não substitui um 5 bocas quando a rotina exige muita simultaneidade',
	'premium de linha: só compensa se PerfectCook/VaporBake (ou o visual Efficient) forem requisito',
	'grades em arame cilíndrico — quem prioriza massa/estabilidade de ferro fundido pode preferir outro perfil',
	'inox marca dedo e água — pede limpeza regular para manter o visual',
];

const ovenAnalysis =
	'O forno (~59 L) é o eixo do premium: PerfectCook (cavidade selada com melhor isolamento térmico, segundo a Electrolux) e VaporBake / Regenerar a Vapor ampliam o uso além do assado ocasional. FastClean e vidro interno removível ajudam na manutenção. Se o forno não for protagonista na rotina, o Consul CF04NAR costuma entregar melhor valor no meio da faixa.';

const gratesAnalysis =
	'As grades individuais em arame cilíndrico são o padrão deste SKU nas fichas comerciais — mais leves e fáceis de manusear na limpeza; ferro fundido tende a transmitir mais massa e estabilidade em uso intenso. Vale olhar no anúncio a disposição das bocas (inclui queimador de tripla chama) se você usa panela grande com frequência.';

const consumptionAnalysis =
	'Como em todo fogão a gás, o consumo acompanha tempo de chama e frequência de forno — não o acabamento branco sozinho. No perfil certo, o FE4IW justifica o ticket pelos recursos de forno; fora desse perfil, sobra custo inicial sem ganho proporcional no dia a dia.';

const cleaningAnalysis =
	'A mesa de inox compartimentada (com rebaixos) ajuda a conter líquidos na superfície e facilita a limpeza do que escorre entre bocas — proposta da linha Efficient. Em troca, marcas de dedo e água aparecem com facilidade se a limpeza ficar para depois. No forno, FastClean e vidro interno removível reduzem o atrito da manutenção profunda.';

const differentiators = [
	'linha Efficient com visual branco + mesa inox alinhados a cozinha planejada',
	'forno com PerfectCook, VaporBake e Regenerar a Vapor — o motivo real do premium',
	'queimador de tripla chama + grades individuais; bivolt na instalação',
];

const specsRows = [
	{ label: 'Tipo', value: 'Fogão de piso · 4 bocas · gás' },
	{ label: 'Linha / cor', value: 'Efficient · branco' },
	{ label: 'Mesa', value: 'Inox compartimentada' },
	{ label: 'Grades', value: 'Individuais · arame cilíndrico' },
	{ label: 'Queimadores', value: '4 bocas · 1× tripla chama (conforme ficha comercial)' },
	{ label: 'Forno', value: '~59 L · PerfectCook · VaporBake · Regenerar a Vapor · FastClean' },
	{ label: 'Voltagem', value: 'Bivolt' },
	{ label: 'Eficiência energética', value: 'Classe A' },
	{ label: 'Dimensões (A × L × P)', value: '97 × 52 × 65 cm' },
	{ label: 'Peso', value: '26,7 kg' },
	{ label: 'Referência comercial', value: 'FE4IW' },
];

const comparisonRows = [
	{ criterion: 'Preço', current: 'Faixa premium do ranking 4 bocas', alternative: 'Consul no meio; Atlas costuma ser a entrada' },
	{ criterion: 'Forno', current: 'PerfectCook / VaporBake como diferencial', alternative: 'CF04NAR atende rotina comum sem o ticket Efficient' },
	{ criterion: 'Mesa', current: 'Inox compartimentada + visual Efficient', alternative: 'Vidro é outro eixo — não compare só por marca' },
	{ criterion: 'Melhor perfil', current: 'Premium com propósito (forno/visual)', alternative: 'Equilíbrio → Consul; teto baixo → Atlas' },
];

const objections = [
	{
		question: 'Vale mais que o Consul CF04NAR?',
		answer:
			'Vale quando PerfectCook/VaporBake ou o visual da linha Efficient são requisito real. Se a meta é equilíbrio no uso típico sem premium, o CF04NAR costuma entregar melhor custo-benefício no meio da faixa.',
	},
	{
		question: 'Devo pagar o FE4IW em vez do Atlas Mônaco Plus?',
		answer:
			'Só se você realmente for usar recursos de forno e acabamento de linha. Se o teto de gasto manda no mínimo, o Atlas continua sendo a entrada racional — o FE4IW não é “Atlas com polish”; é outra proposta de compra.',
	},
	{
		question: 'Quatro bocas bastam se eu assar bastante?',
		answer:
			'Para família pequena a média com rotina comum de panelas, sim — o forno Efficient é o ganho. Se a casa usa várias panelas grandes ao mesmo tempo, o eixo correto é avaliar 5 bocas — não trocar só de marca dentro do 4 bocas.',
	},
];

const faqItems = [
	{
		question: 'O Electrolux FE4IW vale a pena?',
		answer:
			'Sim, para quem busca o premium do ranking 4 bocas com propósito: linha Efficient, mesa inox e forno com PerfectCook/VaporBake. Se esses recursos não forem requisito, o Consul CF04NAR costuma ser a compra mais racional.',
	},
	{
		question: 'O FE4IW é bom para apartamento?',
		answer:
			'Sim. O porte de 4 bocas costuma combinar melhor com cozinha compacta. Confirme medidas do vão (cerca de 97 × 52 × 65 cm) e folga da porta do forno antes de comprar.',
	},
	{
		question: 'Quando não vale escolher o FE4IW?',
		answer:
			'Quando o orçamento pede o mínimo absoluto (Atlas), quando o equilíbrio sem premium fecha a rotina (Consul CF04NAR) ou quando a simultaneidade de panelas exige 5 bocas de verdade.',
	},
	{
		question: 'Qual a diferença entre FE4IW e CF04NAR?',
		answer:
			'Ambos são 4 bocas com mesa inox no mesmo hub, mas com papéis distintos: o CF04NAR é o melhor geral (equilíbrio); o FE4IW é o melhor premium (linha Efficient e recursos de forno). Escolha pelo perfil de uso — não trate como o mesmo produto com outra marca.',
	},
];

const verdict =
	'O FE4IW continua sendo a compra premium com propósito no ranking 4 bocas: fecha quando forno Efficient e visual importam de verdade. Para equilíbrio sem excesso de ticket, Consul; para teto baixo, Atlas; para muitas panelas simultâneas, suba de categoria — não só de marca dentro do 4 bocas.';

const site = Astro.site ?? new URL('https://casapraticaeletro.com.br');
const canonicalPath = '/review-fogao-4-bocas-electrolux/';
const canonical = new URL(canonicalPath.replace(/^\//, ''), site).href;
const productImage = new URL(imagePath.replace(/^\//, ''), site).href;

const graph: Record<string, unknown>[] = [
	{
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Início', item: site.href },
			{ '@type': 'ListItem', position: 2, name: 'Review Electrolux FE4IW', item: canonical },
		],
	},
	{
		'@type': 'Product',
		name: model,
		description,
		image: [productImage],
		brand: { '@type': 'Brand', name: 'Electrolux' },
		sku: 'FE4IW',
		offers: {
			'@type': 'Offer',
			url: offerUrl,
			priceCurrency: 'BRL',
		},
	},
	{
		'@type': 'Article',
		headline,
		description,
		image: [productImage],
		author: {
			'@type': 'Organization',
			name: 'Casa Prática Eletro',
			url: site.href,
		},
		publisher: {
			'@type': 'Organization',
			name: 'Casa Prática Eletro',
			url: site.href,
		},
		mainEntityOfPage: canonical,
		articleSection: 'Reviews',
		inLanguage: 'pt-BR',
	},
	{
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	},
];

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': graph,
};
---

<BaseLayout
	title={title}
	description={description}
	canonical={canonical}
	openGraph={{
		title,
		description,
		url: canonical,
		image: productImage,
		imageAlt: 'Fogão Electrolux Efficient FE4IW branco com mesa inox',
		type: 'article',
	}}
>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
	<article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14 lg:py-16">
		<p class="text-xs font-bold uppercase tracking-[0.35em] text-pop">Review · Electrolux · Fogão 4 bocas</p>
		<h1 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-on-ink-body sm:text-4xl">
			{headline}
		</h1>
		<p class="mt-2 text-sm text-on-ink-muted">
			Modelo referência: <span class="text-on-ink-body">{model}</span>
			{' '}· linha Efficient
		</p>
		<p class="mt-6 text-lg leading-relaxed text-on-ink-body">
			{summary}
		</p>
		<p class="mt-4 text-sm leading-relaxed text-on-ink-muted">
			Este review integra o{' '}
			<a href="/melhores/melhor-fogao-4-bocas/#guia-comercial-produtos" class="link-accent-soft">
				melhor fogão 4 bocas
			</a>
			{' '}— medalha de melhor premium do ranking.
		</p>
		<div class="mt-8">
			<EditorialTrustRibbon />
		</div>
		<div class="mt-10">
			<ProductMedia
				src={imagePath}
				alt="Fogão Electrolux Efficient FE4IW branco com mesa inox"
				aspect="square"
			/>
		</div>
		<EditorialLinks
			class="mt-10"
			currentPath={canonicalPath}
			eyebrow="Leituras relacionadas"
			heading="Para complementar essa decisão"
			limit={3}
			kind={['Blog', 'Comparativo']}
		/>

		<section class="mt-12" aria-labelledby="perfil-heading">
			<h2 id="perfil-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Perfil de uso: para quem ele encaixa melhor
			</h2>
			<div class="mt-6 grid gap-4 sm:grid-cols-2">
				<div class="rounded-2xl border border-emerald-400/30 bg-emerald-950/20 p-5 ring-1 ring-emerald-400/15 sm:p-6">
					<h3 class="text-sm font-bold uppercase tracking-wider text-emerald-300">Faz mais sentido para</h3>
					<ul class="mt-4 list-inside list-disc space-y-2.5 text-sm leading-relaxed text-on-ink-body sm:text-base">
						{idealFor.map((item) => <li>{item}</li>)}
					</ul>
				</div>
				<div class="rounded-2xl border border-amber-300/25 bg-brand-900/45 p-5 ring-1 ring-white/10 sm:p-6">
					<h3 class="text-sm font-bold uppercase tracking-wider text-amber-200">Pode não compensar tanto para</h3>
					<ul class="mt-4 list-inside list-disc space-y-2.5 text-sm leading-relaxed text-on-ink-body sm:text-base">
						{notIdealFor.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</div>
			<div class="mt-6 grid gap-4 sm:grid-cols-2">
				<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
					<h3 class="font-display text-lg font-bold text-on-ink-body">Tipo de família</h3>
					<p class="mt-3 text-base leading-relaxed text-on-ink-body">{familyProfile}</p>
				</div>
				<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
					<h3 class="font-display text-lg font-bold text-on-ink-body">Rotina ideal</h3>
					<p class="mt-3 text-base leading-relaxed text-on-ink-body">{routineProfile}</p>
				</div>
			</div>
		</section>

		<div class="mt-12">
			<AffiliateOfferBlock
				id="ofertas"
				variant="featured"
				productName={model}
				heading={`Conferir preço atualizado do ${model}`}
				description="Preço e estoque mudam com frequência. Use os botões para ver disponibilidade e frete na sua região — sem compromisso de compra nesta página."
				mercadoLivreUrl={offerUrl}
				shopeeUrl={offerShopeeUrl}
			/>
		</div>

		<section class="mt-12" aria-labelledby="ficha-heading">
			<h2 id="ficha-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Ficha técnica resumida
			</h2>
			<p class="mt-4 text-base leading-relaxed text-on-ink-muted">
				Dados alinhados à página oficial da Electrolux e a fichas comerciais do SKU FE4IW. Potências de queimador e
				detalhe de acendimento podem variar entre anúncios — confirme no anúncio da loja a versão exata.
			</p>
			<div class="table-premium-shell mt-6">
				<table class="table-premium min-w-[320px]">
					<tbody>
						{
							specsRows.map((row, index) => (
								<tr class:list={[index % 2 === 0 ? 'bg-ink' : 'bg-brand-900/25']}>
									<th scope="row" class="font-semibold text-on-ink-body">
										{row.label}
									</th>
									<td>{row.value}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</section>

		<section class="mt-12" aria-labelledby="diferenciacao-heading">
			<h2 id="diferenciacao-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				O que diferencia esse modelo na prática
			</h2>
			<ul class="mt-5 list-inside list-disc space-y-2.5 text-base leading-relaxed text-on-ink-body">
				{differentiators.map((item) => <li>{item}</li>)}
			</ul>
			<p class="mt-5 text-base leading-relaxed text-on-ink-muted">
				Se você ainda está comparando proposta de valor entre marcas, vale abrir o{' '}
				<a
					href="/fogao-4-bocas-custo-beneficio/"
					class="link-accent"
					aria-label="Guia fogão 4 bocas custo-benefício"
				>
					guia de fogão 4 bocas custo-benefício
				</a>{' '}
				e o passo a passo em{' '}
				<a
					href="/como-escolher-fogao-4-bocas/"
					class="link-accent"
					aria-label="Guia como escolher fogão 4 bocas"
				>
					como escolher fogão 4 bocas
				</a>
				.
			</p>
		</section>

		<section class="mt-12" aria-labelledby="limitacoes-heading">
			<h2 id="limitacoes-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Limitações reais antes de comprar
			</h2>
			<ul class="mt-5 list-inside list-disc space-y-2.5 text-base leading-relaxed text-on-ink-body">
				{realLimitations.map((item) => <li>{item}</li>)}
			</ul>
		</section>

		<section class="mt-12" aria-labelledby="analise-tecnica-heading">
			<h2 id="analise-tecnica-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Forno, trempes, consumo e limpeza
			</h2>
			<div class="mt-6 space-y-8 text-base leading-relaxed text-on-ink-body">
				<div>
					<h3 class="font-display text-lg font-bold text-on-ink-body">Forno</h3>
					<p class="mt-3">{ovenAnalysis}</p>
				</div>
				<div>
					<h3 class="font-display text-lg font-bold text-on-ink-body">Trempes e uso com panelas</h3>
					<p class="mt-3">{gratesAnalysis}</p>
					<TechnicalFigure id="L06A" class="mt-6" />
				</div>
				<div>
					<h3 class="font-display text-lg font-bold text-on-ink-body">Consumo e custo de uso</h3>
					<p class="mt-3">{consumptionAnalysis}</p>
				</div>
				<div>
					<h3 class="font-display text-lg font-bold text-on-ink-body">Limpeza e manutenção visual</h3>
					<p class="mt-3">{cleaningAnalysis}</p>
				</div>
			</div>
		</section>

		<section class="mt-12" aria-labelledby="comparacao-heading">
			<h2 id="comparacao-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Comparação lateral: onde ele ganha e onde perde
			</h2>
			<div class="table-premium-shell mt-6">
				<table class="table-premium min-w-[420px]">
					<thead>
						<tr>
							<th scope="col">Critério</th>
							<th scope="col">{model}</th>
							<th scope="col">Alternativa típica</th>
						</tr>
					</thead>
					<tbody>
						{
							comparisonRows.map((row, index) => (
								<tr class:list={[index % 2 === 0 ? 'bg-ink' : 'bg-brand-900/25']}>
									<th scope="row" class="font-semibold text-on-ink-body">
										{row.criterion}
									</th>
									<td>{row.current}</td>
									<td>{row.alternative}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</section>

		<section class="mt-12" aria-labelledby="objecoes-heading">
			<h2 id="objecoes-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Objeções comuns de compra
			</h2>
			<dl class="mt-6 space-y-6">
				{
					objections.map((item) => (
						<div class="rounded-2xl border border-white/10 bg-brand-900/35 p-5 ring-1 ring-white/10">
							<dt class="font-display text-lg font-bold text-on-ink-body">{item.question}</dt>
							<dd class="mt-3 text-base leading-relaxed text-on-ink-muted">{item.answer}</dd>
						</div>
					))
				}
			</dl>
		</section>

		<div class="mt-12 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
			<a
				href={offerUrl}
				class="inline-flex min-h-[52px] flex-1 items-center justify-center gap-2 bg-cta px-6 text-xs font-extrabold uppercase tracking-wider text-white ring-1 ring-white/15 transition hover:bg-cta-hover sm:min-w-[200px]"
				target="_blank"
				rel="noopener noreferrer nofollow sponsored"
				aria-label={`Ver preço do fogão ${model} no Mercado Livre — abre em nova aba (link patrocinado)`}
			>
				<span aria-hidden="true">🔥</span>
				Ver preço no Mercado Livre
			</a>
			<a
				href={offerShopeeUrl}
				class="btn-secondary-premium flex-1 sm:min-w-[200px]"
				target="_blank"
				rel="noopener noreferrer nofollow sponsored"
				aria-label={`Ver oferta do fogão ${model} na Shopee — abre em nova aba (link patrocinado)`}
			>
				<span aria-hidden="true">👉</span>
				Ver oferta na Shopee
			</a>
		</div>
		<p class="mt-6 text-sm leading-relaxed text-on-ink-muted">
			Transparência: indicação de loja parceira. No guia{' '}
			<a
				href="/melhores/melhor-fogao-4-bocas/#guia-comercial-produtos"
				class="link-accent-soft"
				aria-label="Abrir guia melhor fogão 4 bocas com ofertas"
			>
				melhor fogão 4 bocas
			</a>{' '}
			você compara os 3 modelos e as ofertas na mesma página. Se a dúvida ainda for de tamanho, veja o{' '}
			<a
				href="/comparativo-fogao-4-vs-5-bocas/"
				class="link-accent-soft"
				aria-label="Comparativo fogão 4 vs 5 bocas"
			>
				comparativo 4 vs 5 bocas
			</a>
			. Prefere equilíbrio sem premium? Há a{' '}
			<a
				href="/review-fogao-4-bocas-consul/"
				class="link-accent-soft"
				aria-label="Review fogão Consul 4 bocas CF04NAR"
			>
				review do Consul CF04NAR
			</a>
			.
		</p>
		<section class="mt-12 rounded-2xl border border-white/10 bg-brand-900/35 p-6 ring-1 ring-white/10" aria-labelledby="veredito-heading">
			<h2 id="veredito-heading" class="font-display text-xl font-bold text-on-ink-body sm:text-2xl">
				Veredito editorial
			</h2>
			<p class="mt-4 text-base leading-relaxed text-on-ink-body">{verdict}</p>
			<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
				<a
					href={offerUrl}
					class="inline-flex min-h-[52px] flex-1 items-center justify-center gap-2 rounded-lg bg-cta px-6 text-center text-xs font-extrabold uppercase tracking-wider text-white ring-1 ring-white/15 transition hover:bg-cta-hover sm:min-w-[200px]"
					target="_blank"
					rel="noopener noreferrer nofollow sponsored"
					aria-label={`Ver preço atualizado do ${model} no Mercado Livre — abre em nova aba (link patrocinado)`}
				>
					Ver preço no Mercado Livre
				</a>
				<a
					href={offerShopeeUrl}
					class="btn-secondary-premium flex-1 sm:min-w-[200px]"
					target="_blank"
					rel="noopener noreferrer nofollow sponsored"
					aria-label={`Ver oferta do ${model} na Shopee — abre em nova aba (link patrocinado)`}
				>
					Ver oferta na Shopee
				</a>
			</div>
		</section>
		<section class="mt-14 border-t border-white/10 pt-12" aria-labelledby="faq-heading">
			<h2 id="faq-heading" class="font-display text-2xl font-bold tracking-tight text-on-ink-body">
				Perguntas frequentes
			</h2>
			<dl class="mt-8 space-y-8">
				{faqItems.map((item) => (
					<div>
						<dt class="font-semibold text-on-ink-body">{item.question}</dt>
						<dd class="mt-2 text-base leading-relaxed text-on-ink-muted">{item.answer}</dd>
					</div>
				))}
			</dl>
		</section>
		<RelatedContent
			class="mt-14"
			currentPath={canonicalPath}
			eyebrow="Veja também"
			title="Leituras relacionadas"
			subtitle="Ranking, checklist e comparativos do cluster 4 bocas para fechar a decisão sem voltar à estaca zero."
		/>

		<SmartRecommendations
			class="mt-12"
			currentPath={canonicalPath}
			heading="Continue a jornada"
		/>
	</article>
</BaseLayout>
