				headline: 'Review do fogão Brastemp 5 bocas BFS5NCR: para quem serve',
				summary:
					'Se você está considerando o Brastemp BFS5NCR, esta review mostra rápido para quem esse fogão 5 bocas faz sentido, o que o diferencia e onde ele pode não encaixar.',
				offerUrl: produtos.brastempBFS5NCR.ml,
				offerShopeeUrl: produtos.brastempBFS5NCR.shopee,
				productId: 'brastempBFS5NCR' as ProductId,
				longReviewHref: '/brastemp-bfs5ncr-vale-a-pena/',
