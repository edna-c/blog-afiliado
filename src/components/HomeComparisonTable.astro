---
import { produtos } from '../data/products';
import {
	getCommercialGuideBlock,
	getExistingProductReviewUrl,
	type CommercialGuideId,
} from '../data/commercialGuideBlocks';
import { getFogao5BocasComparisonFact } from '../data/fogao5BocasComparisonFacts';
import type { ComparisonColumnKey, ComparisonRow } from '../types/commercial';
import { mlAffiliateAttrs, shopeeAffiliateAttrs } from '../utils/affiliateTracking';

export type { ComparisonRow } from '../types/commercial';

interface Props {
	guideId?: CommercialGuideId;
}

const { guideId } = Astro.props;
const guideBlock = guideId ? getCommercialGuideBlock(guideId) : null;
const isGuideEmbed = guideBlock != null;

const homeRows: ComparisonRow[] = [
	{
		badge: '',
		model: 'Electrolux FE5IG',
		price: 'Confira na loja',
		rating: '',
		bestFor: 'Para quem quer mais recursos no forno e Tripla Chama',
		slug: 'electrolux',
		productId: 'electroluxFE5IG',
		links: produtos.electroluxFE5IG,
	},
	{
		badge: '',
		model: 'Brastemp BFS5NCR',
		price: 'Confira na loja',
		rating: '',
		bestFor: 'Para quem quer 96 L, duas prateleiras e vidro interno removível',
		slug: 'brastemp',
		productId: 'brastempBFS5NCR',
		links: produtos.brastempBFS5NCR,
	},
	{
		badge: '',
		model: 'Consul CFS5NAR',
		price: 'Confira na loja',
		rating: '',
		bestFor: 'Para quem quer 96 L, uma prateleira e vidro interno vedado',
		slug: 'consul',
		productId: 'consulCFS5NAR',
		links: produtos.consulCFS5NAR,
	},
];

const rows = guideBlock?.comparisonRows ?? homeRows;
const sectionId = isGuideEmbed ? 'guia-comercial-comparativo' : 'compare-heading';
/** Âncora de justificativas — fallback quando não há review do SKU. */
const justificativaHref = guideBlock?.reviewPathPrefix;
const productNoun = guideBlock?.productNoun ?? 'fogão';
const purchaseColumnLabel = guideBlock?.purchaseColumnLabel ?? 'Ação';
const comparisonMlCtaShort = guideBlock?.comparisonMlCtaShort === true;

const DEFAULT_COMPARISON_COLUMNS: ComparisonColumnKey[] = ['price', 'rating', 'bestFor'];
const comparisonColumns: ComparisonColumnKey[] = guideBlock?.comparisonColumns ?? DEFAULT_COMPARISON_COLUMNS;
const tableMinClass = comparisonColumns.length > 3 ? 'min-w-[1200px]' : 'min-w-[720px]';

const COMPARISON_COLUMN_LABEL: Record<ComparisonColumnKey, string> = {
	price: 'Preço (ref.)',
	rating: 'Avaliação',
	bestFor: 'Melhor para',
	oven: 'Forno',
	shelves: 'Prateleiras',
	doorGlass: 'Vidro interno',
	resources: 'Recursos',
	burners: 'Bocas',
	surface: 'Mesa',
	grates: 'Grades',
	flame: 'Chama',
	ignition: 'Acendimento',
	dimensions: 'Medidas',
};

function comparisonCell(row: ComparisonRow, key: ComparisonColumnKey): string {
	const fact = getFogao5BocasComparisonFact(row.productId);
	switch (key) {
		case 'price':
			return row.price;
		case 'rating':
			return row.rating;
		case 'bestFor':
			return row.bestFor;
		case 'oven':
			return fact?.oven ?? '—';
		case 'shelves':
			return fact?.shelves ?? '—';
		case 'doorGlass':
			return fact?.doorGlass ?? '—';
		case 'resources':
			return fact?.resources ?? '—';
		case 'burners':
			return row.burners ?? '—';
		case 'surface':
			return row.surface ?? '—';
		case 'grates':
			return row.grates ?? '—';
		case 'flame':
			return row.flame ?? '—';
		case 'ignition':
			return row.ignition ?? '—';
		case 'dimensions':
			return row.dimensions ?? '—';
	}
}

function rowAnalysisLink(row: ComparisonRow): {
	href: string;
	label: string;
	ariaLabel: string;
} {
	if (guideId === 'melhor-fogao-5-bocas' && justificativaHref) {
		return {
			href: justificativaHref,
			label: `Por que ${row.model} neste ranking`,
			ariaLabel: `Ver na página por que o ${productNoun} ${row.model} está nesta posição`,
		};
	}
	const reviewUrl = getExistingProductReviewUrl(guideId, row.slug);
	if (reviewUrl) {
		return {
			href: reviewUrl,
			label: `Ver análise completa — ${row.model}`,
			ariaLabel: `Ler análise completa do ${productNoun} ${row.model}`,
		};
	}
	if (justificativaHref) {
		return {
			href: justificativaHref,
			label: `Ver justificativa do ranking — ${row.model}`,
			ariaLabel: `Ver justificativa do ranking para o ${productNoun} ${row.model} nesta página`,
		};
	}
	return {
		href: `/review-fogao-5-bocas-${row.slug}/`,
		label: `Ver análise completa — ${row.model}`,
		ariaLabel: `Ler análise completa do ${productNoun} ${row.model}`,
	};
}
---

{
	isGuideEmbed ? (
		<div class="guia-comercial-embed not-prose relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen max-w-[100vw]">
			<section class="border-b border-white/10 bg-ink py-12 sm:py-16" aria-labelledby={sectionId}>
				<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
					<div class="guia-comercial-copy max-w-2xl">
						<h2 id={sectionId} class="font-display font-extrabold tracking-tight text-on-ink-body">
							{guideBlock!.comparisonCopy.heading}
						</h2>
						{guideBlock!.comparisonCopy.introParagraphs.map((paragraph) => (
							<p>{paragraph}</p>
						))}
					</div>
					<div class="table-premium-shell mt-8">
						<table class:list={['table-premium', tableMinClass]}>
							<thead>
								<tr>
									<th scope="col">Modelo</th>
									{comparisonColumns.map((col) => (
										<th scope="col">{COMPARISON_COLUMN_LABEL[col]}</th>
									))}
									<th scope="col">{purchaseColumnLabel}</th>
								</tr>
							</thead>
							<tbody>
								{rows.map((r, i) => (
									<tr
										class:list={[
											r.recommended
												? 'border-l-4 border-l-emerald-400 bg-emerald-950/40 ring-2 ring-inset ring-emerald-400/50 shadow-[inset_0_0_0_1px_rgba(52,211,153,0.15)]'
												: i % 2 === 0
													? 'bg-ink'
													: 'bg-brand-900/30',
										]}
									>
										<th scope="row" class="text-left align-top">
											{r.recommended ? (
												<p class="mb-2 text-xs font-bold tracking-wide text-pop">⭐ Recomendado</p>
											) : null}
											<p class="text-[10px] font-bold uppercase tracking-[0.25em] text-pop">{r.badge}</p>
											<div class="font-display mt-2 text-base font-bold text-on-ink-body">{r.model}</div>
										</th>
										{comparisonColumns.map((col) => (
											<td class:list={[col === 'rating' ? 'font-semibold text-pop' : 'text-on-ink-body']}>
												{comparisonCell(r, col)}
											</td>
										))}
										<td class="align-top">
											<div class="flex min-w-[8.5rem] flex-col gap-1.5">
												<a
													href={r.links.ml}
													class:list={[
														'cta-affiliate cta-affiliate--ml',
														comparisonMlCtaShort && 'cta-affiliate--compact',
													]}
													target="_blank"
													rel="noopener noreferrer nofollow sponsored"
													aria-label={`Ver oferta do ${productNoun} ${r.model} no Mercado Livre — abre em nova aba (link patrocinado)`}
													{...mlAffiliateAttrs(r.productId, 'comparison_table')}
												>
													{comparisonMlCtaShort ? (
														'Ver oferta'
													) : (
														<>
															<span aria-hidden="true">👉</span>
															Ver preço no Mercado Livre — {r.model}
														</>
													)}
												</a>
												{'shopee' in r.links && r.links.shopee ? (
													<a
														href={r.links.shopee}
														class:list={[
															'cta-affiliate cta-affiliate--shopee',
															comparisonMlCtaShort && 'cta-affiliate--compact',
														]}
														target="_blank"
														rel="noopener noreferrer nofollow sponsored"
														aria-label={`Ver oferta do ${productNoun} ${r.model} na Shopee — abre em nova aba (link patrocinado)`}
														{...shopeeAffiliateAttrs(r.productId, 'comparison_table')}
													>
														{comparisonMlCtaShort ? (
															'Ver oferta na Shopee'
														) : (
															<>
																<span aria-hidden="true">👉</span>
																Ver oferta na Shopee — {r.model}
															</>
														)}
													</a>
												) : null}
											</div>
											<a
												href={rowAnalysisLink(r).href}
												class="mt-3 inline-flex min-h-[44px] items-center text-xs font-bold text-pop underline decoration-pop/40 decoration-2 underline-offset-[5px] transition hover:text-accent-hover hover:decoration-pop"
												aria-label={rowAnalysisLink(r).ariaLabel}
											>
												{rowAnalysisLink(r).label}
											</a>
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
					{guideBlock!.comparisonCopy.footerNote ? (
						<p class="guia-comercial-footnote mt-6">
							{guideBlock!.comparisonCopy.footerNote}{' '}
							<a href="/comparativo-fogao-4-vs-5-bocas/" class="link-accent-soft">
								Comparativo entre fogões 4 e 5 bocas
							</a>
							.
						</p>
					) : null}
					{guideBlock!.comparisonCopy.footerCta ? (
						<p class="mt-3 text-sm font-medium text-on-ink-body">{guideBlock!.comparisonCopy.footerCta}</p>
					) : null}
				</div>
			</section>
		</div>
	) : (
		<section class="border-b border-white/10 bg-ink py-16 sm:py-20 lg:py-24" aria-labelledby={sectionId}>
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<h2 id={sectionId} class="font-display text-3xl font-extrabold tracking-tight text-on-ink-body sm:text-4xl">
					Tabela comparativa: melhores fogões 5 bocas
				</h2>
				<div class="mt-5 max-w-2xl space-y-4 text-sm leading-relaxed text-on-ink-body">
					<p>Forno, prateleiras e vidro interno da porta, lado a lado.</p>
				</div>
				<div class="table-premium-shell mt-8">
					<table class="table-premium min-w-[960px]">
						<thead>
							<tr>
								<th scope="col">Modelo</th>
								<th scope="col">Forno</th>
								<th scope="col">Prateleiras</th>
								<th scope="col">Vidro interno</th>
								<th scope="col">Recursos</th>
								<th scope="col">Melhor para</th>
								<th scope="col">Onde comprar</th>
							</tr>
						</thead>
						<tbody>
							{
								rows.map((r, i) => {
									const fact = getFogao5BocasComparisonFact(r.productId);
									return (
									<tr class:list={[i % 2 === 0 ? 'bg-ink' : 'bg-brand-900/30']}>
										<th scope="row" class="text-left align-top">
											<div class="font-display text-base font-bold text-on-ink-body">{r.model}</div>
										</th>
										<td class="text-on-ink-body">{fact?.oven ?? '—'}</td>
										<td class="text-on-ink-body">{fact?.shelves ?? '—'}</td>
										<td class="text-on-ink-body">{fact?.doorGlass ?? '—'}</td>
										<td class="text-on-ink-body">{fact?.resources ?? '—'}</td>
										<td class="text-on-ink-body">{r.bestFor}</td>
										<td class="align-middle">
											<div class="flex min-w-[8.5rem] flex-col gap-1.5">
												<a
													href={r.links.ml}
													class="cta-affiliate cta-affiliate--ml cta-affiliate--compact"
													target="_blank"
													rel="noopener noreferrer nofollow sponsored"
													aria-label={`Ver oferta do fogão ${r.model} no Mercado Livre — abre em nova aba (link patrocinado)`}
													{...mlAffiliateAttrs(r.productId, 'comparison_table')}
												>
													Ver oferta
												</a>
												{'shopee' in r.links && r.links.shopee ? (
													<a
														href={r.links.shopee}
														class="cta-affiliate cta-affiliate--shopee cta-affiliate--compact"
														target="_blank"
														rel="noopener noreferrer nofollow sponsored"
														aria-label={`Ver oferta do fogão ${r.model} na Shopee — abre em nova aba (link patrocinado)`}
														{...shopeeAffiliateAttrs(r.productId, 'comparison_table')}
													>
														Ver na Shopee
													</a>
												) : null}
											</div>
										</td>
									</tr>
									);
								})
							}
						</tbody>
					</table>
				</div>
			</div>
		</section>
	)
}
