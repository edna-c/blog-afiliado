---
import { produtos } from '../data/products';
import {
	getCommercialGuideBlock,
	getExistingProductReviewUrl,
	type CommercialGuideId,
} from '../data/commercialGuideBlocks';
import type { ComparisonRow } from '../types/commercial';
import { mlAffiliateAttrs, shopeeAffiliateAttrs } from '../utils/affiliateTracking';

export type { ComparisonRow } from '../types/commercial';

interface Props {
	guideId?: CommercialGuideId;
}

const { guideId } = Astro.props;
const guideBlock = guideId ? getCommercialGuideBlock(guideId) : null;
const isGuideEmbed = guideBlock != null;

const homeRows: ComparisonRow[] = [
	{
		badge: 'Melhor geral',
		recommended: true,
		model: 'Electrolux FE5IG',
		price: 'Confira na loja',
		rating: '⭐⭐⭐⭐⭐',
		bestFor: 'Forno + acabamento',
		slug: 'electrolux',
		productId: 'electroluxFE5IG',
		links: produtos.electroluxFE5IG,
	},
	{
		badge: 'Custo-benefício',
		model: 'Brastemp BFS5NCR',
		price: 'Confira na loja',
		rating: '⭐⭐⭐⭐⭐',
		bestFor: 'Rotina familiar',
		slug: 'brastemp',
		productId: 'brastempBFS5NCR',
		links: produtos.brastempBFS5NCR,
	},
	{
		badge: 'Entrada',
		model: 'Consul CFS5NAB',
		price: 'Confira na loja',
		rating: '⭐⭐⭐⭐☆',
		bestFor: 'Orçamento contido',
		slug: 'consul',
		productId: 'consulCFS5NAB',
		links: produtos.consulCFS5NAB,
	},
];
const rows = guideBlock?.comparisonRows ?? homeRows;
const sectionId = isGuideEmbed ? 'guia-comercial-comparativo' : 'compare-heading';
/** Âncora de justificativas — fallback quando não há review do SKU. */
const justificativaHref = guideBlock?.reviewPathPrefix;

function rowAnalysisLink(row: ComparisonRow): {
	href: string;
	label: string;
	ariaLabel: string;
} {
	const reviewUrl = getExistingProductReviewUrl(guideId, row.slug);
	if (reviewUrl) {
		return {
			href: reviewUrl,
			label: `Ver análise completa — ${row.model}`,
			ariaLabel: `Ler análise completa do fogão ${row.model}`,
		};
	}
	if (justificativaHref) {
		return {
			href: justificativaHref,
			label: `Ver justificativa do ranking — ${row.model}`,
			ariaLabel: `Ver justificativa do ranking para o fogão ${row.model} nesta página`,
		};
	}
	return {
		href: `/review-fogao-5-bocas-${row.slug}/`,
		label: `Ver análise completa — ${row.model}`,
		ariaLabel: `Ler análise completa do fogão ${row.model}`,
	};
}
---

{
	isGuideEmbed ? (
		<div class="guia-comercial-embed not-prose relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen max-w-[100vw]">
			<section class="border-b border-white/10 bg-ink py-12 sm:py-16" aria-labelledby={sectionId}>
				<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
					<div class="guia-comercial-copy max-w-2xl">
						<h2 id={sectionId} class="font-display font-extrabold tracking-tight text-on-ink-body">
							{guideBlock!.comparisonCopy.heading}
						</h2>
						{guideBlock!.comparisonCopy.introParagraphs.map((paragraph) => (
							<p>{paragraph}</p>
						))}
					</div>
					<div class="table-premium-shell mt-8">
						<table class="table-premium min-w-[720px]">
							<thead>
								<tr>
									<th scope="col">Modelo</th>
									<th scope="col">Preço (ref.)</th>
									<th scope="col">Avaliação</th>
									<th scope="col">Melhor para</th>
									<th scope="col">Ação</th>
								</tr>
							</thead>
							<tbody>
								{rows.map((r, i) => (
									<tr
										class:list={[
											r.recommended
												? 'border-l-4 border-l-emerald-400 bg-emerald-950/40 ring-2 ring-inset ring-emerald-400/50 shadow-[inset_0_0_0_1px_rgba(52,211,153,0.15)]'
												: i % 2 === 0
													? 'bg-ink'
													: 'bg-brand-900/30',
										]}
									>
										<th scope="row" class="text-left align-top">
											{r.recommended ? (
												<p class="mb-2 text-xs font-bold tracking-wide text-pop">⭐ Recomendado</p>
											) : null}
											<p class="text-[10px] font-bold uppercase tracking-[0.25em] text-pop">{r.badge}</p>
											<div class="font-display mt-2 text-base font-bold text-on-ink-body">{r.model}</div>
										</th>
										<td class="text-on-ink-body">{r.price}</td>
										<td class="font-semibold text-pop">{r.rating}</td>
										<td class="text-on-ink-body">{r.bestFor}</td>
										<td class="align-top">
											<div class="flex min-w-[12rem] flex-col gap-2">
												<a
													href={r.links.ml}
													class="inline-flex min-h-[48px] w-full items-center justify-center gap-1 rounded-lg border-2 border-transparent bg-cta px-4 text-xs font-bold uppercase tracking-wide text-white ring-1 ring-white/15 transition duration-300 ease-out hover:bg-cta-hover"
													target="_blank"
													rel="noopener noreferrer nofollow sponsored"
													aria-label={`Ver preço do fogão ${r.model} no Mercado Livre — abre em nova aba (link patrocinado)`}
													{...mlAffiliateAttrs(r.productId, 'comparison_table')}
												>
													<span aria-hidden="true">👉</span>
													Ver preço no Mercado Livre — {r.model}
												</a>
												{'shopee' in r.links && r.links.shopee ? (
													<a
														href={r.links.shopee}
														class="btn-secondary-premium w-full px-4"
														target="_blank"
														rel="noopener noreferrer nofollow sponsored"
														aria-label={`Ver oferta do fogão ${r.model} na Shopee — abre em nova aba (link patrocinado)`}
														{...shopeeAffiliateAttrs(r.productId, 'comparison_table')}
													>
														<span aria-hidden="true">👉</span>
														Ver oferta na Shopee — {r.model}
													</a>
												) : null}
											</div>
											<a
												href={rowAnalysisLink(r).href}
												class="mt-3 inline-flex min-h-[44px] items-center text-xs font-bold text-pop underline decoration-pop/40 decoration-2 underline-offset-[5px] transition hover:text-accent-hover hover:decoration-pop"
												aria-label={rowAnalysisLink(r).ariaLabel}
											>
												{rowAnalysisLink(r).label}
											</a>
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
					{guideBlock!.comparisonCopy.footerNote ? (
						<p class="guia-comercial-footnote mt-6">
							{guideBlock!.comparisonCopy.footerNote}{' '}
							<a href="/comparativo-fogao-4-vs-5-bocas/" class="link-accent-soft">
								Comparativo entre fogões 4 e 5 bocas
							</a>
							.
						</p>
					) : null}
					{guideBlock!.comparisonCopy.footerCta ? (
						<p class="mt-3 text-sm font-medium text-on-ink-body">{guideBlock!.comparisonCopy.footerCta}</p>
					) : null}
				</div>
			</section>
		</div>
	) : (
		<section class="border-b border-white/10 bg-ink py-16 sm:py-20 lg:py-24" aria-labelledby={sectionId}>
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<h2 id={sectionId} class="font-display text-3xl font-extrabold tracking-tight text-on-ink-body sm:text-4xl">
					Tabela comparativa: melhores fogões 5 bocas
				</h2>
				<div class="mt-5 max-w-2xl space-y-4 text-sm leading-relaxed text-on-ink-body">
					<p>Veja os modelos mais vendidos e compare as ofertas sem sair da página.</p>
					<p>A tabela abaixo reúne preço de referência, nota e o destaque de cada modelo para facilitar sua decisão.</p>
					<p>
						Quer entender os critérios antes de comparar? Confira o{' '}
						<a href="/melhores/melhor-fogao-5-bocas/" class="link-accent">guia de melhor fogão 5 bocas</a>.
					</p>
					<p>Se o foco for economia, a coluna “Melhor para” ajuda a identificar rapidamente os modelos com melhor custo-benefício.</p>
					<p>Analise o comparativo completo e escolha com mais segurança.</p>
				</div>
				<div class="table-premium-shell mt-8">
					<table class="table-premium min-w-[720px]">
						<thead>
							<tr>
								<th scope="col">Modelo</th>
								<th scope="col">Preço (ref.)</th>
								<th scope="col">Avaliação</th>
								<th scope="col">Melhor para</th>
								<th scope="col">Ação</th>
							</tr>
						</thead>
						<tbody>
							{
								rows.map((r, i) => (
									<tr
										class:list={[
											r.recommended
												? 'border-l-4 border-l-emerald-400 bg-emerald-950/40 ring-2 ring-inset ring-emerald-400/50 shadow-[inset_0_0_0_1px_rgba(52,211,153,0.15)]'
												: i % 2 === 0
													? 'bg-ink'
													: 'bg-brand-900/30',
										]}
									>
										<th scope="row" class="text-left align-top">
											{r.recommended ? (
												<p class="mb-2 text-xs font-bold tracking-wide text-pop">⭐ Recomendado</p>
											) : null}
											<p class="text-[10px] font-bold uppercase tracking-[0.25em] text-pop">{r.badge}</p>
											<div class="font-display mt-2 text-base font-bold text-on-ink-body">{r.model}</div>
										</th>
										<td class="text-on-ink-body">{r.price}</td>
										<td class="font-semibold text-pop">{r.rating}</td>
										<td class="text-on-ink-body">{r.bestFor}</td>
										<td class="align-top">
											<div class="flex min-w-[12rem] flex-col gap-2">
												<a
													href={r.links.ml}
													class="inline-flex min-h-[48px] w-full items-center justify-center gap-1 rounded-lg border-2 border-transparent bg-cta px-4 text-xs font-bold uppercase tracking-wide text-white ring-1 ring-white/15 transition duration-300 ease-out hover:bg-cta-hover"
													target="_blank"
													rel="noopener noreferrer nofollow sponsored"
													aria-label={`Ver preço do fogão ${r.model} no Mercado Livre — abre em nova aba (link patrocinado)`}
													{...mlAffiliateAttrs(r.productId, 'comparison_table')}
												>
													<span aria-hidden="true">👉</span>
													Ver preço no Mercado Livre — {r.model}
												</a>
												{
													'shopee' in r.links && r.links.shopee ? (
														<a
															href={r.links.shopee}
															class="btn-secondary-premium w-full px-4"
															target="_blank"
															rel="noopener noreferrer nofollow sponsored"
															aria-label={`Ver oferta do fogão ${r.model} na Shopee — abre em nova aba (link patrocinado)`}
															{...shopeeAffiliateAttrs(r.productId, 'comparison_table')}
														>
															<span aria-hidden="true">👉</span>
															Ver oferta na Shopee — {r.model}
														</a>
													) : null
												}
											</div>
											<a
												href={rowAnalysisLink(r).href}
												class="mt-3 inline-flex min-h-[44px] items-center text-xs font-bold text-pop underline decoration-pop/40 decoration-2 underline-offset-[5px] transition hover:text-accent-hover hover:decoration-pop"
												aria-label={rowAnalysisLink(r).ariaLabel}
											>
												{rowAnalysisLink(r).label}
											</a>
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
				<p class="mt-6 text-xs text-on-ink-muted">
					Antes de fechar, vale cruzar com o{' '}
					<a href="/comparativo-fogao-4-vs-5-bocas/" class="link-accent-soft">
						comparativo entre fogões 4 e 5 bocas
					</a>
					.
				</p>
				<p class="mt-3 text-sm font-medium text-on-ink-body">Continue lendo para entender melhor os critérios de compra e evitar erro na escolha.</p>
			</div>
		</section>
	)
}
