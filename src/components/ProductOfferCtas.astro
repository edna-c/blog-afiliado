---
/**
 * CTAs afiliados por productId — lê URLs só de `src/data/products.ts`.
 * Usado nos blocos de justificativa dos hubs comerciais.
 * Visual: `.cta-affiliate` / `.cta-affiliate--ml` / `.cta-affiliate--shopee` (global.css).
 */
import { produtos, type ProductId, type ProdutoAfiliado } from '../data/products';
import {
	mlAffiliateAttrs,
	shopeeAffiliateAttrs,
	type AffiliateCtaPosition,
} from '../utils/affiliateTracking';

interface Props {
	productId: ProductId;
	productName: string;
	productNoun?: string;
	ctaPosition?: AffiliateCtaPosition;
	class?: string;
	/** Padrão: mostra o ícone. Só desligar na página que pedir. */
	showIcon?: boolean;
}

const {
	productId,
	productName,
	productNoun = 'produto',
	ctaPosition = 'justification',
	class: pairClass = 'not-prose cta-affiliate-pair mt-6',
	showIcon = true,
} = Astro.props;

const links = produtos[productId] as ProdutoAfiliado;
const pending = links.affiliatePending === true;
const rel = pending
	? 'noopener noreferrer nofollow'
	: 'noopener noreferrer nofollow sponsored';
const disclosure = pending ? 'abre em nova aba' : 'abre em nova aba (link patrocinado)';
const mlUrl = links.ml;
const shopeeUrl = links.shopee;
const single = Boolean(mlUrl) !== Boolean(shopeeUrl);
const freightCta = productNoun === 'cooktop';
const mlLabel = freightCta
	? '👉 Ver preço, frete grátis e entrega rápida no Mercado Livre'
	: 'Ver preço no Mercado Livre';
const shopeeLabel = freightCta
	? '👉 Ver preço, frete grátis e entrega rápida na Shopee'
	: 'Ver preço na Shopee';
const mlAriaLabel = freightCta
	? mlLabel
	: `Ver preço do ${productNoun} ${productName} no Mercado Livre — ${disclosure}`;
const shopeeAriaLabel = freightCta
	? shopeeLabel
	: `Ver preço do ${productNoun} ${productName} na Shopee — ${disclosure}`;
---

{
	mlUrl || shopeeUrl ? (
		<p class={pairClass}>
			{mlUrl ? (
				<a
					href={mlUrl}
					class:list={['cta-affiliate cta-affiliate--ml', single && 'sm:col-span-2']}
					target="_blank"
					rel={rel}
					aria-label={mlAriaLabel}
					{...mlAffiliateAttrs(productId, ctaPosition)}
				>
					{showIcon && !freightCta ? <span aria-hidden="true">👉</span> : null}
					<span class="min-w-0 text-balance">{mlLabel}</span>
				</a>
			) : null}
			{shopeeUrl ? (
				<a
					href={shopeeUrl}
					class:list={['cta-affiliate cta-affiliate--shopee', single && 'sm:col-span-2']}
					target="_blank"
					rel={rel}
					aria-label={shopeeAriaLabel}
					{...shopeeAffiliateAttrs(productId, ctaPosition)}
				>
					{showIcon && !freightCta ? <span aria-hidden="true">👉</span> : null}
					<span class="min-w-0 text-balance">{shopeeLabel}</span>
				</a>
			) : null}
		</p>
	) : null
}
