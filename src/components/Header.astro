---
import Logo from '../assets/logo.png';
import { getCollection } from 'astro:content';
import { primaryNav } from '../data/navigation';
import { isNavActive } from '../utils/isNavActive';
import { melhoresGuideHref } from '../data/melhoresListing';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';

const blogPosts = await getCollection('blog');
const melhoresGuides = (await getCollection('melhores')).filter((guide) => !guide.id.startsWith('_'));
const searchIndex = [
	{ title: 'Início', url: '/' },
	{ title: 'Guias de Compra', url: '/melhores/' },
	{ title: 'Blog', url: '/blog/' },
	{ title: 'Sobre', url: '/sobre/' },
	{ title: 'Contato', url: '/contato/' },
	{ title: 'Melhor fogão 5 bocas', url: '/#top-produtos' },
	{ title: 'Como escolher fogão 5 bocas', url: '/como-escolher-fogao-5-bocas/' },
	{ title: 'Comparativo fogão 4 vs 5 bocas', url: '/comparativo-fogao-4-vs-5-bocas/' },
	{ title: 'Fogão 5 bocas custo-benefício', url: '/fogao-5-bocas-custo-beneficio/' },
	...melhoresGuides.map((guide) => ({
		title: guide.data.title,
		url: melhoresGuideHref(guide.id),
	})),
	...blogPosts.map((post) => ({
		title: post.data.title,
		url: `/blog/${post.id}/`,
	})),
];
---

<header
	id="site-header"
	class:list={['editorial-header sticky top-0 z-50', isHome && 'is-home']}
>
	<!-- Barra Superior -->
	<div class="top-bar" data-header-rail>
		<div class="top-copy">
			<span class="top-left">PUBLICAÇÃO EDITORIAL INDEPENDENTE DESDE 2026</span>
			<span class="site-slogan">Guias, comparativos e reviews para decisões de compra.</span>
		</div>
		<div class="top-line" aria-hidden="true"></div>

		<div class="top-utility">
			<button
				type="button"
				class="utility-btn header-menu-toggle"
				aria-label="Abrir menu de navegação"
				aria-expanded="false"
				aria-controls="mobile-nav-panel"
				data-header-menu-toggle
			>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" data-menu-icon-open>
					<path d="M4 8h16M4 12h16M4 16h16" stroke-linecap="round" />
				</svg>
				<svg class="is-hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" data-menu-icon-close>
					<path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
				</svg>
			</button>
		</div>
	</div>

	<!-- Cabeçalho Principal: Logo | Menu | Busca -->
	<div class="header-main">
		<div class="logo-area">
			<a href="/" aria-label="Casa Prática Eletro — página inicial">
				<img
					src={Logo.src}
					alt="Casa Prática Eletro"
					width={Logo.width}
					height={Logo.height}
					class="logo"
					decoding="async"
					fetchpriority="high"
				/>
			</a>
		</div>

		<nav class="menu" aria-label="Principal">
			{
				primaryNav.map((item) => {
					const active = isNavActive(pathname, item.href, item.activePrefixes);
					return (
						<a
							href={item.href}
							class:list={[active && 'active']}
							aria-label={item.ariaLabel}
							aria-current={active ? 'page' : undefined}
						>
							{item.label}
						</a>
					);
				})
			}
		</nav>

		<div class="search-area">
			<form role="search" aria-label="Buscar artigos no site" class="search-box" data-header-search-form>
				<label for="header-search-input" class="sr-only">Buscar no site</label>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<circle cx="11" cy="11" r="7"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<input
					id="header-search-input"
					type="search"
					name="q"
					autocomplete="off"
					placeholder="Buscar no site"
					data-header-search-input
				/>
				<div
					class="search-results"
					data-header-search-results
					role="listbox"
					aria-label="Resultados da busca"
					hidden
				/>
			</form>
		</div>
	</div>

	<!-- Linha Verde -->
	<div class="bottom-line" aria-hidden="true"></div>

	<div id="mobile-search-panel" class="header-drawer" hidden data-mobile-search-panel>
		<div class="header-drawer__inner">
			<form role="search" aria-label="Buscar artigos no site" class="search-box search-box--mobile" data-header-search-form-mobile>
				<label for="header-search-input-mobile" class="sr-only">Buscar no site</label>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<circle cx="11" cy="11" r="7"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<input
					id="header-search-input-mobile"
					type="search"
					name="q"
					autocomplete="off"
					placeholder="Buscar no site"
					data-header-search-input
				/>
				<div
					class="search-results search-results--mobile"
					data-header-search-results
					role="listbox"
					aria-label="Resultados da busca"
					hidden
				/>
			</form>
		</div>
	</div>

	<div id="mobile-nav-panel" class="header-drawer" hidden data-mobile-nav-panel>
		<nav class="header-drawer__inner menu menu--mobile" aria-label="Principal">
			{
				primaryNav.map((item) => {
					const active = isNavActive(pathname, item.href, item.activePrefixes);
					return (
						<a
							href={item.href}
							class:list={[active && 'active']}
							aria-label={item.ariaLabel}
							aria-current={active ? 'page' : undefined}
						>
							{item.label}
						</a>
					);
				})
			}
		</nav>
	</div>
</header>

<script id="site-search-index" type="application/json" set:html={JSON.stringify(searchIndex)} />

<script>
	const searchIndex = JSON.parse(
		(document.getElementById('site-search-index') as HTMLScriptElement | null)?.textContent || '[]',
	) as { title: string; url: string }[];

	const header = document.getElementById('site-header');
	const headerRail = document.querySelector('[data-header-rail]');
	const menuToggle = document.querySelector('[data-header-menu-toggle]');
	const menuPanel = document.querySelector('[data-mobile-nav-panel]');
	const searchToggle = document.querySelector('[data-header-search-toggle]');
	const mobileSearchPanel = document.querySelector('[data-mobile-search-panel]');
	const menuIconOpen = document.querySelector('[data-menu-icon-open]');
	const menuIconClose = document.querySelector('[data-menu-icon-close]');
	const desktopNavMq = window.matchMedia('(min-width: 769px)');

	function resetMobileUi() {
		closePanel(menuPanel, menuToggle);
		closePanel(mobileSearchPanel, searchToggle);
		menuIconOpen?.classList.remove('is-hidden');
		menuIconClose?.classList.add('is-hidden');
	}

	function setExpanded(button: Element | null, expanded: boolean) {
		if (button instanceof HTMLButtonElement) button.setAttribute('aria-expanded', String(expanded));
	}

	function closePanel(panel: Element | null, button: Element | null) {
		if (panel instanceof HTMLElement) panel.hidden = true;
		setExpanded(button, false);
	}

	function openPanel(panel: Element | null, button: Element | null) {
		if (panel instanceof HTMLElement) panel.hidden = false;
		setExpanded(button, true);
	}

	menuToggle?.addEventListener('click', () => {
		if (desktopNavMq.matches) return;
		const isOpen = menuPanel instanceof HTMLElement && !menuPanel.hidden;
		if (isOpen) {
			closePanel(menuPanel, menuToggle);
			menuIconOpen?.classList.remove('is-hidden');
			menuIconClose?.classList.add('is-hidden');
		} else {
			closePanel(mobileSearchPanel, searchToggle);
			openPanel(menuPanel, menuToggle);
			menuIconOpen?.classList.add('is-hidden');
			menuIconClose?.classList.remove('is-hidden');
		}
	});

	searchToggle?.addEventListener('click', () => {
		if (desktopNavMq.matches) return;
		const isOpen = mobileSearchPanel instanceof HTMLElement && !mobileSearchPanel.hidden;
		if (isOpen) {
			closePanel(mobileSearchPanel, searchToggle);
		} else {
			closePanel(menuPanel, menuToggle);
			menuIconOpen?.classList.remove('is-hidden');
			menuIconClose?.classList.add('is-hidden');
			openPanel(mobileSearchPanel, searchToggle);
			const input = mobileSearchPanel?.querySelector('[data-header-search-input]');
			if (input instanceof HTMLInputElement) input.focus();
		}
	});

	let isScrolled = false;
	let scrollTicking = false;
	const SCROLL_ENTER = 48;
	const SCROLL_EXIT = 4;

	const applyScrolledState = (scrolled: boolean) => {
		if (!header || scrolled === isScrolled) return;
		const heightBefore = header.offsetHeight;
		isScrolled = scrolled;
		header.classList.toggle('is-scrolled', scrolled);
		if (headerRail instanceof HTMLElement) {
			headerRail.setAttribute('aria-hidden', String(scrolled));
		}
		// O modo compacto reduz a altura do header; sem compensação o documento “puxa” o scroll (sensação de enrosco).
		const heightAfter = header.offsetHeight;
		const delta = heightBefore - heightAfter;
		if (delta !== 0) {
			const root = document.documentElement;
			const prevBehavior = root.style.scrollBehavior;
			root.style.scrollBehavior = 'auto';
			window.scrollBy(0, delta);
			root.style.scrollBehavior = prevBehavior;
		}
	};

	const onScroll = () => {
		if (!header || scrollTicking) return;
		scrollTicking = true;
		requestAnimationFrame(() => {
			const y = window.scrollY;
			const scrolled = isScrolled ? y > SCROLL_EXIT : y > SCROLL_ENTER;
			applyScrolledState(scrolled);
			scrollTicking = false;
		});
	};
	onScroll();
	window.addEventListener('scroll', onScroll, { passive: true });
	desktopNavMq.addEventListener('change', (event) => {
		if (event.matches) resetMobileUi();
	});

	function normalize(value: string) {
		return value
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '')
			.toLowerCase()
			.trim();
	}

	function renderResults(container: HTMLElement, query: string) {
		const q = normalize(query);
		const matches =
			q.length < 2 ? [] : searchIndex.filter((item) => normalize(item.title).includes(q)).slice(0, 6);

		container.innerHTML = '';
		if (!matches.length) {
			container.hidden = true;
			container.classList.remove('search-results--open');
			return;
		}

		for (const match of matches) {
			const link = document.createElement('a');
			link.href = match.url;
			link.className = 'search-result';
			link.textContent = match.title;
			link.setAttribute('role', 'option');
			container.appendChild(link);
		}

		container.hidden = false;
		container.classList.add('search-results--open');
	}

	function bindSearch(form: HTMLFormElement) {
		const input = form.querySelector('[data-header-search-input]');
		const results = form.querySelector('[data-header-search-results]');

		if (!(input instanceof HTMLInputElement) || !(results instanceof HTMLElement)) return;

		input.addEventListener('input', () => renderResults(results, input.value));

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const q = normalize(input.value);
			if (!q) return;
			const match = searchIndex.find((item) => normalize(item.title).includes(q));
			if (match) window.location.href = match.url;
		});

		document.addEventListener('click', (event) => {
			if (!form.contains(event.target as Node)) {
				results.hidden = true;
				results.classList.remove('search-results--open');
			}
		});
	}

	document.querySelectorAll('form[data-header-search-form], form[data-header-search-form-mobile]').forEach((form) => {
		if (form instanceof HTMLFormElement) bindSearch(form);
	});
</script>

<style>
	/* ===========================
	   BASE / VARIÁVEIS (inalteradas)
	=========================== */

	.editorial-header {
		--green: #00c853;
		--border: #222;
		--bg: #000000;
		--text: #ffffff;
		--text-muted: #bdbdbd;
		background: var(--bg);
		color: var(--text);
		box-shadow:
			inset 0 -1px 0 #222,
			0 15px 35px rgba(0, 0, 0, 0.45);
		/* Evita que o scroll anchoring do browser lute contra a compactação do header. */
		overflow-anchor: none;
	}

	.editorial-header.is-home {
		margin-bottom: 0;
	}

	/* ===========================
	   BARRA SUPERIOR
	=========================== */

	.top-bar {
		display: flex;
		align-items: center;
		gap: 20px;
		padding: 12px 40px 4px;
	}

	.top-copy {
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
		gap: 4px;
		min-width: 0;
	}

	.top-left {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 2px;
		line-height: 1.2;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.site-slogan {
		font-size: 0.82rem;
		line-height: 1.35;
		color: var(--text-muted);
		opacity: 0.7;
	}

	.top-line {
		flex: 1;
		height: 1px;
		min-width: 2rem;
		background: var(--border);
	}

	.top-utility {
		display: none;
		flex-shrink: 0;
		align-items: center;
		gap: 0.125rem;
	}

	/* ===========================
	   CABEÇALHO PRINCIPAL
	   Logo → Menu → Busca
	=========================== */

	.header-main {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-start;
		gap: 12px;
		padding-top: 28px;
		padding-bottom: 24px;
		padding-inline: 40px;
	}

	/* ===========================
	   LOGO
	=========================== */

	.logo-area {
		flex-shrink: 0;
		min-width: 0;
		max-width: 454px;
		order: 1;
	}

	.logo-area a {
		display: block;
		line-height: 0;
		max-width: 100%;
	}

	.logo {
		display: block;
		width: 100%;
		max-width: 454px;
		height: auto;
		/* Só transform no hover — max-width do modo compacto não deve animar (causa reflow no scroll). */
		transition: transform 0.35s ease;
	}

	.logo:hover {
		transform: scale(1.02);
	}

	/* ===========================
	   MENU (logo → menu → busca)
	=========================== */

	.menu {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		flex: 0 1 auto;
		flex-wrap: wrap;
		order: 2;
		gap: 2.5rem;
		padding: 0;
		border: none;
		background: transparent;
	}

	.menu a {
		position: relative;
		padding-bottom: 6px;
		color: #ececec;
		text-decoration: none;
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 2px;
		text-transform: uppercase;
		white-space: nowrap;
		transition:
			color 0.25s ease,
			letter-spacing 0.25s ease;
	}

	.menu a:hover {
		color: var(--green);
		letter-spacing: 2.5px;
	}

	.menu a.active {
		color: var(--green);
	}

	.menu a::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 0;
		height: 2px;
		background: var(--green);
		transition: 0.3s;
	}

	.menu a:hover::after,
	.menu a.active::after {
		width: 100%;
	}

	/* ===========================
	   BUSCA (canto direito)
	=========================== */

	.search-area {
		display: flex;
		flex: 0 0 auto;
		align-items: center;
		align-self: center;
		justify-content: flex-end;
		order: 3;
		margin-inline-start: auto;
	}

	.search-box {
		position: relative;
		display: flex;
		align-items: center;
		gap: 12px;
		width: 100%;
		max-width: 280px;
		padding: 14px 18px;
		border: 1px solid var(--border);
		border-radius: 14px;
		background: #0c0c0c;
		color: var(--text-muted);
		transition:
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}

	.search-box:focus-within {
		border-color: var(--green);
		box-shadow: 0 0 20px rgba(0, 200, 83, 0.25);
		color: var(--text);
	}

	.search-box svg {
		flex-shrink: 0;
	}

	.search-box input {
		width: 100%;
		min-width: 0;
		border: none;
		background: transparent;
		padding: 0;
		font-family: inherit;
		font-size: 0.9rem;
		color: var(--text);
	}

	.search-box input::placeholder {
		color: var(--text-muted);
	}

	.search-box input:focus {
		outline: none;
	}

	.search-box input::-webkit-search-cancel-button {
		-webkit-appearance: none;
	}

	.search-results {
		pointer-events: none;
		visibility: hidden;
		position: absolute;
		left: 0;
		right: 0;
		top: calc(100% + 0.5rem);
		z-index: 50;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: #0c0c0c;
		padding: 0.375rem;
		opacity: 0;
		transition:
			opacity 200ms ease,
			visibility 200ms ease;
	}

	.search-results--open {
		pointer-events: auto;
		visibility: visible;
		opacity: 1;
	}

	.search-results--mobile {
		position: static;
		width: 100%;
		margin-top: 0.75rem;
	}

	.search-result {
		display: block;
		padding: 0.5625rem 0.6875rem;
		border-radius: 8px;
		font-size: 0.8125rem;
		color: #ececec;
		transition:
			color 200ms ease,
			background-color 200ms ease;
	}

	.search-result:hover,
	.search-result:focus-visible {
		background: rgb(255 255 255 / 0.06);
		color: var(--green);
		outline: none;
	}

	/* ===========================
	   LINHA VERDE
	=========================== */

	.bottom-line {
		box-sizing: border-box;
		width: 100%;
		max-width: 80rem;
		margin-inline: auto;
		padding-inline: 1rem;
		height: 1px;
		background: linear-gradient(90deg, #2da866, #38b06f, #2da866);
		background-clip: content-box;
		opacity: 0.85;
	}

	@media (min-width: 640px) {
		.bottom-line {
			padding-inline: 1.5rem;
		}
	}

	@media (min-width: 1024px) {
		.bottom-line {
			padding-inline: 2rem;
		}
	}

	/* ===========================
	   MOBILE / UTILITÁRIOS
	=========================== */

	.utility-btn {
		display: flex;
		width: 2.5rem;
		height: 2.5rem;
		align-items: center;
		justify-content: center;
		border: none;
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
	}

	.utility-btn:hover {
		color: var(--green);
	}

	.utility-btn svg {
		width: 1.25rem;
		height: 1.25rem;
	}

	.is-hidden {
		display: none !important;
	}

	.header-drawer {
		display: none;
		background: #090909;
		border-top: 1px solid var(--border);
	}

	.header-drawer:not([hidden]) {
		display: block;
	}

	.header-drawer__inner {
		padding: 20px;
	}

	.search-box--mobile {
		max-width: none;
	}

	.menu--mobile {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0;
		margin-left: 0;
		padding: 0;
		border: none;
		background: transparent;
	}

	.menu--mobile a {
		display: block;
		padding: 14px 0;
		border-bottom: 1px solid var(--border);
	}

	.menu--mobile a::after {
		display: none;
	}

	/* ===========================
	   DESKTOP — Logo | Menu | Busca
	   Compacto + dizeres editoriais em faixa fina (tolerância mínima de altura)
	=========================== */

	@media (min-width: 1101px) {
		.top-bar {
			display: flex;
			align-items: center;
			gap: 16px;
			padding: 6px 40px 0;
		}

		.top-copy {
			flex-direction: row;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0.5rem 1rem;
		}

		.top-left {
			font-size: 0.62rem;
			letter-spacing: 1.6px;
			line-height: 1.2;
		}

		.site-slogan {
			font-size: 0.72rem;
			line-height: 1.25;
			opacity: 0.75;
		}

		.top-line {
			display: block;
			height: 1px;
		}

		.top-utility {
			display: none !important;
		}

		.header-drawer {
			display: none !important;
		}

		.header-main {
			padding-top: 10px;
			padding-bottom: 10px;
			padding-inline: 40px;
			gap: 28px;
		}

		.logo-area {
			max-width: 200px;
		}

		.logo {
			max-width: 200px;
		}

		.menu {
			gap: 2rem;
		}

		.search-area {
			translate: none;
		}

		.search-box {
			max-width: 260px;
			padding: 10px 16px;
			border-radius: 999px;
			gap: 10px;
		}

		.search-box input {
			font-size: 0.85rem;
		}
	}

	/* ===========================
	   TABLET — Logo / Menu / Busca empilhados
	=========================== */

	@media (max-width: 1100px) and (min-width: 769px) {
		.header-main {
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: 20px;
		}

		.logo-area {
			align-items: stretch;
